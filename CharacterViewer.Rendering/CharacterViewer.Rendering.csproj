<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ReactiveUI.WPF 23.x ships its WPF asset only for net*-windows10.0.19041 (a plain
         net8.0-windows = windows7.0 silently falls back to the .NET Framework build). Pin the
         platform version so the real Windows asset resolves. A net10 host consumes this net8 lib fine. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CharacterViewer.Rendering</RootNamespace>
    <AssemblyName>CharacterViewer.Rendering</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Library version. Keep in sync with CharacterViewerRendering.Version
         in CharacterViewerRendering.cs — hosts compare against that constant
         for staleness checks. Bump together: Major = breaking, Minor =
         additive, Patch = bugfix. This is also the published NuGet version. -->
    <Version>2.8.0</Version>
    <AssemblyVersion>2.8.0.0</AssemblyVersion>
    <FileVersion>2.8.0.0</FileVersion>
  </PropertyGroup>

  <!-- NuGet packaging metadata. Produced with `dotnet pack -c Release`; not packed
       on every build. PackageId is SynthEBD-prefixed because nuget.org is a global
       namespace. Authors is a free-text handle (no legal name required). -->
  <PropertyGroup>
    <PackageId>SynthEBD.CharacterViewer.Rendering</PackageId>
    <Authors>Synthesis Collective</Authors>
    <Company>Synthesis Collective</Company>
    <Product>CharacterViewer.Rendering</Product>
    <Description>Offscreen OpenGL 3D renderer for Skyrim NPC head/body previews (mugshots). Host-agnostic: no Mutagen or game-specific dependency — consumers implement a few small abstraction interfaces. Used by SynthEBD and NPC Plugin Chooser 2.</Description>
    <PackageTags>skyrim;mutagen;opengl;renderer;mugshot;npc;synthebd</PackageTags>
    <PackageProjectUrl>https://github.com/Synthesis-Collective/SynthEBD</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Synthesis-Collective/SynthEBD</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Copyright>Copyright (C) Synthesis Collective</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 5.0.0 -> 5.1.2 to stay coherent with SynthEBD (Mutagen.Bethesda.WPF 0.54.0 floor). -->
    <PackageReference Include="Extended.Wpf.Toolkit" Version="5.1.2" />
    <PackageReference Include="OpenTK.GLWpfControl" Version="4.3.3" />
    <PackageReference Include="niflysharp" Version="1.3.0" />
    <PackageReference Include="Pfim" Version="0.11.4" />
    <!-- ImageSharp encodes the offscreen renderer's RGBA8 framebuffer to PNG.
         Same version NPC Plugin Chooser 2 already references. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <!-- Bumped 19.5.41 -> 23.2.28 to share one ReactiveUI major with SynthEBD/NPC2 (this is a
         shared assembly; it can't straddle a ReactiveUI major-version gap). Keep ReactiveUI.Fody
         at 19.5.41 — that [Reactive]-weaver combo is what Noggog.WPF/the hosts use. -->
    <PackageReference Include="ReactiveUI.WPF" Version="23.2.28" />
    <PackageReference Include="ReactiveUI.Fody" Version="19.5.41" />
    <PackageReference Include="PropertyChanged.Fody" Version="4.1.0" />
  </ItemGroup>

  <!-- Shaders ship two ways: embedded into the assembly (so NuGet-package
       consumers — for whom copied content does NOT flow through a PackageReference
       — and single-file deployments still have them) AND copied next to the
       assembly (so local / ProjectReference builds can hot-edit a shader in the
       bin folder and re-run without a rebuild). ModuleResourceLocator.ReadShaderSource
       prefers the on-disk copy and falls back to the embedded one. -->
  <ItemGroup>
    <EmbeddedResource Include="Shaders\*.vert">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
    <EmbeddedResource Include="Shaders\*.frag">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
