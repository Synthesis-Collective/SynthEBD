<UserControl x:Class="CharacterViewer.Rendering.Views.UC_CharacterViewerRenderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cvr="clr-namespace:CharacterViewer.Rendering"
             xmlns:cvrv="clr-namespace:CharacterViewer.Rendering.Views"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"
             d:DesignHeight="80" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=cvr:VM_CharacterViewer}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Implicit dark-theme style for every xctk:DoubleUpDown in this UC.
             The toolkit's default template inherits the system-light Windows
             theme - white interior, dark glyph - which renders as invisible
             text against the panel's #FF2A2A2A / #FF222222 backdrop. Setting
             Background + Foreground + BorderBrush + CaretBrush at the spinner
             root propagates through the embedded TextBox so the typed value
             stays readable. The matching SsaoBlur / VignetteIntensity etc.
             pickers inherit the same look without per-control styling. -->
        <Style TargetType="{x:Type xctk:DoubleUpDown}">
            <Setter Property="Background" Value="#FF1F1F1F"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="CaretBrush" Value="#FFE0E0E0"/>
        </Style>
    </UserControl.Resources>

    <!--
        Render-pipeline controls panel - bind DataContext to a VM_CharacterViewer
        instance and the panel will surface the toggles + tunables that affect
        what the renderer paints (independent of camera framing / portrait
        layout). Two-way bindings push edits straight into VM_CharacterViewer
        properties; the existing WhenAnyValue subscriptions in the VM forward
        the new values to GlRenderer on the next frame, so changes apply
        immediately without a manual reload.

        Hosts that persist these values (e.g. NPC Plugin Chooser 2's settings
        JSON) subscribe to property changes on VM_CharacterViewer and write
        through to their own settings model.
    -->
    <StackPanel Orientation="Vertical">

        <!-- Row 1: portrait-quality toggles + missing-texture wireframe -->
        <Border Background="#FF2A2A2A" Padding="6 3">
            <WrapPanel Orientation="Horizontal">
                <CheckBox Content="Tone-mapping" FontSize="11" Foreground="#FFAAAAAA"
                          VerticalAlignment="Center"
                          IsChecked="{Binding EnableToneMapping}"
                          ToolTip="ACES filmic tone-mapper, sRGB framebuffer, mild saturation boost. Compresses HDR highlights, lifts shadows into perceptual space, adds the warmth / contrast that makes the output read as a portrait rather than a flat render. Off: legacy linear-to-display output."/>

                <CheckBox Content="Shadows" FontSize="11" Foreground="#FFAAAAAA"
                          Margin="10,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding EnableShadows}"
                          ToolTip="Renders a shadow-map pass from the key directional light's POV and samples it with PCF in the main fragment shader, so the brow ridge casts a shadow on the eye sockets, the nose casts on the cheek, and hair casts on the forehead."/>

                <CheckBox Content="SSAO" FontSize="11" Foreground="#FFAAAAAA"
                          Margin="10,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding EnableAmbientOcclusion}"
                          ToolTip="Screen-space ambient occlusion: soft shadowing in concave crevices (eye sockets, nostrils, lip line, ear creases) by sampling depth in a hemisphere around each fragment. Fills in the micro-detail darkening that real photography has and a flat render lacks."/>

                <CheckBox Content="Eye catch-light" FontSize="11" Foreground="#FFAAAAAA"
                          Margin="10,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding EnableEyeCatchlight}"
                          ToolTip="Adds a tight, bright specular spot from the key light to eye shapes - the small reflection that makes eyes look alive in real portraits. Layered on top of the eye's regular Blinn-Phong specular."/>

                <TextBlock Text="SSS:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="15,0,4,0"
                           ToolTip="Subsurface scattering strength multiplier."/>
                <xctk:DoubleUpDown Width="60" Minimum="0" Maximum="5" Increment="0.1"
                                   Value="{Binding SubsurfaceStrength}" VerticalAlignment="Center"
                                   Foreground="White"
                                   FormatString="0.00"
                                   ToolTip="Subsurface scattering strength multiplier. 0 disables SSS; 1.0 is honest SSS at the source NIF rolloff values; 1.5-2.0 boosts toward the more pronounced warm-flesh look in professional portrait reference."/>

                <TextBlock Text="Skin Sat:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="15,0,4,0"
                           ToolTip="Skin-only saturation multiplier."/>
                <xctk:DoubleUpDown Width="60" Minimum="0" Maximum="3" Increment="0.05"
                                   Value="{Binding SkinSaturationBoost}" VerticalAlignment="Center"
                                   Foreground="White"
                                   FormatString="0.00"
                                   ToolTip="Skin-only saturation multiplier applied post-tint, pre-lighting. 1.0 = no-op (default). >1 boosts chroma along the original hue, restoring race-distinguishing skin character (Orc green, Redguard brown, Imperial warmth) that the downstream pipeline tends to compress toward neutral. Gated on shader type 4/5 so hair/eyes/brows pass through unchanged."/>

                <TextBlock Text="Vignette R:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="15,0,4,0"
                           ToolTip="Vignette inner radius (NDC units, ~0..1.4). Pixels within this distance of screen center are unaffected; falloff smoothsteps from this radius out to the corner. Only takes effect when tone-mapping is on."/>
                <xctk:DoubleUpDown Width="60" Minimum="0" Maximum="1.4" Increment="0.05"
                                   Value="{Binding VignetteRadius}" VerticalAlignment="Center"
                                   Foreground="White"
                                   FormatString="0.00"
                                   ToolTip="Vignette inner radius (NDC units, ~0..1.4). Default 0.7."/>

                <TextBlock Text="I:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="6,0,4,0"
                           ToolTip="Vignette darkening strength. 0 = off, 1 = corners to black."/>
                <xctk:DoubleUpDown Width="60" Minimum="0" Maximum="1" Increment="0.05"
                                   Value="{Binding VignetteIntensity}" VerticalAlignment="Center"
                                   Foreground="White"
                                   FormatString="0.00"
                                   ToolTip="Vignette darkening strength. 0 = off, 1 = corners to black. Approximates the pre-2.5.15 hardcoded vignette at ~0.3."/>

                <TextBlock Text="Exposure:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="15,0,4,0"
                           ToolTip="Brightness of the tone-mapped image. 1.0 = neutral; higher = brighter, lower = darker. Only takes effect when tone-mapping is on."/>
                <xctk:DoubleUpDown Width="60" Minimum="0.25" Maximum="3" Increment="0.05"
                                   Value="{Binding Exposure}" VerticalAlignment="Center"
                                   Foreground="White"
                                   FormatString="0.00"
                                   ToolTip="Tone-map exposure multiplier. 1.0 = neutral (the default look); higher brightens toward the blown-out in-game look, lower darkens. Only takes effect when tone-mapping is on."/>

                <CheckBox Content="Hair relief" FontSize="11" Foreground="#FFAAAAAA"
                          Margin="15,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding TonemapHairRelief}"
                          ToolTip="Hair pixels skip the fresnel silhouette darkening (which lands on wispy strand edges) and use a gentler exposure pull-down into the ACES curve, so the brown hair midtone is not crushed by the skin-tuned finishing chain. Skin and everything else are untouched. Only takes effect when Tone-mapping is on."/>

                <CheckBox Content="Daylight" FontSize="11" Foreground="#FFAAAAAA"
                          Margin="15,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding DaylightBoost}"
                          ToolTip="Scale the directional lights by a noon-sun gain and warm them slightly (ambient untouched), lifting blonde hair toward its in-game daylight appearance without hand-tuning the Key light. Composes with whatever Light Layout / manual lights are active."/>
                <xctk:DoubleUpDown Width="55" Minimum="1.0" Maximum="3" Increment="0.1"
                                   Value="{Binding DaylightBoostIntensity}" VerticalAlignment="Center"
                                   Margin="4,0,0,0" Foreground="White"
                                   FormatString="0.00"
                                   ToolTip="Directional-light gain when Daylight is on. 1.0 = warmth only (no brightening); higher brightens. Default 1.5."/>

                <CheckBox Content="Bloom" FontSize="11" Foreground="#FFAAAAAA"
                          Margin="15,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding EnableBloom}"
                          ToolTip="Bright-pass + blur glow so hair highlights bleed into the soft halo the engine produces, reproducing the perceptual 'blonde'. Affects the whole frame. Only takes effect when Tone-mapping is on."/>
                <xctk:DoubleUpDown Width="55" Minimum="0" Maximum="2" Increment="0.05"
                                   Value="{Binding BloomIntensity}" VerticalAlignment="Center"
                                   Margin="4,0,0,0" Foreground="White"
                                   FormatString="0.00"
                                   ToolTip="Bloom composite strength. 0 = no visible glow; higher = stronger. Default 0.7. Only takes effect when Bloom + Tone-mapping are on."/>

                <CheckBox Content="Wireframe missing-tex" FontSize="11" Foreground="#FFAAAAAA"
                          Margin="15,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding RenderMissingTextureAsWireframe}"
                          ToolTip="When on (default), an alpha-tested or alpha-blended shape whose diffuse texture failed to load is drawn as a green wireframe placeholder so the missing-texture state is visible. Off: those shapes are silently culled. Toggling fires ReloadRequested - hosts re-load the current NPC because the decision is made at mesh-upload time."/>

                <!-- Reveal toggle for the Skin Tint / Face Tint debug rows below.
                     ElementName-bound from those rows' Visibility, so state is
                     ephemeral (resets per panel instance) and doesn't need a
                     VM property - the underlying tint operators / modes are
                     already persisted independently. -->
                <CheckBox x:Name="ShaderTroubleshootingCheck"
                          Content="Shader Troubleshooting" FontSize="11" Foreground="#FFAAAAAA"
                          Margin="15,0,0,0" VerticalAlignment="Center"
                          IsChecked="False"
                          ToolTip="Reveal the Skin Tint and Face Tint debug rows below. These operators / modes are intended for diagnosing shader pipeline differences against the engine, not routine adjustment - hidden by default to reclaim vertical space."/>
            </WrapPanel>
        </Border>

        <!-- Row 2: SSAO tunables - visible only when SSAO is on -->
        <Border Background="#FF222222" Padding="6 3"
                BorderBrush="#FF1A1A1A" BorderThickness="0,1,0,0"
                Visibility="{Binding EnableAmbientOcclusion, Converter={StaticResource BoolToVis}}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="SSAO" Foreground="#FFAAAAAA" FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <TextBlock Text="Radius:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <xctk:DoubleUpDown Width="60" Minimum="0.1" Maximum="20" Increment="0.5"
                                   Value="{Binding SsaoRadius}" VerticalAlignment="Center"
                                   Foreground="White"
                                   FormatString="0.00"
                                   ToolTip="Sample radius in world units. Larger = softer / broader AO; smaller = tight crevice-only AO. Skyrim NPC heads are ~22 units tall, so values 2-8 work well. Default 4."/>

                <TextBlock Text="Bias:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,4,0"/>
                <xctk:DoubleUpDown Width="60" Minimum="0" Maximum="1" Increment="0.01"
                                   Value="{Binding SsaoBias}" VerticalAlignment="Center"
                                   Foreground="White"
                                   FormatString="0.000"
                                   ToolTip="Minimum depth difference (world units) before a sample counts as occluded. Higher reduces self-shadowing on flat surfaces; too high erases real AO. Default 0.05."/>

                <TextBlock Text="Intensity:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,4,0"/>
                <xctk:DoubleUpDown Width="60" Minimum="0" Maximum="10" Increment="0.1"
                                   Value="{Binding SsaoIntensity}" VerticalAlignment="Center"
                                   Foreground="White"
                                   FormatString="0.00"
                                   ToolTip="Power-curve exponent. Higher = harder darkening in deep crevices, more subtle elsewhere; lower = uniformly darker AO. Default 1.5."/>

                <TextBlock Text="Thickness:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,4,0"/>
                <xctk:DoubleUpDown Width="60" Minimum="0.05" Maximum="10" Increment="0.1"
                                   Value="{Binding SsaoThickness}" VerticalAlignment="Center"
                                   Foreground="White"
                                   FormatString="0.00"
                                   ToolTip="Assumed occluder thickness in view-space units. An occluder only darkens a fragment when its depth is within roughly this distance; geometry farther behind (e.g. a collar behind beard strands) counts as a separate surface seen through a gap, not a crevice wall. Lower = less background bleed onto thin hair; higher = broader contact AO. Default 1.5."/>

                <TextBlock Text="Hair Gap:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,4,0"/>
                <xctk:DoubleUpDown Width="60" Minimum="0.05" Maximum="10" Increment="0.1"
                                   Value="{Binding SsaoHairGap}" VerticalAlignment="Center"
                                   Foreground="White"
                                   FormatString="0.00"
                                   ToolTip="Max distance (view units) between hair and the surface behind it for that surface's AO to shade the hair. Hair is absent from the AO depth buffer, so its AO always comes from what is behind it: within this gap (scalp under a hairline, chin under a beard) that is a fair stand-in; beyond it (a collar behind the beard) it is background structure that would ghost through, so it fades out. Default 0.8."/>
            </WrapPanel>
        </Border>

        <!-- Row: skin-shading correctness toggles (game-faithful specular +
             soft-lighting). Gated on the Row 1 "Shader Troubleshooting" toggle;
             both default ON, so the corrected look ships by default and these
             are exposed only for A/B comparison against the legacy behavior. -->
        <Border Background="#FF222222" Padding="6 3"
                BorderBrush="#FF1A1A1A" BorderThickness="0,1,0,0"
                Visibility="{Binding IsChecked, ElementName=ShaderTroubleshootingCheck, Converter={StaticResource BoolToVis}}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Skin Shading" Foreground="#FFAAAAAA" FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <CheckBox Content="Achromatic spec" FontSize="11" Foreground="#FFAAAAAA"
                          VerticalAlignment="Center"
                          IsChecked="{Binding SpecularAchromatic}"
                          ToolTip="Game-faithful dielectric specular: adds the skin highlight on top of the lit albedo instead of multiplying it through the skin color, so the sheen reads as a bright near-white reflection (matches NifSkope sk_default.frag and Community Shaders). Off: legacy albedo-tinted (dimmer, skin-colored) highlight."/>

                <CheckBox Content="Faithful SSS" FontSize="11" Foreground="#FFAAAAAA"
                          Margin="15,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding SkinFaithfulSoftLight}"
                          ToolTip="Game-faithful skin soft-lighting: the NifSkope / Community Shaders wrap term at honest material strength (sqrt of the NIF subsurface rolloff), so the warm terminator band is visible. Off: legacy terminator-delta + transmission term. Scaled by the SSS strength field above. Note: a black/placeholder _sk subsurface map (some mods ship these) yields no SSS in either mode."/>
            </WrapPanel>
        </Border>

        <!-- Row: hair-shading correctness (gamma-space albedo compensation for
             neutral-white-tint hair). Gated on the Row 1 "Shader Troubleshooting"
             toggle; defaults to full (1.0) so the corrected look ships by default. -->
        <Border Background="#FF222222" Padding="6 3"
                BorderBrush="#FF1A1A1A" BorderThickness="0,1,0,0"
                Visibility="{Binding IsChecked, ElementName=ShaderTroubleshootingCheck, Converter={StaticResource BoolToVis}}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Hair Shading" Foreground="#FFAAAAAA" FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <TextBlock Text="sRGB comp:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,4,0"
                           ToolTip="Neutral-white-tint hair albedo compensation."/>
                <xctk:DoubleUpDown Width="60" Minimum="0" Maximum="1" Increment="0.05"
                                   Value="{Binding HairAlbedoCompensate}" VerticalAlignment="Center"
                                   Foreground="White"
                                   FormatString="0.00"
                                   ToolTip="Fixes hair whose baked tint is a neutral WHITE (e.g. the FoxGlove red wig) reading pink/coral. This renderer lights on raw sRGB texels, so a white-tinted (un-attenuated) albedo sits ~3x too bright and clips; this applies the sRGB-to-linear the pipeline skips, pulling it to a deep, un-clipped red. 0 = off (coral), 1 = full (NifSkope-depth). Keyed on tint neutrality, so dark-tint replacers and warm-blonde hair are exempt. Works with or without Tone-mapping."/>
            </WrapPanel>
        </Border>

        <!-- Row: hair-shadow "brow ridge" mitigations (Strategies A/B/C).
             Bangs cast a hard shadow onto the forehead; the slope-scaled
             shadow bias warps its edge across the curved brow into an
             embossed ridge. Three independent, combinable approaches, all
             default OFF (current behavior) - flip them to A/B compare and
             pick a winner. Only visible effect when the Row 1 "Shadows"
             toggle is on. Gated on the "Shader Troubleshooting" toggle. -->
        <Border Background="#FF222222" Padding="6 3"
                BorderBrush="#FF1A1A1A" BorderThickness="0,1,0,0"
                Visibility="{Binding IsChecked, ElementName=ShaderTroubleshootingCheck, Converter={StaticResource BoolToVis}}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Hair Shadows" Foreground="#FFAAAAAA" FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           ToolTip="Mitigations for the 'brow ridge' shadow bangs cast on the forehead. Requires the Shadows toggle to be on to see any effect. A/B/C are independent and can be combined."/>

                <CheckBox Content="A: Hair doesn't cast" FontSize="11" Foreground="#FFAAAAAA"
                          VerticalAlignment="Center"
                          IsChecked="{Binding ExcludeHairShadowCaster}"
                          ToolTip="Strategy A: exclude hair from the shadow-map caster pass (like eyes already are), so bangs cast no shadow on the face at all. Hair/face contact darkening then comes from SSAO instead. Cleanest fix; the only loss is hair casting onto the neck/shoulders (barely visible in portrait framing)."/>

                <CheckBox Content="B: Soften edges" FontSize="11" Foreground="#FFAAAAAA"
                          Margin="15,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding SoftenShadowEdges}"
                          ToolTip="Strategy B: keep hair casting, but drop the slope-scaled bias (whose NdotL swing warps the shadow edge into a ridge) for a small constant bias and a wider PCF kernel, so the strand-cutout shadow blurs into a soft, ridge-free contact shadow. Softness set by the PCF slider."/>
                <TextBlock Text="PCF:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="6,0,4,0"/>
                <xctk:DoubleUpDown Width="55" Minimum="0.5" Maximum="6" Increment="0.25"
                                   Value="{Binding ShadowPcfRadius}" VerticalAlignment="Center"
                                   Foreground="White"
                                   FormatString="0.00"
                                   ToolTip="Strategy B kernel step in shadow-map texels (5x5 taps). Higher = softer / broader shadow. Default 1.5. Only used when 'Soften edges' is on."/>

                <CheckBox Content="C: Tight frustum" FontSize="11" Foreground="#FFAAAAAA"
                          Margin="15,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding TightShadowFrustum}"
                          ToolTip="Strategy C: keep hair casting, but shrink the light's orthographic frustum from radius 300 to the value at right, so the same NDC bias resolves to far fewer world units and the shadow hugs the caster tightly (less warp). Too small clips tall geometry out of the shadow map - back off if shadows vanish."/>
                <TextBlock Text="Radius:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="6,0,4,0"/>
                <xctk:DoubleUpDown Width="60" Minimum="30" Maximum="300" Increment="10"
                                   Value="{Binding ShadowFrustumRadius}" VerticalAlignment="Center"
                                   Foreground="White"
                                   FormatString="0"
                                   ToolTip="Strategy C light-frustum scene radius in world units. Lower = tighter depth range = less bias warp, but higher risk of clipping shoulders/hair out of the shadow map. Default 100 (vs the legacy 300). Only used when 'Tight frustum' is on."/>
            </WrapPanel>
        </Border>

        <!-- Row 3: skin-tint debug (operator selector / Apply-To-Face / vertex-color override).
             Gated on the Row 1 "Shader Troubleshooting" toggle - this row is debug-only. -->
        <Border Background="#FF222222" Padding="6 3"
                BorderBrush="#FF1A1A1A" BorderThickness="0,1,0,0"
                Visibility="{Binding IsChecked, ElementName=ShaderTroubleshootingCheck, Converter={StaticResource BoolToVis}}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Skin Tint" Foreground="#FFAAAAAA" FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <CheckBox Content="Apply to face" FontSize="11" Foreground="#FFAAAAAA"
                          VerticalAlignment="Center"
                          IsChecked="{Binding SkinTintApplyToFace}"
                          ToolTip="Debug: also apply the QNAM tint to ShaderType==4 face shapes (production: only ShaderType==5 body shapes get it). Useful for testing the 'engine applies QNAM to both face and body' hypothesis."/>

                <TextBlock Text="Operator:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="15,0,4,0"/>
                <ComboBox Width="200" VerticalAlignment="Center"
                          SelectedIndex="{Binding SkinTintOperator}"
                          ToolTip="How tint_color combines with the slot-0 diffuse. Multiply is the production default. Option 6 (Pegtop) is the engine-faithful operator per Community Shaders source — gentler than multiply or overlay; symmetric around t=0.5 (identity).">
                    <ComboBoxItem Content="0 - Multiply"/>
                    <ComboBoxItem Content="1 - Overlay"/>
                    <ComboBoxItem Content="2 - Linear-space multiply"/>
                    <ComboBoxItem Content="3 - Gamma-aware (pow 1/tint)"/>
                    <ComboBoxItem Content="4 - Lerp(strength)"/>
                    <ComboBoxItem Content="5 - Lerp(skinTintAlpha)"/>
                    <ComboBoxItem Content="6 - Pegtop (engine)"/>
                </ComboBox>

                <TextBlock Text="Lerp:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,4,0"/>
                <xctk:DoubleUpDown Width="60" Minimum="0" Maximum="1" Increment="0.05"
                                   Value="{Binding SkinTintLerpStrength}" VerticalAlignment="Center"
                                   Foreground="White"
                                   FormatString="0.00"
                                   ToolTip="Strength used by operator 4 (lerp). 0 = no tint; 1 = full multiply."/>

                <TextBlock Text="Vertex colors:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="15,0,4,0"/>
                <ComboBox Width="100" VerticalAlignment="Center"
                          SelectedIndex="{Binding VertexColorMultiplyMode}"
                          ToolTip="Per-shape vertex-color multiply override. Auto = use the per-shape HasVertexColors flag (production); Force on = apply to every shape (visually inert when no VC data — sanity-checks the (1,1,1,1) fallback); Force off = skip the multiply for every shape.">
                    <ComboBoxItem Content="Auto"/>
                    <ComboBoxItem Content="Force on"/>
                    <ComboBoxItem Content="Force off"/>
                </ComboBox>
            </WrapPanel>
        </Border>

        <!-- Row 1c: FaceTint mode selector + multiply-on-empty-slot-3.
             Gated on the Row 1 "Shader Troubleshooting" toggle - this row is debug-only. -->
        <Border Background="#FF222222" Padding="6 3"
                BorderBrush="#FF1A1A1A" BorderThickness="0,1,0,0"
                Visibility="{Binding IsChecked, ElementName=ShaderTroubleshootingCheck, Converter={StaticResource BoolToVis}}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Face Tint" Foreground="#FFAAAAAA" FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <TextBlock Text="Mode:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,4,0"
                           ToolTip="FaceTint blend operator. Auto matches NifSkope's sk_msn / sk_default split (MSN gets overlay, non-MSN gets multiply). Option 4 (Pegtop) is the engine-faithful operator per Community Shaders' GetFacegenBaseColor source."/>
                <ComboBox Width="180" VerticalAlignment="Center"
                          SelectedIndex="{Binding FaceTintMode}">
                    <ComboBoxItem Content="Auto (MSN=overlay)"/>
                    <ComboBoxItem Content="Always overlay"/>
                    <ComboBoxItem Content="Always multiply"/>
                    <ComboBoxItem Content="Always skip"/>
                    <ComboBoxItem Content="Pegtop (engine)"/>
                </ComboBox>

                <CheckBox Content="Engine-style detail" FontSize="11" Foreground="#FFAAAAAA"
                          Margin="10,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding UseEngineStyleDetailMap}"
                          ToolTip="Apply the slot-3 detail map the way the Skyrim engine does (per Community Shaders' GetFacegenBaseColor). The detail map becomes a multiplicative scaling map applied AFTER the FaceTint blend, with transform 3.984375 * ((1/255, 0, 1/255) + sampled). Pair with FaceTint=Pegtop and SkinTint=Pegtop for engine-faithful face/body composition."/>

                <CheckBox Content="Multiply on empty slot-3" FontSize="11" Foreground="#FFAAAAAA"
                          Margin="20,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding FaceTintMultiplyOnEmptyDetail}"
                          ToolTip="Experimental: face shapes (ShaderType 4) whose NIF has the SLSF1_Facegen_Detail_Map flag set but slot 3 of the texture set is empty are forced to multiply, ignoring Mode. Resolves the seam on modder faces that omit slot 3 (Brynjolf, Aia Arria, Angeline Morrard) without affecting NPCs whose slot 3 is populated."/>

                <CheckBox Content="BlankDetailmap fallback" FontSize="11" Foreground="#FFAAAAAA"
                          Margin="20,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding UseBlankDetailFallback}"
                          ToolTip="Experimental: face shapes (ShaderType 4) whose NIF has the SLSF1_Facegen_Detail_Map flag set but slot 3 is empty get textures\actors\character\male\BlankDetailmap.dds substituted at load time, exercising the detail-map blend with Bethesda's standard CK fallback (mid-gray). Tests whether the engine substitutes a similar default at runtime. Toggling triggers a scene reload."/>
            </WrapPanel>
        </Border>
    </StackPanel>
</UserControl>
