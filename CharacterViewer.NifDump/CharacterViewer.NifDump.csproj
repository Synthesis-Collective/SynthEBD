<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- Plain TFM: the core SkyRender library (net8.0) needs no WPF. -->
        <TargetFramework>net10.0</TargetFramework>
        <!-- Same rationale as SynthEBD.CLI: relax CET so the tool can run under MO2's USVFS. -->
        <CETCompat>false</CETCompat>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="SkyRender" Version="3.0.1" />
    </ItemGroup>

</Project>
