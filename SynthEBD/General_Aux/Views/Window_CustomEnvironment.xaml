<Window x:Class="SynthEBD.Window_CustomEnvironment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Skyrim="clr-namespace:Mutagen.Bethesda.Skyrim;assembly=Mutagen.Bethesda.Skyrim"
        xmlns:local="clr-namespace:SynthEBD"
        d:DataContext="{d:DesignInstance Type=local:VM_CustomEnvironment}"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="Custom Game Installation" Height="250" Width="800"
        Style="{DynamicResource ThemedWindowStyle}">

    <i:Interaction.Behaviors>
        <local:TitleBarThemingBehavior/>
    </i:Interaction.Behaviors>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Text="{Binding InstructionMessage}"/>
        <TextBlock Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3">Please select your game type and game.exe folder below</TextBlock>

        <TextBlock Grid.Column="0" Grid.Row="2" ToolTip="Which Skyrim release is being patched" VerticalAlignment="Center">Skyrim Release</TextBlock>
        <ComboBox Grid.Column="2" Grid.Row="2" Width="auto" HorizontalAlignment="Left" SelectedValue="{Binding SkyrimRelease}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type Skyrim:SkyrimRelease}}}" IsSynchronizedWithCurrentItem="True"/>

        <TextBlock Grid.Column="0" Grid.Row="3" ToolTip="Find your game executable if not in the default location (Steam Library)">Custom Game Path</TextBlock>
        <StackPanel Grid.Column="2" Grid.Row="3" Orientation="Horizontal">
            <Button VerticalAlignment="Center" Command="{Binding SelectCustomGameFolder}"  Foreground="{DynamicResource ActionGoodForeground}">Search</Button>
            <TextBlock Text="{Binding CustomGamePath}" Margin="5 0 5 0" Background="{DynamicResource TextBoxBackground}" VerticalAlignment="Center"/>
            <Button VerticalAlignment="Center" Command="{Binding ClearCustomGameFolder}"  Foreground="{DynamicResource ActionDangerForeground}">Clear</Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Grid.Row="4" Orientation="Horizontal">
            <TextBlock Text="{Binding StatusStr}" Foreground="{Binding StatusFontColor}" Margin="5 0 5 0"/>
            <Button VerticalAlignment="Center" Command="{Binding DisplayCurrentEnvironmentError}"  Foreground="{DynamicResource ActionAccentForeground}" Visibility="{Binding ShowErrorExplanationButton, Converter={StaticResource BoolToVis}}">Why?</Button>
        </StackPanel>

        <StackPanel Grid.Column="0" Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button VerticalAlignment="Center" Command="{Binding OK}" Foreground="{DynamicResource ActionGoodForeground}">OK</Button>
            <Button VerticalAlignment="Center" Command="{Binding Exit}"  Foreground="{DynamicResource ActionDangerForeground}" Margin="10 0 0 0">Exit</Button>
        </StackPanel>

        <!-- Load order display-->
        <TextBlock Grid.Column="4" Grid.Row="1" ToolTip="The load order that SynthEBD is seeing" Visibility="{Binding IsValidated, Converter={StaticResource BoolToVis}}">Load Order</TextBlock>
        <Border Grid.Column="4" Grid.Row="2" Grid.RowSpan="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Visibility="{Binding IsValidated, Converter={StaticResource BoolToVis}}">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding LoadOrderMods}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding .}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
