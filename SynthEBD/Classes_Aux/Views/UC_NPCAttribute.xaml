<UserControl x:Class="SynthEBD.UC_NPCAttribute"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SynthEBD"
             d:DataContext="{d:DesignInstance Type=local:VM_NPCAttribute}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertableBooleanToVisibilityConverter x:Key="InvBoolToVis" />
    </UserControl.Resources>

    <!-- One "card" = one AND-combined condition. Sibling cards in the host collection OR together;
         the separator above every non-first card and the add-button under the last card make that
         structure legible without host-view changes. -->
    <StackPanel>
        <Grid Margin="0 2 0 4" Visibility="{Binding IsFirstInParent, Converter={StaticResource InvBoolToVis}, ConverterParameter=Inverted}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Separator Grid.Column="0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Margin="8 0" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                       local:DocTooltip.Key="Attributes.OrSeparator">OR</TextBlock>
            <Separator Grid.Column="2" VerticalAlignment="Center"/>
        </Grid>

        <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Accent rail marking the card extent (the old design's purple border, demoted to a cue). -->
                <Rectangle Grid.Column="0" Width="3" Fill="{DynamicResource AccentBrush}" RadiusX="1" RadiusY="1"/>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: always-visible summary sentence + card-level actions. -->
                    <Grid Grid.Row="0" Margin="4 2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- x:Name is a contract with the ui-screenshot harness: its expand-expanders
                             option flips ToggleButtons named CardExpandToggle along with real Expanders. -->
                        <ToggleButton Grid.Column="0" x:Name="CardExpandToggle" IsChecked="{Binding IsExpanded}" Width="18" Height="18" Padding="0"
                                      Background="Transparent" BorderThickness="0"
                                      local:DocTooltip.Key="Attributes.ExpandCard">
                            <Path Data="M 0,0 L 5,4 L 0,8 Z" Fill="{DynamicResource PrimaryForeground}" Stretch="Uniform" Width="7" Height="9" RenderTransformOrigin="0.5,0.5">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="0"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </ToggleButton>

                        <TextBlock Grid.Column="1" Margin="4 0" VerticalAlignment="Center" Text="{Binding Summary}"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryForeground}"
                                   ToolTip="{Binding Summary}" local:DocTooltip.Key="Attributes.Summary"/>

                        <Button Grid.Column="2" Margin="4 0" Command="{Binding Validate}" Foreground="{DynamicResource ActionGoodForeground}"
                                local:DocTooltip.Key="Attributes.TestCondition">Test</Button>
                        <Button Grid.Column="3" Command="{Binding DeleteCommand}" Foreground="{DynamicResource ActionDangerForeground}"
                                Visibility="{Binding DisplayRemoveButton, Converter={StaticResource BoolToVis}}"
                                ToolTip="Remove this condition" local:DocTooltip.Key="Attributes.RemoveCondition">X</Button>
                    </Grid>

                    <!-- Body: the AND-combined condition rows, hidden when the card is collapsed. -->
                    <StackPanel Grid.Row="1" Margin="4 0 4 4" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding GroupedSubAttributes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:VM_NPCAttributeShell}">
                                    <local:UC_NPCAttributeShell/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button HorizontalAlignment="Left" Margin="0 4 0 0" Command="{Binding AddSubAttribute}"
                                Foreground="{DynamicResource ActionGoodForeground}" FontSize="11"
                                local:DocTooltip.Key="Attributes.AddAndCondition">+ AND condition</Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <StackPanel Visibility="{Binding DisplayORButton, Converter={StaticResource BoolToVis}}">
            <Button HorizontalAlignment="Left" Margin="0 4 0 0" Command="{Binding AddToParent}"
                    Foreground="{DynamicResource ActionGoodForeground}" FontSize="11"
                    Visibility="{Binding IsLastInParent, Converter={StaticResource BoolToVis}}"
                    local:DocTooltip.Key="Attributes.AddOrAlternative">+ OR alternative</Button>
        </StackPanel>
    </StackPanel>
</UserControl>
