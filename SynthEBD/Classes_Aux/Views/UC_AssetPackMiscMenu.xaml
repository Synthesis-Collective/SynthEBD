<UserControl x:Class="SynthEBD.UC_AssetPackMiscMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:plugins="clr-namespace:Mutagen.Bethesda.WPF.Plugins;assembly=Mutagen.Bethesda.WPF"
             xmlns:local="clr-namespace:SynthEBD"
             d:DataContext="{d:DesignInstance Type=local:VM_AssetPackMiscMenu}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" Grid.Column="0" Command="{Binding SetAllowedDescriptorMatchModes}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0 0 5 0" Foreground="{DynamicResource ActionAccentForeground}" local:DocTooltip.Key="AssetPack.SetAllAllowedDescriptorModes">Set All Allowed BodyShape Descriptors To</Button>
        <ComboBox Grid.Row="0" Grid.Column="1" Width="auto" HorizontalAlignment="Left" VerticalAlignment="Center" SelectedValue="{Binding AllowedDescriptorMatchMode}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type local:DescriptorMatchMode}}}" IsSynchronizedWithCurrentItem="True"/>

        <Button Grid.Row="1" Grid.Column="0" Command="{Binding SetDisallowedDescriptorMatchModes}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0 0 5 0" Foreground="{DynamicResource ActionAccentForeground}" local:DocTooltip.Key="AssetPack.SetAllDisallowedDescriptorModes">Set All Disallowed BodyShape Descriptors To</Button>
        <ComboBox Grid.Row="1" Grid.Column="1" Width="auto" HorizontalAlignment="Left" VerticalAlignment="Center" SelectedValue="{Binding DisallowedDescriptorMatchMode}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type local:DescriptorMatchMode}}}" IsSynchronizedWithCurrentItem="True"/>

        <Button Grid.Row="2" Grid.Column="0" Command="{Binding DeleteMissingDescriptors}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0 0 5 0" Foreground="{DynamicResource ActionAccentForeground}" local:DocTooltip.Key="AssetPack.DeleteMissingDescriptors">Delete Missing Body Shape Descriptors</Button>

        <Button Grid.Row="3" Grid.Column="0" Command="{Binding AddMixInToSpecificAssignments}" VerticalAlignment="Center" Margin="0 0 5 0" Foreground="{DynamicResource ActionAccentForeground}" Visibility="{Binding Path = ShowMixInCommands, Converter={StaticResource BoolToVis}}" local:DocTooltip.Key="AssetPack.AddMixInToSpecificAssignments">Add to all Specific NPC Assignment Forced MixIns</Button>
        <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1" Visibility="{Binding Path = ShowMixInCommands, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="As Declined" />
            <CheckBox Margin="5 0 5 0" IsChecked="{Binding AsDeclinedSNA}" local:DocTooltip.Key="AssetPack.MixInAsDeclined"/>
            <TextBlock Text="Override Existing"/>
            <CheckBox Margin="5 0 0 0" IsChecked="{Binding OverrideExistingSNA}" local:DocTooltip.Key="AssetPack.MixInOverrideExisting"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Get BSA Assets from" local:DocTooltip.Key="AssetPack.GetBsaAssetsFrom"/>
        <plugins:ModKeyMultiPicker Grid.Row="4" Grid.Column="1" ModKeys="{Binding AssociatedBsaModKeys}" SearchableMods="{Binding LoadOrder}" MaxHeight="300" />
    </Grid>
</UserControl>
