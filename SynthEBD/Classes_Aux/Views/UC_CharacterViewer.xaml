<UserControl x:Class="SynthEBD.UC_CharacterViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SynthEBD"
             xmlns:glWpf="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600"
             d:DataContext="{d:DesignInstance Type=local:VM_CharacterViewer}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:IntEqualsToVisibilityConverter x:Key="IntEqVis" />

        <!-- Values for the BB-pick Criterion combo: six single-axis picks + three UX-level
             'Mirror*' shortcuts that expand into paired rows on the editor side. -->
        <ObjectDataProvider x:Key="BoxCriterionValues"
                            MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:BoxCriterionSelection"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar row 1: Background + Presets -->
        <Border Grid.Row="0" Background="#FF2A2A2A" Padding="6 3">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Background:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="BgColorCombo" Width="110" FontSize="11" VerticalAlignment="Center"
                          SelectionChanged="BgColorCombo_SelectionChanged" SelectedIndex="0">
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FF696969" Margin="0,0,5,0"/>
                            <TextBlock Text="Dim Gray"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FF333333" Margin="0,0,5,0"/>
                            <TextBlock Text="Dark Gray"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FF000000" Margin="0,0,5,0"/>
                            <TextBlock Text="Black"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FFFFFFFF" Margin="0,0,5,0"/>
                            <TextBlock Text="White"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FF4A6A8A" Margin="0,0,5,0"/>
                            <TextBlock Text="Steel Blue"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FF2D5A27" Margin="0,0,5,0"/>
                            <TextBlock Text="Forest"/>
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>

                <Button Content="Reset View" FontSize="11" Margin="15,0,0,0"
                        Padding="8 2" VerticalAlignment="Center"
                        Click="ResetViewButton_Click"/>

                <Button Content="Controls" FontSize="11" Margin="10,0,0,0"
                        Padding="8 2" VerticalAlignment="Center"
                        Click="ControlsButton_Click"/>

                <TextBlock Text="Light Layout:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="20,0,5,0"/>
                <ComboBox Width="160" FontSize="11" VerticalAlignment="Center"
                          ItemsSource="{Binding LightingLayouts}"
                          SelectedItem="{Binding SelectedLightingLayout}"
                          DisplayMemberPath="Name"
                          ToolTip="Position + intensity of the ambient + key/fill/rim directional lights. 'Mugshot Natural' targets the Natural Lighting Mugshots look."/>
                <Button Content="Save…" FontSize="10" Margin="4,0,0,0" Padding="6 1"
                        VerticalAlignment="Center"
                        Command="{Binding SaveLayoutPresetCommand}"
                        ToolTip="Save the current ambient + key/fill/rim positions and intensities as a user layout preset."/>
                <Button Content="Delete" FontSize="10" Margin="2,0,0,0" Padding="6 1"
                        VerticalAlignment="Center"
                        Command="{Binding DeleteSelectedLayoutCommand}"
                        ToolTip="Delete the selected user layout preset. Built-in presets can't be deleted."/>

                <TextBlock Text="Color Scheme:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,5,0"/>
                <ComboBox Width="140" FontSize="11" VerticalAlignment="Center"
                          ItemsSource="{Binding LightingColorSchemes}"
                          SelectedItem="{Binding SelectedLightingColorScheme}"
                          DisplayMemberPath="Name"
                          ToolTip="Color temperature of the key/fill/rim lights. Combines independently with the selected layout."/>
                <Button Content="Save…" FontSize="10" Margin="4,0,0,0" Padding="6 1"
                        VerticalAlignment="Center"
                        Command="{Binding SaveColorSchemePresetCommand}"
                        ToolTip="Save the current Key/Fill/Rim hues as a user color scheme preset."/>
                <Button Content="Delete" FontSize="10" Margin="2,0,0,0" Padding="6 1"
                        VerticalAlignment="Center"
                        Command="{Binding DeleteSelectedColorSchemeCommand}"
                        ToolTip="Delete the selected user color scheme preset. Built-in presets can't be deleted."/>
            </WrapPanel>
        </Border>

        <!-- Toolbar row 2: Ambient + Show Lights toggle -->
        <Border Grid.Row="1" Background="#FF2A2A2A" Padding="6 2" BorderBrush="#FF1A1A1A" BorderThickness="0,1,0,0">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Ambient:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Slider Width="80" Minimum="0" Maximum="100"
                        Value="{Binding AmbientIntensity}" VerticalAlignment="Center"
                        SmallChange="1" LargeChange="10"/>
                <TextBlock Text="{Binding AmbientIntensity, StringFormat={}{0:F0}%}"
                           Foreground="#FF888888" FontSize="10" VerticalAlignment="Center" Width="30" Margin="2,0,0,0"/>

                <CheckBox Content="Key" FontSize="11" Foreground="#FFE6D94A"
                          Margin="15,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding KeyLightEnabled}"
                          ToolTip="Enable/disable the Key directional light."/>
                <CheckBox Content="Fill" FontSize="11" Foreground="#FF4ADCE6"
                          Margin="6,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding FillLightEnabled}"
                          ToolTip="Enable/disable the Fill directional light."/>
                <CheckBox Content="Rim" FontSize="11" Foreground="#FFE64AD9"
                          Margin="6,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding RimLightEnabled}"
                          ToolTip="Enable/disable the Rim directional light."/>

                <CheckBox Content="Show Lights" FontSize="11" Foreground="#FFAAAAAA"
                          Margin="15,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding ShowLightControls}"
                          ToolTip="Draws 3D arrow gizmos for each directional light. Click an arrow to open its per-light editor (azimuth, elevation, intensity, hue)."/>

                <CheckBox Content="Wireframe" FontSize="11" Foreground="#FF33E6D0"
                          Margin="10,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding ShowWireframe}"
                          Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"
                          ToolTip="Overlays the triangle edges of every loaded mesh. Used for key-vertex assignment in the BodySlide classifier workflow."/>

                <CheckBox Content="Pick Vertex" FontSize="11" Foreground="#FFFF6126"
                          Margin="10,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding IsKeyVertexPickMode}"
                          Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"
                          ToolTip="Left-click the model to drop a marker on the nearest triangle vertex. Intended for BodySlide classifier key-vertex assignment; camera orbit is disabled while this is on."/>

                <CheckBox Content="Pick Box" FontSize="11" Foreground="#FFFFCC40"
                          Margin="10,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding IsBoundingBoxPickMode}"
                          Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"
                          ToolTip="Left-drag a rectangle across the model to define a mesh-local bounding box. The classifier picks the vertex matching the selected Criterion inside that box at runtime, so the anatomical landmark tracks the mesh across presets."/>

                <TextBlock Text="Criterion:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,3,0"
                           Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"/>
                <ComboBox Width="92" FontSize="10" VerticalAlignment="Center"
                          ItemsSource="{Binding Source={StaticResource BoxCriterionValues}}"
                          SelectedItem="{Binding PendingBoxCriterion}"
                          Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"
                          ToolTip="Which vertex inside the painted box gets picked at runtime. Max/Min operate on the mesh-local axis (X=left-right, Y=up-down, Z=front-back). Mirror* expands to two paired rows with opposite-axis criteria — draw a box that covers both sides and pick e.g. MirrorX to get L/R shoulder at once."/>

                <Button Content="Select Mirror" FontSize="10" Margin="6,0,0,0"
                        Padding="6 1" VerticalAlignment="Center"
                        Click="SelectMirrorPicksButton_Click"
                        Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"
                        ToolTip="For each current pick marker, adds the vertex closest to its X-mirror on the same mesh. Use to fill in bilaterally symmetric counterparts after picking one side."/>

                <TextBlock Text="Axis:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,3,0"
                           Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"/>
                <ComboBox Width="42" FontSize="10" VerticalAlignment="Center"
                          SelectedIndex="{Binding ProjectAcrossAxisIndex}"
                          Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"
                          ToolTip="Axis used by 'Pair Across Axis': X = left-right, Y = up-down, Z = front-back.">
                    <ComboBoxItem Content="X"/>
                    <ComboBoxItem Content="Y"/>
                    <ComboBoxItem Content="Z"/>
                </ComboBox>

                <Button Content="Pair Across Axis" FontSize="10" Margin="4,0,0,0"
                        Padding="6 1" VerticalAlignment="Center"
                        Click="PairAcrossAxisButton_Click"
                        Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"
                        ToolTip="From the most recent pick, casts a ray through the body along the selected axis and adds a marker at the vertex nearest the opposite-surface exit. Use to pair midline anchors (e.g., NippleFront → UpperSpineBack) at a matching cross-axis coordinate."/>

                <Button Content="Clear Picks" FontSize="10" Margin="6,0,0,0"
                        Padding="6 1" VerticalAlignment="Center"
                        Click="ClearKeyVertexMarkersButton_Click"
                        Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"
                        ToolTip="Removes every picked-vertex marker from the viewport."/>

                <CheckBox Content="Verbose Log" FontSize="11" Foreground="#FFAAAAAA"
                          Margin="15,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding VerboseLog}"
                          ToolTip="Routes the viewer's informational diagnostics (GL init, NPC load, lighting, weight morphs, texture overrides, etc.) to the Status Log. Errors are always logged. Off by default so the classifier's own trace isn't buried in viewer chatter."/>

                <Button Content="Log Settings" FontSize="10" Margin="10,0,0,0"
                        Padding="6 1" VerticalAlignment="Center"
                        Click="LogLightingButton_Click"/>
            </WrapPanel>
        </Border>

        <!-- Toolbar row 3: Per-light editor (Key/Fill/Rim) — visible only when ShowLightControls=true and a light is selected -->
        <Border Grid.Row="2" Background="#FF222222" Padding="6 3"
                BorderBrush="#FF1A1A1A" BorderThickness="0,1,0,0"
                Visibility="{Binding ShowLightControls, Converter={StaticResource BoolToVis}}">
            <Grid>
                <!-- Hint shown when no light is selected -->
                <TextBlock Text="Click a light arrow in the viewport to edit its position, intensity, and hue."
                           Foreground="#FF888888" FontSize="11" FontStyle="Italic"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Visibility="{Binding SelectedLightIndex, Converter={StaticResource IntEqVis}, ConverterParameter=0}"/>

                <!-- Key light editor -->
                <WrapPanel Orientation="Horizontal"
                           Visibility="{Binding SelectedLightIndex, Converter={StaticResource IntEqVis}, ConverterParameter=1}">
                    <TextBlock Text="Key Light" Foreground="#FFE6D94A" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBlock Text="Intensity:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <xctk:IntegerUpDown Width="70" Minimum="0" Maximum="500"
                                        Value="{Binding KeyLightIntensity}" VerticalAlignment="Center"
                                        FormatString="0'%'" Increment="5"
                                        ToolTip="Key light brightness. 100 = 1.0 multiplier; above 100 over-drives the light for heavily-attenuating materials."/>

                    <TextBlock Text="Azimuth:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <Slider Width="80" Minimum="-180" Maximum="180"
                            Value="{Binding KeyLightAzimuth}" VerticalAlignment="Center"
                            SmallChange="1" LargeChange="15"/>
                    <TextBlock Text="{Binding KeyLightAzimuth, StringFormat={}{0:F0}°}"
                               Foreground="#FF888888" FontSize="10" VerticalAlignment="Center" Width="30" Margin="2,0,0,0"/>

                    <TextBlock Text="Elevation:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <Slider Width="80" Minimum="-90" Maximum="90"
                            Value="{Binding KeyLightElevation}" VerticalAlignment="Center"
                            SmallChange="1" LargeChange="15"/>
                    <TextBlock Text="{Binding KeyLightElevation, StringFormat={}{0:F0}°}"
                               Foreground="#FF888888" FontSize="10" VerticalAlignment="Center" Width="30" Margin="2,0,0,0"/>

                    <TextBlock Text="Color:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <xctk:ColorPicker Width="110" SelectedColor="{Binding KeyLightColor}"
                                      VerticalAlignment="Center" UsingAlphaChannel="False"
                                      ColorMode="ColorCanvas"/>
                </WrapPanel>

                <!-- Fill light editor -->
                <WrapPanel Orientation="Horizontal"
                           Visibility="{Binding SelectedLightIndex, Converter={StaticResource IntEqVis}, ConverterParameter=2}">
                    <TextBlock Text="Fill Light" Foreground="#FF4ADCE6" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBlock Text="Intensity:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <xctk:IntegerUpDown Width="70" Minimum="0" Maximum="500"
                                        Value="{Binding FillLightIntensity}" VerticalAlignment="Center"
                                        FormatString="0'%'" Increment="5"
                                        ToolTip="Fill light brightness. 100 = 1.0 multiplier."/>

                    <TextBlock Text="Azimuth:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <Slider Width="80" Minimum="-180" Maximum="180"
                            Value="{Binding FillLightAzimuth}" VerticalAlignment="Center"
                            SmallChange="1" LargeChange="15"/>
                    <TextBlock Text="{Binding FillLightAzimuth, StringFormat={}{0:F0}°}"
                               Foreground="#FF888888" FontSize="10" VerticalAlignment="Center" Width="30" Margin="2,0,0,0"/>

                    <TextBlock Text="Elevation:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <Slider Width="80" Minimum="-90" Maximum="90"
                            Value="{Binding FillLightElevation}" VerticalAlignment="Center"
                            SmallChange="1" LargeChange="15"/>
                    <TextBlock Text="{Binding FillLightElevation, StringFormat={}{0:F0}°}"
                               Foreground="#FF888888" FontSize="10" VerticalAlignment="Center" Width="30" Margin="2,0,0,0"/>

                    <TextBlock Text="Color:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <xctk:ColorPicker Width="110" SelectedColor="{Binding FillLightColor}"
                                      VerticalAlignment="Center" UsingAlphaChannel="False"
                                      ColorMode="ColorCanvas"/>
                </WrapPanel>

                <!-- Rim light editor -->
                <WrapPanel Orientation="Horizontal"
                           Visibility="{Binding SelectedLightIndex, Converter={StaticResource IntEqVis}, ConverterParameter=3}">
                    <TextBlock Text="Rim Light" Foreground="#FFE64AD9" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBlock Text="Intensity:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <xctk:IntegerUpDown Width="70" Minimum="0" Maximum="500"
                                        Value="{Binding RimLightIntensity}" VerticalAlignment="Center"
                                        FormatString="0'%'" Increment="5"
                                        ToolTip="Rim light brightness. 100 = 1.0 multiplier."/>

                    <TextBlock Text="Azimuth:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <Slider Width="80" Minimum="-180" Maximum="180"
                            Value="{Binding RimLightAzimuth}" VerticalAlignment="Center"
                            SmallChange="1" LargeChange="15"/>
                    <TextBlock Text="{Binding RimLightAzimuth, StringFormat={}{0:F0}°}"
                               Foreground="#FF888888" FontSize="10" VerticalAlignment="Center" Width="30" Margin="2,0,0,0"/>

                    <TextBlock Text="Elevation:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <Slider Width="80" Minimum="-90" Maximum="90"
                            Value="{Binding RimLightElevation}" VerticalAlignment="Center"
                            SmallChange="1" LargeChange="15"/>
                    <TextBlock Text="{Binding RimLightElevation, StringFormat={}{0:F0}°}"
                               Foreground="#FF888888" FontSize="10" VerticalAlignment="Center" Width="30" Margin="2,0,0,0"/>

                    <TextBlock Text="Color:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <xctk:ColorPicker Width="110" SelectedColor="{Binding RimLightColor}"
                                      VerticalAlignment="Center" UsingAlphaChannel="False"
                                      ColorMode="ColorCanvas"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Body .tri missing warning: shown when a BodySlide/BodyGen deform was
             attempted but no sibling .tri was found next to the worn body NIF.
             Prompts the user to run BodySlide's "Build Morphs" on their preset. -->
        <Border Grid.Row="3"
                Background="#FF2A0A0A"
                BorderBrush="#FFAA2222"
                BorderThickness="0,1,0,1"
                Padding="8 4"
                Visibility="{Binding BodyTriMissing, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Body .tri file not found - did you forget to generate a Zeroed Sliders body with morphs?"
                       Foreground="#FFFF4444"
                       FontSize="12"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Pick info panel: compact readout of vertex picks for classifier authoring.
             Collapses entirely when classifier controls are off so the viewport is unaffected. -->
        <Border Grid.Row="4"
                Background="#FF1F1F1F"
                BorderBrush="#FF3A3A3A"
                BorderThickness="0,1,0,1"
                Padding="6 4"
                Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Last pick:" Foreground="#FFAAAAAA" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding LastPickSummary}"
                                   Foreground="#FFFF6126" FontSize="11" FontFamily="Consolas"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="(no picks)"
                                   Foreground="#FF666666" FontSize="11" FontStyle="Italic"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Picks.Count, Converter={StaticResource IntEqVis}, ConverterParameter=0}"/>
                    </StackPanel>

                    <ListBox x:Name="PicksList"
                             ItemsSource="{Binding Picks}"
                             SelectionMode="Extended"
                             SelectionChanged="PicksList_SelectionChanged"
                             MaxHeight="110" Margin="0,3,0,0"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#FFCCCCCC"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ToolTip="Click a row to select a pick. Ctrl/Shift-click for multi-select. 'Select Mirror' acts on the selected rows (or the most recent pick if nothing is selected).">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"
                                           FontSize="11"
                                           FontFamily="Consolas"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Copy TSV"
                        FontSize="10" Padding="8 2"
                        VerticalAlignment="Top" Margin="8,0,0,0"
                        Command="{Binding CopyPicksToClipboardCommand}"
                        ToolTip="Copy all picks to the clipboard as tab-separated values (shape, index, x, y, z). Paste the result back to share pick data."/>
            </Grid>
        </Border>

        <!-- OpenGL Viewport -->
        <glWpf:GLWpfControl
            Grid.Row="5"
            x:Name="GlControl"
            Render="GlControl_OnRender"/>

        <!-- Rubber-band overlay for BB-pick drag. IsHitTestVisible=False so clicks continue
             to hit GlControl beneath. Codebehind positions BoxSelectionRect via
             Canvas.Left/Top/Width/Height and flips Visibility during drag. -->
        <Canvas Grid.Row="5" IsHitTestVisible="False" ClipToBounds="True">
            <Rectangle x:Name="BoxSelectionRect"
                       Visibility="Collapsed"
                       Stroke="#FFFFCC40"
                       StrokeThickness="1"
                       StrokeDashArray="3 2"
                       Fill="#30FFCC40"/>
        </Canvas>

        <!-- Pending-box 3D wireframe overlay. Canvas is populated with 12 Line children from
             codebehind (one per AABB edge); UpdateBoxWireframe projects the 8 corners through
             view*projection each GL frame. Visibility follows HasPendingBox. -->
        <Canvas Grid.Row="5" x:Name="BoxWireframeCanvas"
                IsHitTestVisible="False" ClipToBounds="True"
                Visibility="{Binding HasPendingBox, Converter={StaticResource BoolToVis}}"/>

        <!-- Pending-box edit panel. Floats at top of the viewport while HasPendingBox is true.
             Six SingleUpDowns drive PendingBox{Min,Max}{X,Y,Z}; the wireframe redraws live.
             'Shrink to Camera Half' auto-halves the most-view-aligned axis toward the camera
             (use to carve an overhanging belly from a hip box). Confirm fires the usual
             AnyKeyVertexBoxPicked event; Cancel discards. -->
        <Border Grid.Row="5"
                VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Background="#E01F1F1F" BorderBrush="#FFFFCC40" BorderThickness="0,0,0,2"
                Padding="8 5"
                Visibility="{Binding HasPendingBox, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Pending Box:" Foreground="#FFFFCC40" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PendingBoxShapeName}" Foreground="#FFDDDDDD" FontSize="11"
                               FontFamily="Consolas" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <TextBlock Text="Criterion:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="15,0,4,0"/>
                    <TextBlock Text="{Binding PendingBoxFinalCriterion}" Foreground="#FFEEEEEE" FontSize="11"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="X (L-R):" Foreground="#FFEB5757" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <xctk:SingleUpDown Value="{Binding PendingBoxMinX}"
                                       Minimum="{Binding PendingBoxSliderMinX}"
                                       Maximum="{Binding PendingBoxSliderMaxX}"
                                       FormatString="F1" Increment="0.5" Width="62"/>
                    <TextBlock Text="to" Foreground="#FF888888" FontSize="11"
                               VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <xctk:SingleUpDown Value="{Binding PendingBoxMaxX}"
                                       Minimum="{Binding PendingBoxSliderMinX}"
                                       Maximum="{Binding PendingBoxSliderMaxX}"
                                       FormatString="F1" Increment="0.5" Width="62"/>

                    <TextBlock Text="Y (U-D):" Foreground="#FF57EB57" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="14,0,4,0"/>
                    <xctk:SingleUpDown Value="{Binding PendingBoxMinY}"
                                       Minimum="{Binding PendingBoxSliderMinY}"
                                       Maximum="{Binding PendingBoxSliderMaxY}"
                                       FormatString="F1" Increment="0.5" Width="62"/>
                    <TextBlock Text="to" Foreground="#FF888888" FontSize="11"
                               VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <xctk:SingleUpDown Value="{Binding PendingBoxMaxY}"
                                       Minimum="{Binding PendingBoxSliderMinY}"
                                       Maximum="{Binding PendingBoxSliderMaxY}"
                                       FormatString="F1" Increment="0.5" Width="62"/>

                    <TextBlock Text="Z (F-B):" Foreground="#FF57A0EB" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="14,0,4,0"/>
                    <xctk:SingleUpDown Value="{Binding PendingBoxMinZ}"
                                       Minimum="{Binding PendingBoxSliderMinZ}"
                                       Maximum="{Binding PendingBoxSliderMaxZ}"
                                       FormatString="F1" Increment="0.5" Width="62"/>
                    <TextBlock Text="to" Foreground="#FF888888" FontSize="11"
                               VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <xctk:SingleUpDown Value="{Binding PendingBoxMaxZ}"
                                       Minimum="{Binding PendingBoxSliderMinZ}"
                                       Maximum="{Binding PendingBoxSliderMaxZ}"
                                       FormatString="F1" Increment="0.5" Width="62"/>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Shrink to Camera Half"
                            Command="{Binding ShrinkAlongViewAxisCommand}"
                            FontSize="11" Padding="8 2"
                            ToolTip="Halve the pending box along whichever mesh-local axis most aligns with the camera view, keeping the half nearest the camera. Repeat-click to shrink further. Use to exclude an overhanging belly from a hip box, etc."/>
                    <Button Content="Confirm"
                            Command="{Binding ConfirmPendingBoxCommand}"
                            FontSize="11" FontWeight="Bold" Padding="14 2" Margin="12,0,0,0"
                            Background="#FF2E7D32" Foreground="White"/>
                    <Button Content="Cancel"
                            Command="{Binding CancelPendingBoxCommand}"
                            FontSize="11" Padding="10 2" Margin="6,0,0,0"
                            Background="#FF8B2525" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Axis orientation gizmo. Only the inner Border is hit-testable (Canvas has no
             background), so empty areas pass clicks through to GlControl. Codebehind
             rebuilds the three line/label positions each GL frame from the camera's view
             matrix; dragging the Border moves the widget via Canvas.Left/Top. -->
        <Canvas Grid.Row="5" x:Name="GizmoCanvas" ClipToBounds="True">
            <Border x:Name="AxisGizmoBorder"
                    Canvas.Left="10"
                    Width="80" Height="80"
                    Background="#80101010"
                    BorderBrush="#80A0A0A0" BorderThickness="1"
                    CornerRadius="4"
                    Cursor="SizeAll"
                    ToolTip="World-axis orientation gizmo. Drag to reposition."
                    MouseLeftButtonDown="AxisGizmo_MouseLeftButtonDown"
                    MouseLeftButtonUp="AxisGizmo_MouseLeftButtonUp"
                    MouseMove="AxisGizmo_MouseMove">
                <Canvas>
                    <Ellipse Canvas.Left="37" Canvas.Top="37" Width="6" Height="6" Fill="#FFCCCCCC"/>
                    <Line x:Name="AxisX_Line" Stroke="#FFEB5757" StrokeThickness="2" StrokeEndLineCap="Round"/>
                    <Line x:Name="AxisY_Line" Stroke="#FF57EB57" StrokeThickness="2" StrokeEndLineCap="Round"/>
                    <Line x:Name="AxisZ_Line" Stroke="#FF57A0EB" StrokeThickness="2" StrokeEndLineCap="Round"/>
                    <TextBlock x:Name="AxisX_Label" Text="X" Foreground="#FFEB5757" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="AxisY_Label" Text="Y" Foreground="#FF57EB57" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="AxisZ_Label" Text="Z" Foreground="#FF57A0EB" FontSize="11" FontWeight="Bold"/>
                </Canvas>
            </Border>
        </Canvas>

        <!-- Loading overlay -->
        <Border Grid.Row="5"
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <TextBlock Text="Loading..."
                       Foreground="White"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="6"
                Background="#FF333333"
                Padding="6 3">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="#FFCCCCCC"
                       FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
