<UserControl x:Class="SynthEBD.UC_CharacterViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SynthEBD"
             xmlns:glWpf="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600"
             d:DataContext="{d:DesignInstance Type=local:VM_CharacterViewer}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:IntEqualsToVisibilityConverter x:Key="IntEqVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar row 1: Background + Presets -->
        <Border Grid.Row="0" Background="#FF2A2A2A" Padding="6 3">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Background:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="BgColorCombo" Width="110" FontSize="11" VerticalAlignment="Center"
                          SelectionChanged="BgColorCombo_SelectionChanged" SelectedIndex="0">
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FF696969" Margin="0,0,5,0"/>
                            <TextBlock Text="Dim Gray"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FF333333" Margin="0,0,5,0"/>
                            <TextBlock Text="Dark Gray"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FF000000" Margin="0,0,5,0"/>
                            <TextBlock Text="Black"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FFFFFFFF" Margin="0,0,5,0"/>
                            <TextBlock Text="White"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FF4A6A8A" Margin="0,0,5,0"/>
                            <TextBlock Text="Steel Blue"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FF2D5A27" Margin="0,0,5,0"/>
                            <TextBlock Text="Forest"/>
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>

                <Button Content="Reset View" FontSize="11" Margin="15,0,0,0"
                        Padding="8 2" VerticalAlignment="Center"
                        Click="ResetViewButton_Click"/>

                <Button Content="Controls" FontSize="11" Margin="10,0,0,0"
                        Padding="8 2" VerticalAlignment="Center"
                        Click="ControlsButton_Click"/>

                <TextBlock Text="Light Layout:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="20,0,5,0"/>
                <ComboBox Width="160" FontSize="11" VerticalAlignment="Center"
                          ItemsSource="{Binding LightingLayouts}"
                          SelectedItem="{Binding SelectedLightingLayout}"
                          DisplayMemberPath="Name"
                          ToolTip="Position + intensity of the ambient + key/fill/rim directional lights. 'Mugshot Natural' targets the Natural Lighting Mugshots look."/>
                <Button Content="Save…" FontSize="10" Margin="4,0,0,0" Padding="6 1"
                        VerticalAlignment="Center"
                        Command="{Binding SaveLayoutPresetCommand}"
                        ToolTip="Save the current ambient + key/fill/rim positions and intensities as a user layout preset."/>
                <Button Content="Delete" FontSize="10" Margin="2,0,0,0" Padding="6 1"
                        VerticalAlignment="Center"
                        Command="{Binding DeleteSelectedLayoutCommand}"
                        ToolTip="Delete the selected user layout preset. Built-in presets can't be deleted."/>

                <TextBlock Text="Color Scheme:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,5,0"/>
                <ComboBox Width="140" FontSize="11" VerticalAlignment="Center"
                          ItemsSource="{Binding LightingColorSchemes}"
                          SelectedItem="{Binding SelectedLightingColorScheme}"
                          DisplayMemberPath="Name"
                          ToolTip="Color temperature of the key/fill/rim lights. Combines independently with the selected layout."/>
                <Button Content="Save…" FontSize="10" Margin="4,0,0,0" Padding="6 1"
                        VerticalAlignment="Center"
                        Command="{Binding SaveColorSchemePresetCommand}"
                        ToolTip="Save the current Key/Fill/Rim hues as a user color scheme preset."/>
                <Button Content="Delete" FontSize="10" Margin="2,0,0,0" Padding="6 1"
                        VerticalAlignment="Center"
                        Command="{Binding DeleteSelectedColorSchemeCommand}"
                        ToolTip="Delete the selected user color scheme preset. Built-in presets can't be deleted."/>
            </WrapPanel>
        </Border>

        <!-- Toolbar row 2: Ambient + Show Lights toggle -->
        <Border Grid.Row="1" Background="#FF2A2A2A" Padding="6 2" BorderBrush="#FF1A1A1A" BorderThickness="0,1,0,0">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Ambient:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                <Slider Width="80" Minimum="0" Maximum="100"
                        Value="{Binding AmbientIntensity}" VerticalAlignment="Center"
                        SmallChange="1" LargeChange="10"/>
                <TextBlock Text="{Binding AmbientIntensity, StringFormat={}{0:F0}%}"
                           Foreground="#FF888888" FontSize="10" VerticalAlignment="Center" Width="30" Margin="2,0,0,0"/>

                <CheckBox Content="Key" FontSize="11" Foreground="#FFE6D94A"
                          Margin="15,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding KeyLightEnabled}"
                          ToolTip="Enable/disable the Key directional light."/>
                <CheckBox Content="Fill" FontSize="11" Foreground="#FF4ADCE6"
                          Margin="6,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding FillLightEnabled}"
                          ToolTip="Enable/disable the Fill directional light."/>
                <CheckBox Content="Rim" FontSize="11" Foreground="#FFE64AD9"
                          Margin="6,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding RimLightEnabled}"
                          ToolTip="Enable/disable the Rim directional light."/>

                <CheckBox Content="Show Lights" FontSize="11" Foreground="#FFAAAAAA"
                          Margin="15,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding ShowLightControls}"
                          ToolTip="Draws 3D arrow gizmos for each directional light. Click an arrow to open its per-light editor (azimuth, elevation, intensity, hue)."/>

                <CheckBox Content="Wireframe" FontSize="11" Foreground="#FF33E6D0"
                          Margin="10,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding ShowWireframe}"
                          Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"
                          ToolTip="Overlays the triangle edges of every loaded mesh. Used for key-vertex assignment in the BodySlide classifier workflow."/>

                <CheckBox Content="Pick Vertex" FontSize="11" Foreground="#FFFF6126"
                          Margin="10,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding IsKeyVertexPickMode}"
                          Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"
                          ToolTip="Left-click the model to drop a marker on the nearest triangle vertex. Intended for BodySlide classifier key-vertex assignment; camera orbit is disabled while this is on."/>

                <Button Content="Select Mirror" FontSize="10" Margin="6,0,0,0"
                        Padding="6 1" VerticalAlignment="Center"
                        Click="SelectMirrorPicksButton_Click"
                        Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"
                        ToolTip="For each current pick marker, adds the vertex closest to its X-mirror on the same mesh. Use to fill in bilaterally symmetric counterparts after picking one side."/>

                <Button Content="Clear Picks" FontSize="10" Margin="6,0,0,0"
                        Padding="6 1" VerticalAlignment="Center"
                        Click="ClearKeyVertexMarkersButton_Click"
                        Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"
                        ToolTip="Removes every picked-vertex marker from the viewport."/>

                <Button Content="Log Settings" FontSize="10" Margin="10,0,0,0"
                        Padding="6 1" VerticalAlignment="Center"
                        Click="LogLightingButton_Click"/>
            </WrapPanel>
        </Border>

        <!-- Toolbar row 3: Per-light editor (Key/Fill/Rim) — visible only when ShowLightControls=true and a light is selected -->
        <Border Grid.Row="2" Background="#FF222222" Padding="6 3"
                BorderBrush="#FF1A1A1A" BorderThickness="0,1,0,0"
                Visibility="{Binding ShowLightControls, Converter={StaticResource BoolToVis}}">
            <Grid>
                <!-- Hint shown when no light is selected -->
                <TextBlock Text="Click a light arrow in the viewport to edit its position, intensity, and hue."
                           Foreground="#FF888888" FontSize="11" FontStyle="Italic"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Visibility="{Binding SelectedLightIndex, Converter={StaticResource IntEqVis}, ConverterParameter=0}"/>

                <!-- Key light editor -->
                <WrapPanel Orientation="Horizontal"
                           Visibility="{Binding SelectedLightIndex, Converter={StaticResource IntEqVis}, ConverterParameter=1}">
                    <TextBlock Text="Key Light" Foreground="#FFE6D94A" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBlock Text="Intensity:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <xctk:IntegerUpDown Width="70" Minimum="0" Maximum="500"
                                        Value="{Binding KeyLightIntensity}" VerticalAlignment="Center"
                                        FormatString="0'%'" Increment="5"
                                        ToolTip="Key light brightness. 100 = 1.0 multiplier; above 100 over-drives the light for heavily-attenuating materials."/>

                    <TextBlock Text="Azimuth:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <Slider Width="80" Minimum="-180" Maximum="180"
                            Value="{Binding KeyLightAzimuth}" VerticalAlignment="Center"
                            SmallChange="1" LargeChange="15"/>
                    <TextBlock Text="{Binding KeyLightAzimuth, StringFormat={}{0:F0}°}"
                               Foreground="#FF888888" FontSize="10" VerticalAlignment="Center" Width="30" Margin="2,0,0,0"/>

                    <TextBlock Text="Elevation:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <Slider Width="80" Minimum="-90" Maximum="90"
                            Value="{Binding KeyLightElevation}" VerticalAlignment="Center"
                            SmallChange="1" LargeChange="15"/>
                    <TextBlock Text="{Binding KeyLightElevation, StringFormat={}{0:F0}°}"
                               Foreground="#FF888888" FontSize="10" VerticalAlignment="Center" Width="30" Margin="2,0,0,0"/>

                    <TextBlock Text="Color:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <xctk:ColorPicker Width="110" SelectedColor="{Binding KeyLightColor}"
                                      VerticalAlignment="Center" UsingAlphaChannel="False"
                                      ColorMode="ColorCanvas"/>
                </WrapPanel>

                <!-- Fill light editor -->
                <WrapPanel Orientation="Horizontal"
                           Visibility="{Binding SelectedLightIndex, Converter={StaticResource IntEqVis}, ConverterParameter=2}">
                    <TextBlock Text="Fill Light" Foreground="#FF4ADCE6" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBlock Text="Intensity:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <xctk:IntegerUpDown Width="70" Minimum="0" Maximum="500"
                                        Value="{Binding FillLightIntensity}" VerticalAlignment="Center"
                                        FormatString="0'%'" Increment="5"
                                        ToolTip="Fill light brightness. 100 = 1.0 multiplier."/>

                    <TextBlock Text="Azimuth:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <Slider Width="80" Minimum="-180" Maximum="180"
                            Value="{Binding FillLightAzimuth}" VerticalAlignment="Center"
                            SmallChange="1" LargeChange="15"/>
                    <TextBlock Text="{Binding FillLightAzimuth, StringFormat={}{0:F0}°}"
                               Foreground="#FF888888" FontSize="10" VerticalAlignment="Center" Width="30" Margin="2,0,0,0"/>

                    <TextBlock Text="Elevation:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <Slider Width="80" Minimum="-90" Maximum="90"
                            Value="{Binding FillLightElevation}" VerticalAlignment="Center"
                            SmallChange="1" LargeChange="15"/>
                    <TextBlock Text="{Binding FillLightElevation, StringFormat={}{0:F0}°}"
                               Foreground="#FF888888" FontSize="10" VerticalAlignment="Center" Width="30" Margin="2,0,0,0"/>

                    <TextBlock Text="Color:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <xctk:ColorPicker Width="110" SelectedColor="{Binding FillLightColor}"
                                      VerticalAlignment="Center" UsingAlphaChannel="False"
                                      ColorMode="ColorCanvas"/>
                </WrapPanel>

                <!-- Rim light editor -->
                <WrapPanel Orientation="Horizontal"
                           Visibility="{Binding SelectedLightIndex, Converter={StaticResource IntEqVis}, ConverterParameter=3}">
                    <TextBlock Text="Rim Light" Foreground="#FFE64AD9" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <TextBlock Text="Intensity:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <xctk:IntegerUpDown Width="70" Minimum="0" Maximum="500"
                                        Value="{Binding RimLightIntensity}" VerticalAlignment="Center"
                                        FormatString="0'%'" Increment="5"
                                        ToolTip="Rim light brightness. 100 = 1.0 multiplier."/>

                    <TextBlock Text="Azimuth:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <Slider Width="80" Minimum="-180" Maximum="180"
                            Value="{Binding RimLightAzimuth}" VerticalAlignment="Center"
                            SmallChange="1" LargeChange="15"/>
                    <TextBlock Text="{Binding RimLightAzimuth, StringFormat={}{0:F0}°}"
                               Foreground="#FF888888" FontSize="10" VerticalAlignment="Center" Width="30" Margin="2,0,0,0"/>

                    <TextBlock Text="Elevation:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <Slider Width="80" Minimum="-90" Maximum="90"
                            Value="{Binding RimLightElevation}" VerticalAlignment="Center"
                            SmallChange="1" LargeChange="15"/>
                    <TextBlock Text="{Binding RimLightElevation, StringFormat={}{0:F0}°}"
                               Foreground="#FF888888" FontSize="10" VerticalAlignment="Center" Width="30" Margin="2,0,0,0"/>

                    <TextBlock Text="Color:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,4,0"/>
                    <xctk:ColorPicker Width="110" SelectedColor="{Binding RimLightColor}"
                                      VerticalAlignment="Center" UsingAlphaChannel="False"
                                      ColorMode="ColorCanvas"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Body .tri missing warning: shown when a BodySlide/BodyGen deform was
             attempted but no sibling .tri was found next to the worn body NIF.
             Prompts the user to run BodySlide's "Build Morphs" on their preset. -->
        <Border Grid.Row="3"
                Background="#FF2A0A0A"
                BorderBrush="#FFAA2222"
                BorderThickness="0,1,0,1"
                Padding="8 4"
                Visibility="{Binding BodyTriMissing, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Body .tri file not found - did you forget to generate a Zeroed Sliders body with morphs?"
                       Foreground="#FFFF4444"
                       FontSize="12"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- OpenGL Viewport -->
        <glWpf:GLWpfControl
            Grid.Row="4"
            x:Name="GlControl"
            Render="GlControl_OnRender"/>

        <!-- Loading overlay -->
        <Border Grid.Row="4"
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <TextBlock Text="Loading..."
                       Foreground="White"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="5"
                Background="#FF333333"
                Padding="6 3">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="#FFCCCCCC"
                       FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
