<UserControl x:Class="SynthEBD.UC_CharacterViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SynthEBD"
             xmlns:cvr="clr-namespace:CharacterViewer.Rendering;assembly=CharacterViewer.Rendering"
             xmlns:cvrv="clr-namespace:CharacterViewer.Rendering.Views;assembly=CharacterViewer.Rendering"
             xmlns:glWpf="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600"
             d:DataContext="{d:DesignInstance Type=cvr:VM_CharacterViewer}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:IntEqualsToVisibilityConverter x:Key="IntEqVis" />
        <local:EnumDescriptionConverter x:Key="EnumDesc" />
        <local:EnumShortLabelConverter x:Key="EnumShortLabel" />

        <!-- Implicit dark style for the pending-box edit spinners, mirroring the
             UC_CharacterViewerRenderPanel pattern. The app themes ship implicit Xceed
             spinner styles that follow the active (possibly light) palette; this nearer
             style shadows them so the viewport HUD stays dark on every theme. -->
        <Style TargetType="{x:Type xctk:SingleUpDown}">
            <Setter Property="Background" Value="#FF1F1F1F"/>
            <Setter Property="Foreground" Value="#FFE0E0E0"/>
            <Setter Property="BorderBrush" Value="#FF555555"/>
            <Setter Property="CaretBrush" Value="#FFE0E0E0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar row 1: Background + Presets -->
        <Border Grid.Row="0" Background="#FF2A2A2A" Padding="6 3">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Background:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="BgColorCombo" Width="110" FontSize="11" VerticalAlignment="Center"
                          SelectionChanged="BgColorCombo_SelectionChanged" SelectedIndex="0">
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FF696969" Margin="0,0,5,0"/>
                            <TextBlock Text="Dim Gray"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FF333333" Margin="0,0,5,0"/>
                            <TextBlock Text="Dark Gray"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FF000000" Margin="0,0,5,0"/>
                            <TextBlock Text="Black"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FFFFFFFF" Margin="0,0,5,0"/>
                            <TextBlock Text="White"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FF4A6A8A" Margin="0,0,5,0"/>
                            <TextBlock Text="Steel Blue"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FF2D5A27" Margin="0,0,5,0"/>
                            <TextBlock Text="Forest"/>
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>

                <Button Content="Reset View" FontSize="11" Margin="15,0,0,0"
                        Padding="8 2" VerticalAlignment="Center"
                        Click="ResetViewButton_Click"/>

                <Button Content="Controls" FontSize="11" Margin="10,0,0,0"
                        Padding="8 2" VerticalAlignment="Center"
                        Click="ControlsButton_Click"/>

                <!-- Toggle buttons collapse the shared lighting / render panels by default
                     so the viewport gets the vertical space until the user opts in.
                     Click handlers flip the panel's Visibility and rewrite this Content. -->
                <Button x:Name="LightSettingsToggleButton"
                        Content="Show Light Settings" FontSize="11" Margin="10,0,0,0"
                        Padding="8 2" VerticalAlignment="Center"
                        Click="LightSettingsToggleButton_Click"/>

                <Button x:Name="RenderSettingsToggleButton"
                        Content="Show Render Settings" FontSize="11" Margin="6,0,0,0"
                        Padding="8 2" VerticalAlignment="Center"
                        Click="RenderSettingsToggleButton_Click"/>
            </WrapPanel>
        </Border>

        <!-- Toolbar row 2: classifier-only toggles + Verbose Log, with Compare pinned right.
             DockPanel (not a bare WrapPanel) so the Compare button can right-align: it docks
             Right FIRST, then the WrapPanel fills the remaining width. Docking order matters —
             a Right-docked child declared after the fill child gets no space. When the toolbar
             wraps to multiple lines the button stays pinned to the top-right corner. -->
        <Border Grid.Row="1" Background="#FF2A2A2A" Padding="6 2" BorderBrush="#FF1A1A1A" BorderThickness="0,1,0,0">
          <DockPanel LastChildFill="True">
            <!-- Compare: opens the two-pane BodySlide comparison window. Deliberately tinted
                 differently from its neighbours so it reads as a "goes somewhere else" action
                 rather than another inline toggle. The colors are hard-coded rather than
                 DynamicResource theme brushes because this whole toolbar is intentionally dark
                 on every theme (see the spinner-style note in UserControl.Resources) - a theme
                 brush would render light-on-light. Only shown for hosts that wired a
                 CompareCommand; see VM_CharacterViewer.CompareButtonAvailable. -->
            <Button DockPanel.Dock="Right" Content="Compare" FontSize="10"
                    Margin="12,0,0,0" Padding="10 1" VerticalAlignment="Center"
                    Command="{Binding CompareCommand}"
                    Visibility="{Binding CompareButtonAvailable, Converter={StaticResource BoolToVis}}"
                    local:DocTooltip.Key="CharacterViewer.Compare">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FF3A3260"/>
                        <Setter Property="Foreground" Value="#FFB79CED"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                            BorderBrush="#FF6B5BA8" BorderThickness="1" CornerRadius="2"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FF4B4080"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#FF9A86D6"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#FF2E2850"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <WrapPanel Orientation="Horizontal">
                <CheckBox Content="Wireframe" FontSize="11" Foreground="#FF33E6D0"
                          Margin="10,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding ShowWireframe}"
                          Visibility="{Binding ClassifierControlsAvailable, Converter={StaticResource BoolToVis}}"
                          local:DocTooltip.Key="CharacterViewer.Wireframe"/>

                <CheckBox Content="Pick Vertex" FontSize="11" Foreground="#FFFF6126"
                          Margin="10,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding IsKeyVertexPickMode}"
                          Visibility="{Binding ClassifierControlsAvailable, Converter={StaticResource BoolToVis}}"
                          local:DocTooltip.Key="CharacterViewer.PickVertex"/>

                <CheckBox Content="Pick Box" FontSize="11" Foreground="#FFFFCC40"
                          Margin="10,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding IsBoundingBoxPickMode}"
                          Visibility="{Binding ClassifierControlsAvailable, Converter={StaticResource BoolToVis}}"
                          local:DocTooltip.Key="CharacterViewer.PickBox"/>

                <!-- Region vertex-edit mode: two mutually-exclusive toggle buttons. At most one is on;
                     both can be off (default) so a left-drag orbits the camera. The VM properties enforce
                     the exclusivity; a custom template shows the checked state in green (add) / red
                     (remove) over the dark toolbar. -->
                <ToggleButton x:Name="AddVertsToggle" Content="Add Verts" FontSize="11" Padding="8,1"
                              Margin="10,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding IsRegionVertexAddMode}"
                              Visibility="{Binding ClassifierControlsAvailable, Converter={StaticResource BoolToVis}}"
                              local:DocTooltip.Key="CharacterViewer.AddVerts">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="#FF333333"/>
                            <Setter Property="Foreground" Value="#FF66E08A"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#FF555555"
                                                BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#FF2E7D32"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF888888"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <ToggleButton x:Name="RemoveVertsToggle" Content="Remove Verts" FontSize="11" Padding="8,1"
                              Margin="6,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding IsRegionVertexRemoveMode}"
                              Visibility="{Binding ClassifierControlsAvailable, Converter={StaticResource BoolToVis}}"
                              local:DocTooltip.Key="CharacterViewer.RemoveVerts">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Setter Property="Background" Value="#FF333333"/>
                            <Setter Property="Foreground" Value="#FFE06A6A"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="#FF555555"
                                                BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#FF8B2525"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF888888"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <TextBlock Text="Criterion:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,3,0"
                           Visibility="{Binding ClassifierControlsAvailable, Converter={StaticResource BoolToVis}}"/>
                <!-- Criterion picker: closed button shows the short [ShortLabel] of the
                     current selection with its long [Description] as tooltip; clicking opens a
                     Popup containing a TreeView grouped by algorithm category (Axis Extremes /
                     Mirrored Across Midline / Waist Pinch / Hip Bulge / Paired / Centerline /
                     Mirror Shortcuts). Tree structure lives in BoxCriterionSelectionTree; per-leaf
                     labels and tooltips come from the enum attributes via reflection.
                     TreeView.Tag carries the route key ("Pending") that the code-behind handler
                     uses to dispatch the write — symmetric with the pending-box-confirm picker
                     below ("PendingFinal"). -->
                <Grid Width="180" VerticalAlignment="Center"
                      Visibility="{Binding ClassifierControlsAvailable, Converter={StaticResource BoolToVis}}">
                    <ToggleButton x:Name="CritToggleBBPick" FontSize="10"
                                  Content="{Binding PendingBoxCriterion, Converter={StaticResource EnumShortLabel}}"
                                  ToolTip="{Binding PendingBoxCriterion, Converter={StaticResource EnumDesc}}"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Center"
                                  Padding="4,1"/>
                    <Popup IsOpen="{Binding IsChecked, ElementName=CritToggleBBPick, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=CritToggleBBPick}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="#FF2A2A2A" BorderBrush="Gray" BorderThickness="1" Padding="4">
                            <TreeView ItemsSource="{x:Static cvr:BoxCriterionSelectionTree.Categories}"
                                      Tag="Pending"
                                      SelectedItemChanged="BoxCriterionSelectionTree_SelectedItemChanged"
                                      MinWidth="400" MaxHeight="520"
                                      Background="Transparent" BorderThickness="0">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type cvr:BoxCriterionSelectionCategory}"
                                                              ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                                                   ToolTip="{Binding Description}" TextWrapping="NoWrap"/>
                                    </HierarchicalDataTemplate>
                                    <DataTemplate DataType="{x:Type cvr:BoxCriterionSelectionLeaf}">
                                        <TextBlock Text="{Binding Label}" ToolTip="{Binding Description}" TextWrapping="NoWrap"/>
                                    </DataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </Border>
                    </Popup>
                </Grid>

                <Button Content="Select Mirror" FontSize="10" Margin="6,0,0,0"
                        Padding="6 1" VerticalAlignment="Center"
                        Click="SelectMirrorPicksButton_Click"
                        Visibility="{Binding ClassifierControlsAvailable, Converter={StaticResource BoolToVis}}"
                        local:DocTooltip.Key="CharacterViewer.SelectMirror"/>

                <TextBlock Text="Axis:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,3,0"
                           Visibility="{Binding ClassifierControlsAvailable, Converter={StaticResource BoolToVis}}"/>
                <ComboBox Width="42" FontSize="10" VerticalAlignment="Center"
                          SelectedIndex="{Binding ProjectAcrossAxisIndex}"
                          Visibility="{Binding ClassifierControlsAvailable, Converter={StaticResource BoolToVis}}"
                          local:DocTooltip.Key="CharacterViewer.PairAxis">
                    <ComboBoxItem Content="X"/>
                    <ComboBoxItem Content="Y"/>
                    <ComboBoxItem Content="Z"/>
                </ComboBox>

                <Button Content="Pair Across Axis" FontSize="10" Margin="4,0,0,0"
                        Padding="6 1" VerticalAlignment="Center"
                        Click="PairAcrossAxisButton_Click"
                        Visibility="{Binding ClassifierControlsAvailable, Converter={StaticResource BoolToVis}}"
                        local:DocTooltip.Key="CharacterViewer.PairAcrossAxis"/>

                <Button Content="Clear Picks" FontSize="10" Margin="6,0,0,0"
                        Padding="6 1" VerticalAlignment="Center"
                        Click="ClearKeyVertexMarkersButton_Click"
                        Visibility="{Binding ClassifierControlsAvailable, Converter={StaticResource BoolToVis}}"
                        local:DocTooltip.Key="CharacterViewer.ClearPicks"/>

                <CheckBox Content="Show Bulge Bins" FontSize="11" Foreground="#FF66E6FF"
                          Margin="10,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding ShowBulgeBinOverlay}"
                          Visibility="{Binding ClassifierControlsAvailable, Converter={StaticResource BoolToVis}}"
                          local:DocTooltip.Key="CharacterViewer.ShowBulgeBins"/>

                <CheckBox Content="Verbose Log" FontSize="11" Foreground="#FFAAAAAA"
                          Margin="15,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding VerboseLog}"
                          local:DocTooltip.Key="CharacterViewer.VerboseLog"/>

                <Button Content="Log Settings" FontSize="10" Margin="10,0,0,0"
                        Padding="6 1" VerticalAlignment="Center"
                        Click="LogLightingButton_Click"/>
            </WrapPanel>
          </DockPanel>
        </Border>

        <!-- Toolbar row 3: shared lighting panel (presets / ambient / per-light editor).
             Collapsed by default; toggled from LightSettingsToggleButton above. -->
        <cvrv:UC_CharacterViewerLightingPanel x:Name="LightingPanel"
                                              Grid.Row="2"
                                              Visibility="Collapsed"/>

        <!-- Toolbar row 4: shared render-pipeline panel (tone-mapping / shadows / SSAO /
             SSS / vignette / wireframe-missing-tex). Collapsed by default; toggled from
             RenderSettingsToggleButton above. -->
        <cvrv:UC_CharacterViewerRenderPanel x:Name="RenderPanel"
                                            Grid.Row="3"
                                            Visibility="Collapsed"/>

        <!-- Body .tri missing warning: shown when a BodySlide/BodyGen deform was
             attempted but no sibling .tri was found next to the worn body NIF.
             Prompts the user to run BodySlide's "Build Morphs" on their preset. -->
        <Border Grid.Row="4"
                Background="#FF2A0A0A"
                BorderBrush="#FFAA2222"
                BorderThickness="0,1,0,1"
                Padding="8 4"
                Visibility="{Binding BodyTriMissing, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Body .tri file not found - did you forget to generate a Zeroed Sliders body with morphs?"
                       Foreground="#FFFF4444"
                       FontSize="12"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Pick info panel: compact readout of vertex picks for classifier authoring.
             Collapses entirely when classifier controls are off so the viewport is unaffected. -->
        <Border Grid.Row="5"
                Background="#FF1F1F1F"
                BorderBrush="#FF3A3A3A"
                BorderThickness="0,1,0,1"
                Padding="6 4"
                Visibility="{Binding ClassifierControlsAvailable, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="Last pick:" Foreground="#FFAAAAAA" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding LastPickSummary}"
                                   Foreground="#FFFF6126" FontSize="11" FontFamily="Consolas"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="(no picks)"
                                   Foreground="#FF666666" FontSize="11" FontStyle="Italic"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Picks.Count, Converter={StaticResource IntEqVis}, ConverterParameter=0}"/>
                    </WrapPanel>

                    <ListBox x:Name="PicksList"
                             ItemsSource="{Binding Picks}"
                             SelectionMode="Extended"
                             SelectionChanged="PicksList_SelectionChanged"
                             MaxHeight="110" Margin="0,3,0,0"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#FFCCCCCC"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             local:DocTooltip.Key="CharacterViewer.PicksList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"
                                           FontSize="11"
                                           FontFamily="Consolas"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Copy TSV"
                        FontSize="10" Padding="8 2"
                        VerticalAlignment="Top" Margin="8,0,0,0"
                        Command="{Binding CopyPicksToClipboardCommand}"
                        local:DocTooltip.Key="CharacterViewer.CopyPicksTsv"/>
            </Grid>
        </Border>

        <!-- OpenGL Viewport -->
        <glWpf:GLWpfControl
            Grid.Row="6"
            x:Name="GlControl"
            Render="GlControl_OnRender"/>

        <!-- Rubber-band overlay for BB-pick drag. IsHitTestVisible=False so clicks continue
             to hit GlControl beneath. Codebehind positions BoxSelectionRect via
             Canvas.Left/Top/Width/Height and flips Visibility during drag. -->
        <Canvas Grid.Row="6" IsHitTestVisible="False" ClipToBounds="True">
            <Rectangle x:Name="BoxSelectionRect"
                       Visibility="Collapsed"
                       Stroke="#FFFFCC40"
                       StrokeThickness="1"
                       StrokeDashArray="3 2"
                       Fill="#30FFCC40"/>
        </Canvas>

        <!-- Pending-box 3D wireframe overlay. Canvas is populated with 12 Line children from
             codebehind (one per AABB edge); UpdateBoxWireframe projects the 8 corners through
             view*projection each GL frame. Visibility follows HasPendingBox. -->
        <Canvas Grid.Row="6" x:Name="BoxWireframeCanvas"
                IsHitTestVisible="False" ClipToBounds="True"
                Visibility="{Binding HasPendingBox, Converter={StaticResource BoolToVis}}"/>

        <!-- Pending-box edit panel. Floats at top of the viewport while HasPendingBox is true.
             Six SingleUpDowns drive PendingBox{Min,Max}{X,Y,Z}; the wireframe redraws live.
             'Shrink to Camera Half' auto-halves the most-view-aligned axis toward the camera
             (use to carve an overhanging belly from a hip box). Confirm fires the usual
             AnyKeyVertexBoxPicked event; Confirm as Duplicate fires it but leaves the box
             pending so a follow-up confirm with a different criterion reuses the same AABB;
             Cancel discards. -->
        <Border Grid.Row="6"
                VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Background="#E01F1F1F" BorderBrush="#FFFFCC40" BorderThickness="0,0,0,2"
                Padding="8 5"
                Visibility="{Binding HasPendingBox, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Vertical">
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Pending Box:" Foreground="#FFFFCC40" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PendingBoxShapeName}" Foreground="#FFDDDDDD" FontSize="11"
                               FontFamily="Consolas" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <TextBlock Text="Criterion:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="15,0,4,0"/>
                    <!-- Editable while the box is pending so the user can change the algorithm
                         after drawing without cancelling/re-drawing. ConfirmPendingBox reads
                         PendingBoxFinalCriterion, so whatever is selected here is what fires. -->
                    <!-- Same picker as the BB-pick toolbar above; routes to PendingBoxFinalCriterion
                         instead of PendingBoxCriterion via TreeView.Tag = "PendingFinal". -->
                    <Grid MinWidth="180" VerticalAlignment="Center">
                        <ToggleButton x:Name="CritTogglePendingFinal" FontSize="11"
                                      Content="{Binding PendingBoxFinalCriterion, Converter={StaticResource EnumShortLabel}}"
                                      ToolTip="{Binding PendingBoxFinalCriterion, Converter={StaticResource EnumDesc}}"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Center"
                                      Padding="4,1"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=CritTogglePendingFinal, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=CritTogglePendingFinal}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="#FF2A2A2A" BorderBrush="Gray" BorderThickness="1" Padding="4">
                                <TreeView ItemsSource="{x:Static cvr:BoxCriterionSelectionTree.Categories}"
                                          Tag="PendingFinal"
                                          SelectedItemChanged="BoxCriterionSelectionTree_SelectedItemChanged"
                                          MinWidth="400" MaxHeight="520"
                                          Background="Transparent" BorderThickness="0">
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type cvr:BoxCriterionSelectionCategory}"
                                                                  ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                                                       ToolTip="{Binding Description}" TextWrapping="NoWrap"/>
                                        </HierarchicalDataTemplate>
                                        <DataTemplate DataType="{x:Type cvr:BoxCriterionSelectionLeaf}">
                                            <TextBlock Text="{Binding Label}" ToolTip="{Binding Description}" TextWrapping="NoWrap"/>
                                        </DataTemplate>
                                    </TreeView.Resources>
                                </TreeView>
                            </Border>
                        </Popup>
                    </Grid>
                    <!-- Symmetry lock: each flag mirrors min<->max about 0 on that axis.
                         Auto-seeded on capture when the drawn box straddles an axis within 10%.
                         ToolTip lists the combinations; enum ToString formats "X, Y" etc. -->
                    <TextBlock Text="Force Symmetry:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="15,0,4,0"/>
                    <ComboBox ItemsSource="{Binding Source={x:Static cvr:VM_CharacterViewer.SymmetryAxesChoices}}"
                              SelectedItem="{Binding PendingBoxSymmetry}"
                              FontSize="11" MinWidth="90" VerticalAlignment="Center"
                              local:DocTooltip.Key="CharacterViewer.ForceSymmetry"/>
                    <CheckBox Content="Show zeroed body"
                              IsChecked="{Binding PendingBoxShowZeroed}"
                              Foreground="#FFDDDDDD" FontSize="11" VerticalAlignment="Center" Margin="15,0,0,0"
                              local:DocTooltip.Key="CharacterViewer.ShowZeroedBody"/>
                </WrapPanel>

                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="X (L-R):" Foreground="#FFEB5757" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <xctk:SingleUpDown Value="{Binding PendingBoxMinX}"
                                       Foreground="White"
                                       FormatString="F1" Increment="0.5" Width="62"/>
                    <TextBlock Text="to" Foreground="#FF888888" FontSize="11"
                               VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <xctk:SingleUpDown Value="{Binding PendingBoxMaxX}"
                                       Foreground="White"
                                       FormatString="F1" Increment="0.5" Width="62"/>

                    <TextBlock Text="Y (U-D):" Foreground="#FF57EB57" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="14,0,4,0"/>
                    <xctk:SingleUpDown Value="{Binding PendingBoxMinY}"
                                       Foreground="White"
                                       FormatString="F1" Increment="0.5" Width="62"/>
                    <TextBlock Text="to" Foreground="#FF888888" FontSize="11"
                               VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <xctk:SingleUpDown Value="{Binding PendingBoxMaxY}"
                                       Foreground="White"
                                       FormatString="F1" Increment="0.5" Width="62"/>

                    <TextBlock Text="Z (F-B):" Foreground="#FF57A0EB" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="14,0,4,0"/>
                    <xctk:SingleUpDown Value="{Binding PendingBoxMinZ}"
                                       Foreground="White"
                                       FormatString="F1" Increment="0.5" Width="62"/>
                    <TextBlock Text="to" Foreground="#FF888888" FontSize="11"
                               VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <xctk:SingleUpDown Value="{Binding PendingBoxMaxZ}"
                                       Foreground="White"
                                       FormatString="F1" Increment="0.5" Width="62"/>
                </WrapPanel>

                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Shrink to Camera Half"
                            Command="{Binding ShrinkAlongViewAxisCommand}"
                            FontSize="11" Padding="8 2" Margin="0,0,0,2"
                            local:DocTooltip.Key="CharacterViewer.ShrinkToCameraHalf"/>
                    <Button Content="Confirm"
                            Command="{Binding ConfirmPendingBoxCommand}"
                            FontSize="11" FontWeight="Bold" Padding="14 2" Margin="12,0,0,2"
                            Background="#FF2E7D32" Foreground="White"/>
                    <Button Content="Confirm as Duplicate"
                            Command="{Binding ConfirmPendingBoxAsDuplicateCommand}"
                            FontSize="11" FontWeight="Bold" Padding="10 2" Margin="6,0,0,2"
                            Background="#FF1565C0" Foreground="White"
                            local:DocTooltip.Key="CharacterViewer.ConfirmAsDuplicate"/>
                    <Button Content="Duplicate as Region"
                            Command="{Binding ConfirmPendingBoxAsRegionDuplicateCommand}"
                            FontSize="11" FontWeight="Bold" Padding="10 2" Margin="6,0,0,2"
                            Background="#FF00695C" Foreground="White"
                            local:DocTooltip.Key="CharacterViewer.DuplicateAsRegion"/>
                    <Button Content="Confirm as Region"
                            Command="{Binding ConfirmPendingBoxAsRegionCommand}"
                            FontSize="11" FontWeight="Bold" Padding="10 2" Margin="6,0,0,2"
                            Background="#FF00838F" Foreground="White"
                            local:DocTooltip.Key="CharacterViewer.ConfirmAsRegion"/>
                    <Button Content="Cancel"
                            Command="{Binding CancelPendingBoxCommand}"
                            FontSize="11" Padding="10 2" Margin="6,0,0,2"
                            Background="#FF8B2525" Foreground="White"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Axis orientation gizmo. Only the inner Border is hit-testable (Canvas has no
             background), so empty areas pass clicks through to GlControl. Codebehind
             rebuilds the three line/label positions each GL frame from the camera's view
             matrix; dragging the Border moves the widget via Canvas.Left/Top. -->
        <Canvas Grid.Row="6" x:Name="GizmoCanvas" ClipToBounds="True">
            <Border x:Name="AxisGizmoBorder"
                    Canvas.Left="10"
                    Width="80" Height="80"
                    Background="#80101010"
                    BorderBrush="#80A0A0A0" BorderThickness="1"
                    CornerRadius="4"
                    Cursor="SizeAll"
                    local:DocTooltip.Key="CharacterViewer.AxisGizmo"
                    MouseLeftButtonDown="AxisGizmo_MouseLeftButtonDown"
                    MouseLeftButtonUp="AxisGizmo_MouseLeftButtonUp"
                    MouseMove="AxisGizmo_MouseMove">
                <Canvas>
                    <Ellipse Canvas.Left="37" Canvas.Top="37" Width="6" Height="6" Fill="#FFCCCCCC"/>
                    <Line x:Name="AxisX_Line" Stroke="#FFEB5757" StrokeThickness="2" StrokeEndLineCap="Round"/>
                    <Line x:Name="AxisY_Line" Stroke="#FF57EB57" StrokeThickness="2" StrokeEndLineCap="Round"/>
                    <Line x:Name="AxisZ_Line" Stroke="#FF57A0EB" StrokeThickness="2" StrokeEndLineCap="Round"/>
                    <TextBlock x:Name="AxisX_Label" Text="X" Foreground="#FFEB5757" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="AxisY_Label" Text="Y" Foreground="#FF57EB57" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="AxisZ_Label" Text="Z" Foreground="#FF57A0EB" FontSize="11" FontWeight="Bold"/>
                </Canvas>
            </Border>
        </Canvas>

        <!-- Busy overlay: the viewer's own loads (IsLoading, load→scene-commit) OR
             host-flagged external work (IsHostBusy, e.g. "Select from Config File"
             rolling a combination on a background thread). The spinner storyboard
             starts/stops with visibility so it doesn't animate while collapsed. -->
        <Border Grid.Row="6"
                Background="#80000000"
                Visibility="{Binding IsBusyOverlayVisible, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="44" Height="44"
                         Stroke="#FFFFCC40" StrokeThickness="4"
                         StrokeDashArray="2.4 1.2" StrokeDashCap="Round"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <Trigger Property="IsVisible" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="BusySpinnerStoryboard">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360"
                                                                 Duration="0:0:1.2"
                                                                 RepeatBehavior="Forever"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="BusySpinnerStoryboard"/>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding BusyOverlayText}"
                           Foreground="White"
                           FontSize="18"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Software fallback preview. Shown when GLWpfControl can't start (no NV_DX_interop)
             but the offscreen GL renderer (a hidden GLFW GameWindow + FBO, no interop needed)
             can. FallbackImage displays WriteableBitmap frames produced by
             FallbackPreviewController; codebehind wires mouse orbit/pan/zoom + resize to it.
             View-only mode is announced via the VM's StatusText (bottom status bar) rather
             than an in-viewport badge, which covered the render; the busy chip shows while a
             frame renders so the post-drag pause reads as intentional. Collapsed until
             fallback mode activates. -->
        <Grid Grid.Row="6" x:Name="FallbackPanel" Visibility="Collapsed"
              Background="#FF1F1F1F" ClipToBounds="True">
            <!-- Display layer only. IsHitTestVisible=False so mouse goes to the always-full-size
                 FallbackPanel Grid: an Image with a null Source arranges to 0x0 (its content
                 size), so it can neither be sized nor clicked until a frame exists. -->
            <Image x:Name="FallbackImage"
                   Stretch="Uniform"
                   IsHitTestVisible="False"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <!-- Shown until the first frame arrives. If it persists, no preview is loaded
                 (or the offscreen render produced nothing — see the verbose viewer log). -->
            <TextBlock x:Name="FallbackStatusText"
                       Text="Preparing software preview... (loads when a preview NPC / preset is selected)"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                       Foreground="#FF9AA0A6" FontSize="13"
                       IsHitTestVisible="False"/>

            <Border x:Name="FallbackBusyIndicator" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                    Background="#C0202020" BorderBrush="#40FFFFFF" BorderThickness="1"
                    CornerRadius="3" Padding="8 4" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#FFFFCC40" VerticalAlignment="Center"/>
                    <TextBlock Text="Rendering..." Foreground="#FFD0D0D0" FontSize="11"
                               Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- GL-unavailable placeholder. Revealed by codebehind (ShowGlUnavailablePlaceholder)
             when GLWpfControl.Start() throws because the system's OpenGL driver lacks the
             WGL_NV_DX_interop extension GLWpfControl needs to share its render surface with
             WPF's D3D compositor (expected under Wine/Proton, virtual machines, and remote
             desktop). The GL control + its live-viewport overlays are collapsed in the same
             failure path so only this message remains. It is the last child of Row 6, so it
             paints on top and also masks the loading / pending-box overlays if their VM flags
             were ever set. Dark HUD palette (hardcoded, like the other viewport overlays in
             this control) so it reads the same on every app theme. -->
        <Border Grid.Row="6"
                x:Name="GlUnavailablePanel"
                Visibility="Collapsed"
                Background="#FF1F1F1F"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <TextBlock MaxWidth="480"
                       Margin="24"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#FFCCCCCC"
                       FontSize="13">
                <Run Text="3D preview unavailable" FontSize="15" FontWeight="Bold" Foreground="#FFE0E0E0"/>
                <LineBreak/><LineBreak/>
                <Run Text="This system's OpenGL driver does not support the NV_DX_interop extension required to embed OpenGL in WPF. This is expected under Wine/Proton, virtual machines, and remote desktop."/>
                <LineBreak/><LineBreak/>
                <Run Text="All other SynthEBD functionality is unaffected." Foreground="#FF9AA0A6" FontStyle="Italic"/>
            </TextBlock>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="7"
                Background="#FF333333"
                Padding="6 3">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="#FFCCCCCC"
                       FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
