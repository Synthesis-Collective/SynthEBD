<UserControl x:Class="SynthEBD.UC_CharacterViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SynthEBD"
             xmlns:cvr="clr-namespace:CharacterViewer.Rendering;assembly=CharacterViewer.Rendering"
             xmlns:cvrv="clr-namespace:CharacterViewer.Rendering.Views;assembly=CharacterViewer.Rendering"
             xmlns:glWpf="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600"
             d:DataContext="{d:DesignInstance Type=cvr:VM_CharacterViewer}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:IntEqualsToVisibilityConverter x:Key="IntEqVis" />
        <local:EnumDescriptionConverter x:Key="EnumDesc" />
        <local:EnumShortLabelConverter x:Key="EnumShortLabel" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar row 1: Background + Presets -->
        <Border Grid.Row="0" Background="#FF2A2A2A" Padding="6 3">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Background:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="BgColorCombo" Width="110" FontSize="11" VerticalAlignment="Center"
                          SelectionChanged="BgColorCombo_SelectionChanged" SelectedIndex="0">
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FF696969" Margin="0,0,5,0"/>
                            <TextBlock Text="Dim Gray"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FF333333" Margin="0,0,5,0"/>
                            <TextBlock Text="Dark Gray"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FF000000" Margin="0,0,5,0"/>
                            <TextBlock Text="Black"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FFFFFFFF" Margin="0,0,5,0"/>
                            <TextBlock Text="White"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FF4A6A8A" Margin="0,0,5,0"/>
                            <TextBlock Text="Steel Blue"/>
                        </StackPanel>
                    </ComboBoxItem>
                    <ComboBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="14" Height="14" Fill="#FF2D5A27" Margin="0,0,5,0"/>
                            <TextBlock Text="Forest"/>
                        </StackPanel>
                    </ComboBoxItem>
                </ComboBox>

                <Button Content="Reset View" FontSize="11" Margin="15,0,0,0"
                        Padding="8 2" VerticalAlignment="Center"
                        Click="ResetViewButton_Click"/>

                <Button Content="Controls" FontSize="11" Margin="10,0,0,0"
                        Padding="8 2" VerticalAlignment="Center"
                        Click="ControlsButton_Click"/>

                <!-- Toggle buttons collapse the shared lighting / render panels by default
                     so the viewport gets the vertical space until the user opts in.
                     Click handlers flip the panel's Visibility and rewrite this Content. -->
                <Button x:Name="LightSettingsToggleButton"
                        Content="Show Light Settings" FontSize="11" Margin="10,0,0,0"
                        Padding="8 2" VerticalAlignment="Center"
                        Click="LightSettingsToggleButton_Click"/>

                <Button x:Name="RenderSettingsToggleButton"
                        Content="Show Render Settings" FontSize="11" Margin="6,0,0,0"
                        Padding="8 2" VerticalAlignment="Center"
                        Click="RenderSettingsToggleButton_Click"/>
            </WrapPanel>
        </Border>

        <!-- Toolbar row 2: classifier-only toggles + Verbose Log -->
        <Border Grid.Row="1" Background="#FF2A2A2A" Padding="6 2" BorderBrush="#FF1A1A1A" BorderThickness="0,1,0,0">
            <WrapPanel Orientation="Horizontal">
                <CheckBox Content="Wireframe" FontSize="11" Foreground="#FF33E6D0"
                          Margin="10,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding ShowWireframe}"
                          Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"
                          ToolTip="Overlays the triangle edges of every loaded mesh. Used for key-vertex assignment in the BodySlide classifier workflow."/>

                <CheckBox Content="Pick Vertex" FontSize="11" Foreground="#FFFF6126"
                          Margin="10,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding IsKeyVertexPickMode}"
                          Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"
                          ToolTip="Left-click the model to drop a marker on the nearest triangle vertex. Intended for BodySlide classifier key-vertex assignment; camera orbit is disabled while this is on."/>

                <CheckBox Content="Pick Box" FontSize="11" Foreground="#FFFFCC40"
                          Margin="10,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding IsBoundingBoxPickMode}"
                          Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"
                          ToolTip="Left-drag a rectangle across the model to define a mesh-local bounding box. The classifier picks the vertex matching the selected Criterion inside that box at runtime, so the anatomical landmark tracks the mesh across presets."/>

                <TextBlock Text="Criterion:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,3,0"
                           Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"/>
                <!-- Criterion picker: closed button shows the short [ShortLabel] of the
                     current selection with its long [Description] as tooltip; clicking opens a
                     Popup containing a TreeView grouped by algorithm category (Axis Extremes /
                     Mirrored Across Midline / Waist Pinch / Hip Bulge / Paired / Centerline /
                     Mirror Shortcuts). Tree structure lives in BoxCriterionSelectionTree; per-leaf
                     labels and tooltips come from the enum attributes via reflection.
                     TreeView.Tag carries the route key ("Pending") that the code-behind handler
                     uses to dispatch the write — symmetric with the pending-box-confirm picker
                     below ("PendingFinal"). -->
                <Grid Width="180" VerticalAlignment="Center"
                      Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}">
                    <ToggleButton x:Name="CritToggleBBPick" FontSize="10"
                                  Content="{Binding PendingBoxCriterion, Converter={StaticResource EnumShortLabel}}"
                                  ToolTip="{Binding PendingBoxCriterion, Converter={StaticResource EnumDesc}}"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Center"
                                  Padding="4,1"/>
                    <Popup IsOpen="{Binding IsChecked, ElementName=CritToggleBBPick, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=CritToggleBBPick}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Background="#FF2A2A2A" BorderBrush="Gray" BorderThickness="1" Padding="4">
                            <TreeView ItemsSource="{x:Static cvr:BoxCriterionSelectionTree.Categories}"
                                      Tag="Pending"
                                      SelectedItemChanged="BoxCriterionSelectionTree_SelectedItemChanged"
                                      MinWidth="400" MaxHeight="520"
                                      Background="Transparent" BorderThickness="0">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type cvr:BoxCriterionSelectionCategory}"
                                                              ItemsSource="{Binding Children}">
                                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                                                   ToolTip="{Binding Description}" TextWrapping="NoWrap"/>
                                    </HierarchicalDataTemplate>
                                    <DataTemplate DataType="{x:Type cvr:BoxCriterionSelectionLeaf}">
                                        <TextBlock Text="{Binding Label}" ToolTip="{Binding Description}" TextWrapping="NoWrap"/>
                                    </DataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                        </Border>
                    </Popup>
                </Grid>

                <Button Content="Select Mirror" FontSize="10" Margin="6,0,0,0"
                        Padding="6 1" VerticalAlignment="Center"
                        Click="SelectMirrorPicksButton_Click"
                        Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"
                        ToolTip="For each current pick marker, adds the vertex closest to its X-mirror on the same mesh. Use to fill in bilaterally symmetric counterparts after picking one side."/>

                <TextBlock Text="Axis:" Foreground="#FFAAAAAA" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,3,0"
                           Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"/>
                <ComboBox Width="42" FontSize="10" VerticalAlignment="Center"
                          SelectedIndex="{Binding ProjectAcrossAxisIndex}"
                          Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"
                          ToolTip="Axis used by 'Pair Across Axis': X = left-right, Y = up-down, Z = front-back.">
                    <ComboBoxItem Content="X"/>
                    <ComboBoxItem Content="Y"/>
                    <ComboBoxItem Content="Z"/>
                </ComboBox>

                <Button Content="Pair Across Axis" FontSize="10" Margin="4,0,0,0"
                        Padding="6 1" VerticalAlignment="Center"
                        Click="PairAcrossAxisButton_Click"
                        Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"
                        ToolTip="From the most recent pick, casts a ray through the body along the selected axis and adds a marker at the vertex nearest the opposite-surface exit. Use to pair midline anchors (e.g., NippleFront → UpperSpineBack) at a matching cross-axis coordinate."/>

                <Button Content="Clear Picks" FontSize="10" Margin="6,0,0,0"
                        Padding="6 1" VerticalAlignment="Center"
                        Click="ClearKeyVertexMarkersButton_Click"
                        Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"
                        ToolTip="Removes every picked-vertex marker from the viewport."/>

                <CheckBox Content="Show Bulge Bins" FontSize="11" Foreground="#FF66E6FF"
                          Margin="10,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding ShowBulgeBinOverlay}"
                          Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}"
                          ToolTip="Draws the per-Y-bin paired-X optima used by the BulgePair*X / PinchPair*X criteria. Each occupied slice gets one horizontal line from its min-X vertex to its max-X vertex. The winner bin (largest width for Bulge, smallest for Pinch) draws in cyan; the rest in white. Targets the pending box if one is open, else the selected KeyVertex row's box. Only renders for paired criteria."/>

                <CheckBox Content="Verbose Log" FontSize="11" Foreground="#FFAAAAAA"
                          Margin="15,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding VerboseLog}"
                          ToolTip="Routes the viewer's informational diagnostics (GL init, NPC load, lighting, weight morphs, texture overrides, etc.) to the Status Log. Errors are always logged. Off by default so the classifier's own trace isn't buried in viewer chatter."/>

                <Button Content="Log Settings" FontSize="10" Margin="10,0,0,0"
                        Padding="6 1" VerticalAlignment="Center"
                        Click="LogLightingButton_Click"/>
            </WrapPanel>
        </Border>

        <!-- Toolbar row 3: shared lighting panel (presets / ambient / per-light editor).
             Collapsed by default; toggled from LightSettingsToggleButton above. -->
        <cvrv:UC_CharacterViewerLightingPanel x:Name="LightingPanel"
                                              Grid.Row="2"
                                              Visibility="Collapsed"/>

        <!-- Toolbar row 4: shared render-pipeline panel (tone-mapping / shadows / SSAO /
             SSS / vignette / wireframe-missing-tex). Collapsed by default; toggled from
             RenderSettingsToggleButton above. -->
        <cvrv:UC_CharacterViewerRenderPanel x:Name="RenderPanel"
                                            Grid.Row="3"
                                            Visibility="Collapsed"/>

        <!-- Body .tri missing warning: shown when a BodySlide/BodyGen deform was
             attempted but no sibling .tri was found next to the worn body NIF.
             Prompts the user to run BodySlide's "Build Morphs" on their preset. -->
        <Border Grid.Row="4"
                Background="#FF2A0A0A"
                BorderBrush="#FFAA2222"
                BorderThickness="0,1,0,1"
                Padding="8 4"
                Visibility="{Binding BodyTriMissing, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Body .tri file not found - did you forget to generate a Zeroed Sliders body with morphs?"
                       Foreground="#FFFF4444"
                       FontSize="12"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Pick info panel: compact readout of vertex picks for classifier authoring.
             Collapses entirely when classifier controls are off so the viewport is unaffected. -->
        <Border Grid.Row="5"
                Background="#FF1F1F1F"
                BorderBrush="#FF3A3A3A"
                BorderThickness="0,1,0,1"
                Padding="6 4"
                Visibility="{Binding ShowClassifierControls, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="Last pick:" Foreground="#FFAAAAAA" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding LastPickSummary}"
                                   Foreground="#FFFF6126" FontSize="11" FontFamily="Consolas"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="(no picks)"
                                   Foreground="#FF666666" FontSize="11" FontStyle="Italic"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Picks.Count, Converter={StaticResource IntEqVis}, ConverterParameter=0}"/>
                    </WrapPanel>

                    <ListBox x:Name="PicksList"
                             ItemsSource="{Binding Picks}"
                             SelectionMode="Extended"
                             SelectionChanged="PicksList_SelectionChanged"
                             MaxHeight="110" Margin="0,3,0,0"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#FFCCCCCC"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ToolTip="Click a row to select a pick. Ctrl/Shift-click for multi-select. 'Select Mirror' acts on the selected rows (or the most recent pick if nothing is selected).">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"
                                           FontSize="11"
                                           FontFamily="Consolas"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Copy TSV"
                        FontSize="10" Padding="8 2"
                        VerticalAlignment="Top" Margin="8,0,0,0"
                        Command="{Binding CopyPicksToClipboardCommand}"
                        ToolTip="Copy all picks to the clipboard as tab-separated values (shape, index, x, y, z). Paste the result back to share pick data."/>
            </Grid>
        </Border>

        <!-- OpenGL Viewport -->
        <glWpf:GLWpfControl
            Grid.Row="6"
            x:Name="GlControl"
            Render="GlControl_OnRender"/>

        <!-- Rubber-band overlay for BB-pick drag. IsHitTestVisible=False so clicks continue
             to hit GlControl beneath. Codebehind positions BoxSelectionRect via
             Canvas.Left/Top/Width/Height and flips Visibility during drag. -->
        <Canvas Grid.Row="6" IsHitTestVisible="False" ClipToBounds="True">
            <Rectangle x:Name="BoxSelectionRect"
                       Visibility="Collapsed"
                       Stroke="#FFFFCC40"
                       StrokeThickness="1"
                       StrokeDashArray="3 2"
                       Fill="#30FFCC40"/>
        </Canvas>

        <!-- Pending-box 3D wireframe overlay. Canvas is populated with 12 Line children from
             codebehind (one per AABB edge); UpdateBoxWireframe projects the 8 corners through
             view*projection each GL frame. Visibility follows HasPendingBox. -->
        <Canvas Grid.Row="6" x:Name="BoxWireframeCanvas"
                IsHitTestVisible="False" ClipToBounds="True"
                Visibility="{Binding HasPendingBox, Converter={StaticResource BoolToVis}}"/>

        <!-- Pending-box edit panel. Floats at top of the viewport while HasPendingBox is true.
             Six SingleUpDowns drive PendingBox{Min,Max}{X,Y,Z}; the wireframe redraws live.
             'Shrink to Camera Half' auto-halves the most-view-aligned axis toward the camera
             (use to carve an overhanging belly from a hip box). Confirm fires the usual
             AnyKeyVertexBoxPicked event; Confirm as Duplicate fires it but leaves the box
             pending so a follow-up confirm with a different criterion reuses the same AABB;
             Cancel discards. -->
        <Border Grid.Row="6"
                VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Background="#E01F1F1F" BorderBrush="#FFFFCC40" BorderThickness="0,0,0,2"
                Padding="8 5"
                Visibility="{Binding HasPendingBox, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Vertical">
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="Pending Box:" Foreground="#FFFFCC40" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PendingBoxShapeName}" Foreground="#FFDDDDDD" FontSize="11"
                               FontFamily="Consolas" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    <TextBlock Text="Criterion:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="15,0,4,0"/>
                    <!-- Editable while the box is pending so the user can change the algorithm
                         after drawing without cancelling/re-drawing. ConfirmPendingBox reads
                         PendingBoxFinalCriterion, so whatever is selected here is what fires. -->
                    <!-- Same picker as the BB-pick toolbar above; routes to PendingBoxFinalCriterion
                         instead of PendingBoxCriterion via TreeView.Tag = "PendingFinal". -->
                    <Grid MinWidth="180" VerticalAlignment="Center">
                        <ToggleButton x:Name="CritTogglePendingFinal" FontSize="11"
                                      Content="{Binding PendingBoxFinalCriterion, Converter={StaticResource EnumShortLabel}}"
                                      ToolTip="{Binding PendingBoxFinalCriterion, Converter={StaticResource EnumDesc}}"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Center"
                                      Padding="4,1"/>
                        <Popup IsOpen="{Binding IsChecked, ElementName=CritTogglePendingFinal, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=CritTogglePendingFinal}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Background="#FF2A2A2A" BorderBrush="Gray" BorderThickness="1" Padding="4">
                                <TreeView ItemsSource="{x:Static cvr:BoxCriterionSelectionTree.Categories}"
                                          Tag="PendingFinal"
                                          SelectedItemChanged="BoxCriterionSelectionTree_SelectedItemChanged"
                                          MinWidth="400" MaxHeight="520"
                                          Background="Transparent" BorderThickness="0">
                                    <TreeView.Resources>
                                        <HierarchicalDataTemplate DataType="{x:Type cvr:BoxCriterionSelectionCategory}"
                                                                  ItemsSource="{Binding Children}">
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                                                       ToolTip="{Binding Description}" TextWrapping="NoWrap"/>
                                        </HierarchicalDataTemplate>
                                        <DataTemplate DataType="{x:Type cvr:BoxCriterionSelectionLeaf}">
                                            <TextBlock Text="{Binding Label}" ToolTip="{Binding Description}" TextWrapping="NoWrap"/>
                                        </DataTemplate>
                                    </TreeView.Resources>
                                </TreeView>
                            </Border>
                        </Popup>
                    </Grid>
                    <!-- Symmetry lock: each flag mirrors min<->max about 0 on that axis.
                         Auto-seeded on capture when the drawn box straddles an axis within 10%.
                         ToolTip lists the combinations; enum ToString formats "X, Y" etc. -->
                    <TextBlock Text="Force Symmetry:" Foreground="#FFAAAAAA" FontSize="11"
                               VerticalAlignment="Center" Margin="15,0,4,0"/>
                    <ComboBox ItemsSource="{Binding Source={x:Static cvr:VM_CharacterViewer.SymmetryAxesChoices}}"
                              SelectedItem="{Binding PendingBoxSymmetry}"
                              FontSize="11" MinWidth="90" VerticalAlignment="Center"
                              ToolTip="Lock one or more axes so editing min/max on that axis auto-mirrors the opposite side about 0."/>
                </WrapPanel>

                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="X (L-R):" Foreground="#FFEB5757" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <xctk:SingleUpDown Value="{Binding PendingBoxMinX}"
                                       Foreground="White"
                                       FormatString="F1" Increment="0.5" Width="62"/>
                    <TextBlock Text="to" Foreground="#FF888888" FontSize="11"
                               VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <xctk:SingleUpDown Value="{Binding PendingBoxMaxX}"
                                       Foreground="White"
                                       FormatString="F1" Increment="0.5" Width="62"/>

                    <TextBlock Text="Y (U-D):" Foreground="#FF57EB57" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="14,0,4,0"/>
                    <xctk:SingleUpDown Value="{Binding PendingBoxMinY}"
                                       Foreground="White"
                                       FormatString="F1" Increment="0.5" Width="62"/>
                    <TextBlock Text="to" Foreground="#FF888888" FontSize="11"
                               VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <xctk:SingleUpDown Value="{Binding PendingBoxMaxY}"
                                       Foreground="White"
                                       FormatString="F1" Increment="0.5" Width="62"/>

                    <TextBlock Text="Z (F-B):" Foreground="#FF57A0EB" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="14,0,4,0"/>
                    <xctk:SingleUpDown Value="{Binding PendingBoxMinZ}"
                                       Foreground="White"
                                       FormatString="F1" Increment="0.5" Width="62"/>
                    <TextBlock Text="to" Foreground="#FF888888" FontSize="11"
                               VerticalAlignment="Center" Margin="4,0,4,0"/>
                    <xctk:SingleUpDown Value="{Binding PendingBoxMaxZ}"
                                       Foreground="White"
                                       FormatString="F1" Increment="0.5" Width="62"/>
                </WrapPanel>

                <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Shrink to Camera Half"
                            Command="{Binding ShrinkAlongViewAxisCommand}"
                            FontSize="11" Padding="8 2" Margin="0,0,0,2"
                            ToolTip="Halve the pending box along whichever mesh-local axis most aligns with the camera view, keeping the half nearest the camera. Repeat-click to shrink further. Use to exclude an overhanging belly from a hip box, etc."/>
                    <Button Content="Confirm"
                            Command="{Binding ConfirmPendingBoxCommand}"
                            FontSize="11" FontWeight="Bold" Padding="14 2" Margin="12,0,0,2"
                            Background="#FF2E7D32" Foreground="White"/>
                    <Button Content="Confirm as Duplicate"
                            Command="{Binding ConfirmPendingBoxAsDuplicateCommand}"
                            FontSize="11" FontWeight="Bold" Padding="10 2" Margin="6,0,0,2"
                            Background="#FF1565C0" Foreground="White"
                            ToolTip="Fire the pick now but keep this box on screen so you can change the Criterion and confirm again. Use to capture multiple measurements (e.g. MaxX and BulgePairMinX) from one drawn box."/>
                    <Button Content="Confirm as Region"
                            Command="{Binding ConfirmPendingBoxAsRegionCommand}"
                            FontSize="11" FontWeight="Bold" Padding="10 2" Margin="6,0,0,2"
                            Background="#FF00838F" Foreground="White"
                            ToolTip="Commit this box as a RegionVolume region instead of a key vertex. The box selects a body patch whose enclosed volume a RegionVolume measurement integrates (chest fullness, thigh volume). Appears as a new row on the profile's Regions tab; the criterion is ignored for regions."/>
                    <Button Content="Cancel"
                            Command="{Binding CancelPendingBoxCommand}"
                            FontSize="11" Padding="10 2" Margin="6,0,0,2"
                            Background="#FF8B2525" Foreground="White"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Axis orientation gizmo. Only the inner Border is hit-testable (Canvas has no
             background), so empty areas pass clicks through to GlControl. Codebehind
             rebuilds the three line/label positions each GL frame from the camera's view
             matrix; dragging the Border moves the widget via Canvas.Left/Top. -->
        <Canvas Grid.Row="6" x:Name="GizmoCanvas" ClipToBounds="True">
            <Border x:Name="AxisGizmoBorder"
                    Canvas.Left="10"
                    Width="80" Height="80"
                    Background="#80101010"
                    BorderBrush="#80A0A0A0" BorderThickness="1"
                    CornerRadius="4"
                    Cursor="SizeAll"
                    ToolTip="World-axis orientation gizmo. Drag to reposition."
                    MouseLeftButtonDown="AxisGizmo_MouseLeftButtonDown"
                    MouseLeftButtonUp="AxisGizmo_MouseLeftButtonUp"
                    MouseMove="AxisGizmo_MouseMove">
                <Canvas>
                    <Ellipse Canvas.Left="37" Canvas.Top="37" Width="6" Height="6" Fill="#FFCCCCCC"/>
                    <Line x:Name="AxisX_Line" Stroke="#FFEB5757" StrokeThickness="2" StrokeEndLineCap="Round"/>
                    <Line x:Name="AxisY_Line" Stroke="#FF57EB57" StrokeThickness="2" StrokeEndLineCap="Round"/>
                    <Line x:Name="AxisZ_Line" Stroke="#FF57A0EB" StrokeThickness="2" StrokeEndLineCap="Round"/>
                    <TextBlock x:Name="AxisX_Label" Text="X" Foreground="#FFEB5757" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="AxisY_Label" Text="Y" Foreground="#FF57EB57" FontSize="11" FontWeight="Bold"/>
                    <TextBlock x:Name="AxisZ_Label" Text="Z" Foreground="#FF57A0EB" FontSize="11" FontWeight="Bold"/>
                </Canvas>
            </Border>
        </Canvas>

        <!-- Loading overlay -->
        <Border Grid.Row="6"
                Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <TextBlock Text="Loading..."
                       Foreground="White"
                       FontSize="18"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="7"
                Background="#FF333333"
                Padding="6 3">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="#FFCCCCCC"
                       FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
