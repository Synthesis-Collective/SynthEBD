<UserControl x:Class="SynthEBD.UC_NPCAttributeShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:local="clr-namespace:SynthEBD"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             d:DataContext="{d:DesignInstance Type=local:VM_NPCAttributeShell}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <!-- https://github.com/xceedsoftware/wpftoolkit -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertableBooleanToVisibilityConverter x:Key="InvBoolToVis" />
    </UserControl.Resources>

    <!-- One AND-row of its parent card: [is / is not] [type] [value editor] [force mode + weight] [remove]. -->
    <StackPanel>
        <TextBlock FontWeight="Bold" FontSize="10" Margin="2 2 0 0" Foreground="{DynamicResource HintForeground}"
                   Visibility="{Binding IsFirstInAndList, Converter={StaticResource InvBoolToVis}, ConverterParameter=Inverted}"
                   local:DocTooltip.Key="Attributes.AndSeparator">AND</TextBlock>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <ToggleButton Grid.Column="0" IsChecked="{Binding Not}" MinWidth="42" VerticalAlignment="Top" Margin="0 2 4 0"
                          local:DocTooltip.Key="Attributes.IsIsNot">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                        <Setter Property="Content" Value="is"/>
                        <Setter Property="Foreground" Value="{DynamicResource ActionGoodForeground}"/>
                        <Style.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Content" Value="is not"/>
                                <Setter Property="Foreground" Value="{DynamicResource ActionDangerForeground}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>

            <ComboBox Grid.Column="1" MinWidth="95" VerticalAlignment="Top" Margin="0 2 0 0"
                      SelectedValue="{Binding Type}"
                      ItemsSource="{Binding Source={local:EnumBindingSource {x:Type local:NPCAttributeType}}}"
                      local:DocTooltip.Key="Attributes.ConditionType">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="SelectionChanged">
                        <i:InvokeCommandAction Command="{Binding ChangeType}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </ComboBox>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="MaxHeight" Value="220"/>
                        <Style.Triggers>
                            <!-- A nested sub-expression is a whole rule block; capping it to the flat-row
                                 height would force scrolling inside scrolling. Let it size to content. -->
                            <DataTrigger Binding="{Binding Type}" Value="SubExpression">
                                <Setter Property="MaxHeight" Value="4000"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ContentPresenter Content="{Binding Attribute}" Margin="10 0 0 0">
                    <ContentPresenter.Resources>
                        <DataTemplate DataType="{x:Type local:VM_NPCAttributeClass}">
                            <local:UC_NPCAttributeClass/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type local:VM_NPCAttributeCustom}">
                            <local:UC_NPCAttributeCustom/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type local:VM_NPCAttributeFaceTexture}">
                            <local:UC_NPCAttributeFaceTexture/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type local:VM_NPCAttributeFactions}">
                            <local:UC_NPCAttributeFactions/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type local:VM_NPCAttributeKeyword}">
                            <local:UC_NPCAttributeKeyword/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type local:VM_NPCAttributeMisc}">
                            <local:UC_NPCAttributeMisc/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type local:VM_NPCAttributeMod}">
                            <local:UC_NPCAttributeMod/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type local:VM_NPCAttributeNPC}">
                            <local:UC_NPCAttributeNPC/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type local:VM_NPCAttributeRace}">
                            <local:UC_NPCAttributeRace/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type local:VM_NPCAttributeVoiceType}">
                            <local:UC_NPCAttributeVoiceType/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type local:VM_NPCAttributeGroup}">
                            <local:UC_NPCAttributeGroup/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type local:VM_NPCAttributeSubExpression}">
                            <local:UC_NPCAttributeSubExpression/>
                        </DataTemplate>
                    </ContentPresenter.Resources>
                </ContentPresenter>
            </ScrollViewer>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Margin="4 2 0 0">
                <ComboBox ItemsSource="{Binding Source={x:Static local:VM_NPCAttributeShell.ForceModeOptions}}" SelectedItem="{Binding ForceModeStr}"
                          Visibility="{Binding DisplayForceIfOption, Converter={StaticResource BoolToVis}}"
                          local:DocTooltip.Key="Attributes.ForceMode"/>
                <StackPanel Orientation="Horizontal" Visibility="{Binding DisplayForceIfWeight, Converter={StaticResource BoolToVis}}">
                    <TextBlock VerticalAlignment="Center" Margin="6 0 3 0" local:DocTooltip.Key="Attributes.ForceIfWeight">Weight</TextBlock>
                    <xctk:IntegerUpDown Value="{Binding ForceIfWeight}" MinWidth="40"/>
                </StackPanel>
            </StackPanel>

            <Button Grid.Column="4" VerticalAlignment="Top" Margin="6 2 0 0" Command="{Binding DeleteCommand}"
                    Foreground="{DynamicResource ActionDangerForeground}" ToolTip="Remove this row from the condition"
                    local:DocTooltip.Key="Attributes.RemoveRow">X</Button>
        </Grid>
    </StackPanel>
</UserControl>
