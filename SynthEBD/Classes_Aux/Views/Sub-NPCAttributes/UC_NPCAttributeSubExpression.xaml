<UserControl x:Class="SynthEBD.UC_NPCAttributeSubExpression"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SynthEBD"
             d:DataContext="{d:DesignInstance Type=local:VM_NPCAttributeSubExpression}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <local:IntEqualsToVisibilityConverter x:Key="IntEqualsToVis" />
    </UserControl.Resources>

    <!-- An inline parenthetical block: the row matches when ANY nested condition card matches.
         Renders the shared card view recursively, so sub-expressions nest to arbitrary depth. -->
    <Border BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}" CornerRadius="3" Padding="4" Margin="0 2 0 2">
        <StackPanel>
            <TextBlock FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                       local:DocTooltip.Key="Attributes.SubExpressionHeader">MATCHES IF ANY OF:</TextBlock>

            <ItemsControl ItemsSource="{Binding Attributes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:VM_NPCAttribute}">
                        <local:UC_NPCAttribute Background="{DynamicResource SecondaryBackground}" Margin="0 2 0 0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Only for the empty state; populated sub-expressions grow via their cards' own OR buttons. -->
            <Button HorizontalAlignment="Left" Margin="0 2 0 0" Command="{Binding AddCondition}" FontSize="11"
                    Foreground="{DynamicResource ActionGoodForeground}"
                    Visibility="{Binding Attributes.Count, Converter={StaticResource IntEqualsToVis}, ConverterParameter=0}"
                    local:DocTooltip.Key="Attributes.SubExpressionAddCondition">+ condition</Button>
        </StackPanel>
    </Border>
</UserControl>
