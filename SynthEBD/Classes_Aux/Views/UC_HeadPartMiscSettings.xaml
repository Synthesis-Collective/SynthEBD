<UserControl x:Class="SynthEBD.UC_HeadPartMiscSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SynthEBD"
             d:DataContext="{d:DesignInstance Type=local:VM_HeadPartMiscSettings}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <local:BodyGenVisibilityConverter x:Key="BGVisibilityConverter" />
        <local:UiModeToGridRowHeightConverter x:Key="UiModeRowHeight"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Progressive disclosure: SkyPatcher Mode stays at Use level (commonly
             requested); patching mode, conflict winners, bulk descriptor actions,
             and associated BodyGen configs are Customize; verbose scripts is
             Troubleshoot. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeRowHeight}, ConverterParameter=Customize}"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeRowHeight}, ConverterParameter=Customize}"/>
            <RowDefinition Height="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeRowHeight}, ConverterParameter=Customize}"/>
            <RowDefinition Height="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeRowHeight}, ConverterParameter=Troubleshoot}"/>
            <RowDefinition Height="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeRowHeight}, ConverterParameter=Customize}"/>
            <RowDefinition Height="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeRowHeight}, ConverterParameter=Customize}"/>
            <RowDefinition Height="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeRowHeight}, ConverterParameter=Customize}"/>
            <RowDefinition Height="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeRowHeight}, ConverterParameter=Customize}"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" local:DocTooltip.Key="HeadParts.PatchingMode">
            Headpart Patching Mode
        </TextBlock>

        <ComboBox Grid.Row="0" Grid.Column="2" SelectedItem="{Binding PatchingMode}" ItemsSource="{Binding PatchingModeOptions}" />

        <TextBlock Grid.Row="1" Grid.Column="0">SkyPatcher Mode</TextBlock>
        <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding bSkyPatcherModeHeadparts}"/>
        
        <TextBlock Grid.Row="2" Grid.Column="0">Assignment Conflict Winners</TextBlock>
        <TextBlock Grid.Row="2" Grid.Column="2">In cases where an Asset Pack wants to assign a head part, but the Head Part distributor wants to assign a different head part, which should win:</TextBlock>

        <ItemsControl Grid.Row="3" Grid.Column="2" ItemsSource="{Binding SourceConflictWinners}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Key}" VerticalAlignment="Center"/>
                        <ComboBox SelectedValue="{Binding Value.Source}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type local:HeadPartSourceCandidate}}}" Margin="5 0 0 0"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="4" Grid.Column="0">Use Verbose Scripts</TextBlock>
        <CheckBox Grid.Row="4" Grid.Column="2" IsChecked="{Binding bUseVerboseScripts}"/>

        <Button Grid.Row="5" Grid.Column="0" Command="{Binding SetAllowedDescriptorMatchModes}" VerticalAlignment="Center" Margin="0 0 5 0" Foreground="{DynamicResource ActionAccentForeground}">Set All Allowed BodyShape Descriptors To</Button>
        <ComboBox Grid.Row="5" Grid.Column="2" Width="auto" HorizontalAlignment="Left" VerticalAlignment="Center" SelectedValue="{Binding AllowedDescriptorMatchMode}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type local:DescriptorMatchMode}}}" IsSynchronizedWithCurrentItem="True"/>

        <Button Grid.Row="6" Grid.Column="0" Command="{Binding SetDisallowedDescriptorMatchModes}" VerticalAlignment="Center" Margin="0 0 5 0" Foreground="{DynamicResource ActionAccentForeground}">Set All Disallowed BodyShape Descriptors To</Button>
        <ComboBox Grid.Row="6" Grid.Column="2" Width="auto" HorizontalAlignment="Left" VerticalAlignment="Center" SelectedValue="{Binding DisallowedDescriptorMatchMode}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type local:DescriptorMatchMode}}}" IsSynchronizedWithCurrentItem="True"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" Visibility="{Binding ParentMenu.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" local:DocTooltip.Key="HeadParts.AssociatedBodyGenConfig">Associated Male BodyGen Configuration</TextBlock>
        <ComboBox Grid.Row="7" Grid.Column="2" ItemsSource="{Binding AvailableBodyGenConfigsMale}" DisplayMemberPath="Label" SelectedValue="{Binding TrackedBodyGenConfigMale}" Visibility="{Binding ParentMenu.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" Visibility="{Binding ParentMenu.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" local:DocTooltip.Key="HeadParts.AssociatedBodyGenConfig">Associated Female BodyGen Configuration</TextBlock>
        <ComboBox Grid.Row="8" Grid.Column="2" ItemsSource="{Binding AvailableBodyGenConfigsFemale}" DisplayMemberPath="Label" SelectedValue="{Binding TrackedBodyGenConfigFemale}" Visibility="{Binding ParentMenu.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}"/>
    </Grid>
</UserControl>
