<UserControl x:Class="SynthEBD.UC_HeadPart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SynthEBD"
             xmlns:plugins="clr-namespace:Mutagen.Bethesda.WPF.Plugins;assembly=Mutagen.Bethesda.WPF"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:VM_HeadPart}"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <local:BodyGenVisibilityConverter x:Key="BGVisibilityConverter" />
        <local:BodySlideVisibilityConverter x:Key="BSVisibilityConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" MinWidth="150" HorizontalAlignment="Left" Text="{Binding Path=StatusString, UpdateSourceTrigger=PropertyChanged}" Foreground="{Binding BorderColor}"></TextBlock>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center">Name</TextBlock>
            <TextBlock Background="Black" Grid.Row="1" Grid.Column="2" MinWidth="150" HorizontalAlignment="Left" Text="{Binding Path=Label, UpdateSourceTrigger=PropertyChanged}"></TextBlock>

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center">Gender</TextBlock>
            <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="2">
                <TextBlock Text="Male"/>
                <CheckBox IsChecked="{Binding bAllowMale}" Margin="5 0 5 0"/>
                <TextBlock Text="Female"/>
                <CheckBox IsChecked="{Binding bAllowFemale}" Margin="5 0 0 0"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="HeadParts.PartAllowedRaces">Allowed Races</TextBlock>
            <local:UC_NamedFormKeyMultiPicker MaxHeight="500" Grid.Row="3" Grid.Column="2" MinWidth="150" FormKeys="{Binding AllowedRaces}" LinkCache="{Binding lk}" ScopedTypes="{Binding RacePickerFormKeys}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="HeadParts.PartAllowedRaceGroupings">Allowed Race Groupings</TextBlock>
            <ContentPresenter Grid.Row="4" Grid.Column="2"  Content="{Binding AllowedRaceGroupings}">
                <ContentPresenter.Resources>
                    <DataTemplate DataType="{x:Type local:VM_RaceGroupingCheckboxList}">
                        <local:UC_RaceGroupingCheckboxList Background="Black" Margin="0 0 0 10"/>
                    </DataTemplate>
                </ContentPresenter.Resources>
            </ContentPresenter>

            <TextBlock Grid.Row="5" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="HeadParts.PartDisallowedRaces">Disallowed Races</TextBlock>
            <local:UC_NamedFormKeyMultiPicker MaxHeight="500" Grid.Row="5" Grid.Column="2" MinWidth="150" FormKeys="{Binding DisallowedRaces}" LinkCache="{Binding lk}" ScopedTypes="{Binding RacePickerFormKeys}" />

            <TextBlock Grid.Row="6" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="HeadParts.PartDisallowedRaceGroupings">Disallowed Race Groupings</TextBlock>
            <ContentPresenter Grid.Row="6" Grid.Column="2"  Content="{Binding DisallowedRaceGroupings}">
                <ContentPresenter.Resources>
                    <DataTemplate DataType="{x:Type local:VM_RaceGroupingCheckboxList}">
                        <local:UC_RaceGroupingCheckboxList Background="Black" Margin="0 0 0 10"/>
                    </DataTemplate>
                </ContentPresenter.Resources>
            </ContentPresenter>

            <TextBlock Grid.Row="7" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="HeadParts.PartAllowedAttributes">Allowed NPC Attributes</TextBlock>
            <Button Grid.Row="7" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding AddAllowedAttribute}" Foreground="Lightgreen">Add New</Button>
            <ItemsControl Grid.Row="7" Grid.Column="2" ItemsSource="{Binding AllowedAttributes}" BorderThickness="1" BorderBrush="#5844b4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:VM_NPCAttribute}">
                        <local:UC_NPCAttribute Background="Black" Margin="0 0 0 10"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="8" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="HeadParts.PartDisallowedAttributes">Disallowed NPC Attributes</TextBlock>
            <Button Grid.Row="8" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding AddDisallowedAttribute}" Foreground="Lightgreen">Add New</Button>
            <ItemsControl Grid.Row="8" Grid.Column="2" ItemsSource="{Binding DisallowedAttributes}" BorderThickness="1" BorderBrush="#5844b4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:VM_NPCAttribute}">
                        <local:UC_NPCAttribute Background="Black" Margin="0 0 0 10"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Grid.Row="9" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="HeadParts.PartWeightRange">Allowed NPC Weight Range</TextBlock>
            <StackPanel Grid.Row="9" Grid.Column="2" Orientation="Horizontal">
                <TextBox MinWidth="50" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding Path=WeightRange.Lower}"/>
                <TextBlock Text="to" Margin="15 0 15 0" VerticalAlignment="Center"/>
                <TextBox MinWidth="50" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding Path=WeightRange.Upper}"/>
            </StackPanel>

            <TextBlock Grid.Row="10" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="HeadParts.PartDistributeToNonForced">Distribute to non-forced NPCs</TextBlock>
            <CheckBox Grid.Row="10" Grid.Column="2" IsChecked="{Binding Path=bAllowRandom, Mode=TwoWay}"></CheckBox>

            <TextBlock Grid.Row="11" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="HeadParts.PartAllowUnique">Allow Unique NPCs</TextBlock>
            <CheckBox Grid.Row="11" Grid.Column="2" IsChecked="{Binding Path=bAllowUnique, Mode=TwoWay}"></CheckBox>

            <TextBlock Grid.Row="12" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="HeadParts.PartAllowNonUnique">Allow Non-Unique NPCs</TextBlock>
            <CheckBox Grid.Row="12" Grid.Column="2" IsChecked="{Binding Path=bAllowNonUnique, Mode=TwoWay}"></CheckBox>

            <TextBlock Grid.Row="13" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="HeadParts.PartProbabilityWeighting"> Distribution Probability Weighting</TextBlock>
            <TextBox Grid.Row="13" Grid.Column="2" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding Path=ProbabilityWeighting}"/>

            <!--OBody-->
            <TextBlock Grid.Row="14" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" Visibility="{Binding ParentMenu.BodyShapeMode, Converter={StaticResource BSVisibilityConverter}}" local:DocTooltip.Key="HeadParts.PartAllowedBodySlideDescriptors">Allowed BodySlide Descriptors</TextBlock>
            <local:UC_BodyShapeDescriptorSelectionMenu Grid.Row="14" Grid.Column="2"  Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.ParentMenu.BodyShapeMode, Converter={StaticResource BSVisibilityConverter}}" DataContext="{Binding AllowedBodySlideDescriptors}"/>

            <TextBlock Grid.Row="15" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" Visibility="{Binding ParentMenu.BodyShapeMode, Converter={StaticResource BSVisibilityConverter}}" local:DocTooltip.Key="HeadParts.PartDisallowedBodySlideDescriptors">Disallowed BodySlide Descriptors</TextBlock>
            <local:UC_BodyShapeDescriptorSelectionMenu Grid.Row="15" Grid.Column="2"  Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.ParentMenu.BodyShapeMode, Converter={StaticResource BSVisibilityConverter}}" DataContext="{Binding DisallowedBodySlideDescriptors}"/>

            <!--BodyGen-->
            <TextBlock Grid.Row="14" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" Visibility="{Binding ParentMenu.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" local:DocTooltip.Key="HeadParts.PartAllowedBodyGenDescriptors">Allowed Male BodyGen Descriptors</TextBlock>
            <local:UC_BodyShapeDescriptorSelectionMenu Grid.Row="14" Grid.Column="2" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.ParentMenu.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" DataContext="{Binding AllowedBodyGenDescriptorsMale}"/>

            <TextBlock Grid.Row="15" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" Visibility="{Binding ParentMenu.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" local:DocTooltip.Key="HeadParts.PartDisallowedBodyGenDescriptors">Disallowed Male BodyGen Descriptors</TextBlock>
            <local:UC_BodyShapeDescriptorSelectionMenu Grid.Row="15" Grid.Column="2"  Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.ParentMenu.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" DataContext="{Binding DisallowedBodyGenDescriptorsMale}" />

            <TextBlock Grid.Row="16" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" Visibility="{Binding ParentMenu.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" local:DocTooltip.Key="HeadParts.PartAllowedBodyGenDescriptors">Allowed Female BodyGen Descriptors</TextBlock>
            <local:UC_BodyShapeDescriptorSelectionMenu Grid.Row="16" Grid.Column="2" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.ParentMenu.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" DataContext="{Binding AllowedBodyGenDescriptorsFemale}"/>

            <TextBlock Grid.Row="17" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" Visibility="{Binding ParentMenu.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" local:DocTooltip.Key="HeadParts.PartDisallowedBodyGenDescriptors">Disallowed Female BodyGen Descriptors</TextBlock>
            <local:UC_BodyShapeDescriptorSelectionMenu Grid.Row="17" Grid.Column="2"  Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.ParentMenu.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" DataContext="{Binding DisallowedBodyGenDescriptorsFemale}" />

            <TextBlock Grid.Row="18" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="HeadParts.PartProbabilityModifiers">Probability Modifiers</TextBlock>
            <Button Grid.Row="18" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding AddProbabilityWeightModifier}" Foreground="Lightgreen">Add New</Button>
            <ItemsControl Grid.Row="18" Grid.Column="2" ItemsSource="{Binding ProbabilityWeightModifiers}" BorderThickness="1" BorderBrush="#5844b4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:VM_AttributeWeightModifier}">
                        <local:UC_AttributeWeightModifier Background="Black" Margin="0 0 0 10"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Grid.Row="19" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left" Command="{Binding DeleteMe}" local:DocTooltip.Key="HeadParts.DeletePart">Delete Head Part</Button>
        </Grid>
    </ScrollViewer>
</UserControl>
