<UserControl x:Class="SynthEBD.UC_Subgroup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SynthEBD"
             xmlns:plugins="clr-namespace:Mutagen.Bethesda.WPF.Plugins;assembly=Mutagen.Bethesda.WPF"
             xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
             d:DataContext="{d:DesignInstance Type=local:VM_Subgroup}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <local:BodyGenVisibilityConverter x:Key="BGVisibilityConverter" />
        <local:BodySlideVisibilityConverter x:Key="BSVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" MinWidth="215"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="Subgroup.ID">ID</TextBlock>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
            <TextBox  MinWidth="150" HorizontalAlignment="Left" Text="{Binding Path=ID, UpdateSourceTrigger=PropertyChanged}"/>
            <Button VerticalAlignment="Center" HorizontalAlignment="Left" Command="{Binding AutoGenerateIDcommand}" Foreground="{DynamicResource ActionAccentForeground}" local:DocTooltip.Key="Subgroup.AutoGenerateID">AutoGen</Button>
            <StackPanel Orientation="Horizontal" Margin="5 0 0 0">
                <TextBlock Text="(" VerticalAlignment="Center" />
                <Button VerticalAlignment="Center" HorizontalAlignment="Left" Command="{Binding AutoGenerateID_Children_Command}" Foreground="{DynamicResource ActionAccentForeground}" local:DocTooltip.Key="Subgroup.AutoGenerateIDChildren">Subs</Button>
                <TextBlock Text=") (" VerticalAlignment="Center"/>
                <Button VerticalAlignment="Center" HorizontalAlignment="Left" Command="{Binding AutoGenerateID_All_Command}" Foreground="ForestGreen" local:DocTooltip.Key="Subgroup.AutoGenerateIDAll">All</Button>
                <TextBlock Text=")" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
        
        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="Subgroup.Name">Name</TextBlock>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
            <TextBox MinWidth="150" HorizontalAlignment="Left" Text="{Binding Path=Name, UpdateSourceTrigger=PropertyChanged}"/>
            <Button VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5 0 0 0" Command="{Binding ToggleBulkRenameVisibility}" Foreground="{DynamicResource ActionAccentForeground}" local:DocTooltip.Key="Subgroup.BatchRename">Batch Rename</Button>
            <TextBlock Text="From: " VerticalAlignment="Center" Margin="5 0 0 0" Visibility="{Binding RenameVisible, Converter={StaticResource BoolToVis}}"/>
            <TextBox MinWidth="50" HorizontalAlignment="Left" Margin="5 0 0 0" Text="{Binding Path=RenameFrom, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding RenameVisible, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="To: " VerticalAlignment="Center" Margin="5 0 0 0" Visibility="{Binding RenameVisible, Converter={StaticResource BoolToVis}}"/>
            <TextBox MinWidth="50" HorizontalAlignment="Left" Margin="5 0 0 0" Text="{Binding Path=RenameTo, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding RenameVisible, Converter={StaticResource BoolToVis}}"/>
            <Button VerticalAlignment="Center" HorizontalAlignment="Left" Margin="5 0 0 0" Command="{Binding ApplyBulkRename}" Foreground="{DynamicResource ActionAccentForeground}" local:DocTooltip.Key="Subgroup.BatchRenameApply" Visibility="{Binding RenameVisible, Converter={StaticResource BoolToVis}}">Apply</Button>
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="Subgroup.Notes">Notes</TextBlock>
        <TextBox Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Visible" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxHeight="50"/>
        
        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="Subgroup.Enabled">Subgroup Distribution Enabled</TextBlock>
        <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding Path=Enabled, Mode=TwoWay}"></CheckBox>

        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="Subgroup.DistributionEnabled">Distribute to non-forced NPCs</TextBlock>
        <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding Path=DistributionEnabled, Mode=TwoWay}"></CheckBox>

        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="Subgroup.AllowUnique">Allow Unique NPCs</TextBlock>
        <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding Path=AllowUnique, Mode=TwoWay}"></CheckBox>

        <TextBlock Grid.Row="6" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="Subgroup.AllowNonUnique">Allow Non-Unique NPCs</TextBlock>
        <CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding Path=AllowNonUnique, Mode=TwoWay}"></CheckBox>

        <TextBlock Grid.Row="7" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="Subgroup.ProbabilityWeighting">Distribution Probability Weighting</TextBlock>
        <TextBox Grid.Row="7" Grid.Column="1" MinWidth="150" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding Path=ProbabilityWeighting}"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="Subgroup.AllowedRaces">Allowed Races</TextBlock>
        <local:UC_NamedFormKeyMultiPicker Grid.Row="8" Grid.Column="1" MaxHeight="500" MinWidth="150" FormKeys="{Binding AllowedRaces}" LinkCache="{Binding LinkCache}" ScopedTypes="{Binding RacePickerFormKeys}" />

        <TextBlock Grid.Row="9" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="Subgroup.AllowedRaceGroupings">Allowed Race Groupings</TextBlock>
        <ContentPresenter Grid.Row="9" Grid.Column="1"  Content="{Binding AllowedRaceGroupings}">
            <ContentPresenter.Resources>
                <DataTemplate DataType="{x:Type local:VM_RaceGroupingCheckboxList}">
                    <local:UC_RaceGroupingCheckboxList Background="{DynamicResource SecondaryBackground}" Margin="0 0 0 10"/>
                </DataTemplate>
            </ContentPresenter.Resources>
        </ContentPresenter>

        <TextBlock Grid.Row="10" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="Subgroup.DisallowedRaces">Disallowed Races</TextBlock>
        <local:UC_NamedFormKeyMultiPicker Grid.Row="10" Grid.Column="1" MaxHeight="500" MinWidth="150" FormKeys="{Binding DisallowedRaces}" LinkCache="{Binding LinkCache}" ScopedTypes="{Binding RacePickerFormKeys}" />

        <TextBlock Grid.Row="11" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="Subgroup.DisallowedRaceGroupings">Disallowed Race Groupings</TextBlock>
        <ContentPresenter Grid.Row="11" Grid.Column="1"  Content="{Binding DisallowedRaceGroupings}">
            <ContentPresenter.Resources>
                <DataTemplate DataType="{x:Type local:VM_RaceGroupingCheckboxList}">
                    <local:UC_RaceGroupingCheckboxList Background="{DynamicResource SecondaryBackground}" Margin="0 0 0 10"/>
                </DataTemplate>
            </ContentPresenter.Resources>
        </ContentPresenter>

        <TextBlock Grid.Row="12" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="Subgroup.AllowedAttributes">Allowed NPC Attributes</TextBlock>
        <Button Grid.Row="12" Grid.Column="0" Margin="0 0 10 0"  Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding AddAllowedAttribute}" Foreground="{DynamicResource ActionGoodForeground}">Add New</Button>

        <ItemsControl Grid.Row="12" Grid.Column="1" ItemsSource="{Binding AllowedAttributes}" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:VM_NPCAttribute}">
                    <local:UC_NPCAttribute Background="{DynamicResource SecondaryBackground}" Margin="0 0 0 10"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>


        <TextBlock Grid.Row="13" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="Subgroup.DisallowedAttributes">Disallowed NPC Attributes</TextBlock>
        <Button Grid.Row="13" Grid.Column="0" Margin="0 0 10 0"  Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding AddDisallowedAttribute}" Foreground="{DynamicResource ActionGoodForeground}">Add New</Button>
        <ItemsControl Grid.Row="13" Grid.Column="1" ItemsSource="{Binding DisallowedAttributes}" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:VM_NPCAttribute}">
                    <local:UC_NPCAttribute Background="{DynamicResource SecondaryBackground}" Margin="0 0 0 10"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="14" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="Subgroup.WeightRange">Allowed NPC Weight Range</TextBlock>
        <StackPanel Grid.Row="14" Grid.Column="1" Orientation="Horizontal">
            <TextBox MinWidth="50" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding Path=WeightRange.Lower}"/>
            <TextBlock Text="to" Margin="15 0 15 0" VerticalAlignment="Center"/>
            <TextBox MinWidth="50" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding Path=WeightRange.Upper}"/>
        </StackPanel>

        <TextBlock Grid.Row="15" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="Subgroup.RequiredSubgroups">Required Subgroups</TextBlock>

        <local:UC_PositionalSubgroupContainerCollection Grid.Row="15" Grid.Column="1" DataContext="{Binding RequiredSubgroups}" MinHeight="30" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"  dd:DragDrop.IsDropTarget="True" dd:DragDrop.DropHandler="{Binding}" AllowDrop="True"/>
        <Button Grid.Row="15" Grid.Column="0" Margin="0 0 10 0" Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding LinkRequiredSubgroups}" Foreground="{DynamicResource ActionGoodForeground}">Group Linker</Button>

        <TextBlock Grid.Row="16" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="Subgroup.ExcludedSubgroups">Excluded Subgroups</TextBlock>
        <local:UC_PositionalSubgroupContainerCollection Grid.Row="16" Grid.Column="1" DataContext="{Binding ExcludedSubgroups}" MinHeight="30" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"  dd:DragDrop.IsDropTarget="True" dd:DragDrop.DropHandler="{Binding}" AllowDrop="True"/>

        <TextBlock Grid.Row="17" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="Subgroup.AddKeywords">Add Keywords to NPC</TextBlock>
        <Button Grid.Row="17" Grid.Column="0" Margin="0 0 10 0"  Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding AddNPCKeyword}" Foreground="{DynamicResource ActionGoodForeground}">Add New</Button>
        <ListBox Grid.Row="17" Grid.Column="1" ItemsSource="{Binding AddKeywords}" IsSynchronizedWithCurrentItem="True" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBox MinWidth="150" Text="{Binding Mode=TwoWay, Path=Content, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Width="75" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left" Command="{Binding DeleteCommand}" Foreground="Firebrick">Remove</Button>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="18" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="Subgroup.AssetPaths">Asset Paths</TextBlock>
        <Button Grid.Row="18" Grid.Column="0" Margin="0 0 10 0"  Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding AddPath}" Foreground="{DynamicResource ActionGoodForeground}">Add New</Button>
        <local:UC_FilePathReplacementMenu Grid.Row="18" Grid.Column="1" DataContext="{Binding PathsMenu}"/>

        <!--BodyGen-->
        <TextBlock Grid.Row="19" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" Visibility="{Binding ParentAssetPack.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" local:DocTooltip.Key="Subgroup.AllowedBodyGenDescriptors">Allowed BodyGen Descriptors</TextBlock>
        <local:UC_BodyShapeDescriptorSelectionMenu Grid.Row="19" Grid.Column="1" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.ParentAssetPack.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" DataContext="{Binding AllowedBodyGenDescriptors}"/>

        <TextBlock Grid.Row="20" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" Visibility="{Binding ParentAssetPack.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" local:DocTooltip.Key="Subgroup.DisallowedBodyGenDescriptors">Disallowed BodyGen Descriptors</TextBlock>
        <local:UC_BodyShapeDescriptorSelectionMenu Grid.Row="20" Grid.Column="1"  Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.ParentAssetPack.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" DataContext="{Binding DisallowedBodyGenDescriptors}" />

        <!--OBody-->
        <TextBlock Grid.Row="19" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" Visibility="{Binding ParentAssetPack.BodyShapeMode, Converter={StaticResource BSVisibilityConverter}}" local:DocTooltip.Key="Subgroup.AllowedBodySlideDescriptors">Allowed BodySlide Descriptors</TextBlock>
        <local:UC_BodyShapeDescriptorSelectionMenu Grid.Row="19" Grid.Column="1"  Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.ParentAssetPack.BodyShapeMode, Converter={StaticResource BSVisibilityConverter}}" DataContext="{Binding AllowedBodySlideDescriptors}"/>

        <TextBlock Grid.Row="20" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" Visibility="{Binding ParentAssetPack.BodyShapeMode, Converter={StaticResource BSVisibilityConverter}}" local:DocTooltip.Key="Subgroup.DisallowedBodySlideDescriptors">Disallowed BodySlide Descriptors</TextBlock>
        <local:UC_BodyShapeDescriptorSelectionMenu Grid.Row="20" Grid.Column="1"  Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.ParentAssetPack.BodyShapeMode, Converter={StaticResource BSVisibilityConverter}}" DataContext="{Binding DisallowedBodySlideDescriptors}"/>

        <TextBlock Grid.Row="21" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" Visibility="{Binding ParentAssetPack.BodyShapeMode, Converter={StaticResource BSVisibilityConverter}}" local:DocTooltip.Key="Subgroup.PreferredBodySlideDescriptors">Preferred BodySlide Descriptors</TextBlock>
        <local:UC_BodyShapeDescriptorSelectionMenu Grid.Row="21" Grid.Column="1"  Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.ParentAssetPack.BodyShapeMode, Converter={StaticResource BSVisibilityConverter}}" DataContext="{Binding PrioritizedBodySlideDescriptors}"/>

        <TextBlock Grid.Row="22" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="Subgroup.ProbabilityModifiers">Probability Modifiers</TextBlock>
        <Button Grid.Row="22" Grid.Column="0" Margin="0 0 10 0" Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding AddProbabilityWeightModifier}" Foreground="{DynamicResource ActionGoodForeground}">Add New</Button>
        <ItemsControl Grid.Row="22" Grid.Column="1" ItemsSource="{Binding ProbabilityWeightModifiers}" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:VM_AttributeWeightModifier}">
                    <local:UC_AttributeWeightModifier Background="{DynamicResource SecondaryBackground}" Margin="0 0 0 10"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
