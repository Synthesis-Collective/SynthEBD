<UserControl x:Class="SynthEBD.UC_HeightConfig"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SynthEBD"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:plugins="clr-namespace:Mutagen.Bethesda.WPF.Plugins;assembly=Mutagen.Bethesda.WPF"
             d:DataContext="{d:DesignInstance Type=local:VM_HeightConfig}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <local:UiModeToVisibilityConverter x:Key="UiModeVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0 0 15 0">Configuration Name</TextBlock>
        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"></TextBox>
        <Button Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="10 0 0 0" Command="{Binding Save}" Foreground="{DynamicResource ActionAccentForeground}">Save</Button>

        <Button Grid.Row="1" Grid.Column="0"  VerticalAlignment="Center" HorizontalAlignment="Left" Command="{Binding AddHeightAssignment}" Foreground="{DynamicResource ActionGoodForeground}" Margin="0 15 0 0">Add Height Group</Button>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Margin="50 15 5 0">
            <Button  VerticalAlignment="Center" HorizontalAlignment="Left" Command="{Binding SetAllDistModes}" Margin="0 0 10 0">Set All Distribution Modes To </Button>
            <ComboBox ItemsSource="{Binding Source={local:EnumBindingSource {x:Type local:DistMode}}}" SelectedValue="{Binding Path=GlobalDistMode, Mode=TwoWay}" VerticalAlignment="Center" VerticalContentAlignment="Center"/>

            <!-- Layout preference: how many height-group tiles per row (Customize/Troubleshoot only).
                 Backed by VM_SettingsHeight.HeightGroupsPerRow on the parent UC_HeightSettings. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="30 0 0 0"
                        Visibility="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeVisibility}, ConverterParameter=Customize}">
                <TextBlock Text="Tiles Per Row" VerticalAlignment="Center" Margin="0 0 8 0" local:DocTooltip.Key="Height.GroupsPerRow"/>
                <xctk:IntegerUpDown Width="60" Minimum="1" Maximum="12" Increment="1"
                                    Value="{Binding DataContext.HeightGroupsPerRow, RelativeSource={RelativeSource AncestorType={x:Type local:UC_HeightSettings}}, Mode=TwoWay}"
                                    local:DocTooltip.Key="Height.GroupsPerRow"/>
            </StackPanel>
        </StackPanel>

        <ItemsControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" ItemsSource="{Binding HeightAssignments}" Margin="20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- Uniform-width tiles, N columns from the Tiles Per Row control on UC_HeightSettings. -->
                    <UniformGrid Columns="{Binding DataContext.HeightGroupsPerRow, RelativeSource={RelativeSource AncestorType={x:Type local:UC_HeightSettings}}}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource SecondaryBackground}" Margin="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" local:DocTooltip.Key="Height.GroupName">Height Group</TextBlock>
                            <TextBox Grid.Row="0" Grid.Column="1" MinWidth="150" TextAlignment="Left" Text="{Binding Path=Label, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button  Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Command="{Binding DeleteCommand}" Foreground="Firebrick">X</Button>

                            <TextBlock Grid.Row="1" Grid.Column="0" local:DocTooltip.Key="Height.GroupRaces">Races</TextBlock>
                            <local:UC_NamedFormKeyMultiPicker MaxHeight="500" FormKeys="{Binding Races}" LinkCache="{Binding lk}" ScopedTypes="{Binding FormKeyPickerTypes}" Grid.Row="1" Grid.Column="1" />

                            <TextBlock Grid.Row="2" Grid.Column="0" local:DocTooltip.Key="Height.DistributionMode">Distribution Mode</TextBlock>
                            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type local:DistMode}}}" SelectedValue="{Binding Path=DistributionMode, Mode=TwoWay}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" local:DocTooltip.Key="Height.BaseHeight">Base Male Height</TextBlock>
                            <TextBox Grid.Row="3" Grid.Column="1" MinWidth="150" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding Path=MaleHeightBase}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" local:DocTooltip.Key="Height.HeightRange">Male Height +/-</TextBlock>
                            <TextBox Grid.Row="4" Grid.Column="1" MinWidth="150" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding Path=MaleHeightRange}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" local:DocTooltip.Key="Height.BaseHeight">Base Female Height</TextBlock>
                            <TextBox Grid.Row="5" Grid.Column="1" MinWidth="150" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding Path=FemaleHeightBase}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" local:DocTooltip.Key="Height.HeightRange">Female Height +/-</TextBlock>
                            <TextBox Grid.Row="6" Grid.Column="1" MinWidth="150" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding Path=FemaleHeightRange}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
