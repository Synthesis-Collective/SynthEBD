<UserControl x:Class="SynthEBD.UC_BodyGenTemplate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:plugins="clr-namespace:Mutagen.Bethesda.WPF.Plugins;assembly=Mutagen.Bethesda.WPF"
             xmlns:local="clr-namespace:SynthEBD"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:VM_BodyGenTemplate}"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border BorderThickness="1" BorderBrush="{Binding BorderColor}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300" MinWidth="150"/>
            </Grid.ColumnDefinitions>

            <!-- GridSplitter lets the user resize the preview pane. Starting Width for
                 column 2 is 300 so the viewer has enough room without crowding the form. -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          ShowsPreview="True"
                          local:DocTooltip.Key="BodyGenEditor.PreviewPaneSplitter"/>

            <!-- Live 3D preview of the current BodyGen template. The CharacterViewer is
                 owned by the parent VM_BodyGenTemplateMenu (shared across template
                 selections) to avoid leaking GL resources per click. -->
            <DockPanel Grid.Column="2" Margin="5 0 0 0">
                <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Margin="0 0 0 5">
                    <TextBlock Margin="0 0 0 2"
                               local:DocTooltip.Key="BodyGenEditor.PreviewWeight">
                        <Run Text="Preview Weight:"/>
                        <Run Text="{Binding PreviewWeight, UpdateSourceTrigger=PropertyChanged}"/>
                    </TextBlock>
                    <Slider Minimum="0" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="False"
                            Value="{Binding PreviewWeight, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="{Binding ParseErrorText}" Foreground="{DynamicResource StatusErrorForeground}" TextWrapping="Wrap"/>
                </StackPanel>
                <local:UC_CharacterViewer DataContext="{Binding CharacterViewer}" MinHeight="400"/>
            </DockPanel>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" Text="{Binding Path=StatusHeader, UpdateSourceTrigger=PropertyChanged}" Foreground="{Binding BorderColor}" Visibility="{Binding Path=ShowStatus, Converter={StaticResource BoolToVis}}"></TextBlock>
                <TextBlock Background="{DynamicResource TextBoxBackground}" Grid.Row="0" Grid.Column="2" MinWidth="150" HorizontalAlignment="Left" Text="{Binding Path=StatusText, UpdateSourceTrigger=PropertyChanged}" Foreground="{Binding BorderColor}" Visibility="{Binding Path=ShowStatus, Converter={StaticResource BoolToVis}}"></TextBlock>
                
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="BodyGenEditor.MorphName">Name</TextBlock>
                <TextBox Grid.Row="1" Grid.Column="2" MinWidth="150" HorizontalAlignment="Left" Text="{Binding Path=Label, UpdateSourceTrigger=PropertyChanged}"></TextBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="BodyGenEditor.Notes">Notes</TextBlock>
                <TextBox Grid.Row="2" Grid.Column="2" MinWidth="150" HorizontalAlignment="Left" Text="{Binding Path=Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"></TextBox>

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" local:DocTooltip.Key="BodyGenEditor.Specs">Morph</TextBlock>
                <TextBox Grid.Row="3" Grid.Column="2" MinWidth="150" HorizontalAlignment="Left" Text="{Binding Path=Specs, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"></TextBox>

                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" local:DocTooltip.Key="BodyGenEditor.MemberOfGroups">Belongs to Groups</TextBlock>
                <ContentPresenter Grid.Row="4" Grid.Column="2"  Content="{Binding GroupSelectionCheckList}">
                    <ContentPresenter.Resources>
                        <DataTemplate DataType="{x:Type local:VM_CollectionMemberStringCheckboxList}">
                            <local:UC_CollectionMemberStringCheckboxList Background="{DynamicResource SecondaryBackground}" Margin="0 0 0 10"/>
                        </DataTemplate>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" local:DocTooltip.Key="BodyGenEditor.Descriptors">Descriptors</TextBlock>
                <ContentPresenter Grid.Row="5" Grid.Column="2"  Content="{Binding DescriptorsSelectionMenu}">
                    <ContentPresenter.Resources>
                        <DataTemplate DataType="{x:Type local:VM_BodyShapeDescriptorSelectionMenu}">
                            <local:UC_BodyShapeDescriptorSelectionMenu Background="{DynamicResource SecondaryBackground}" Margin="0 0 0 10"/>
                        </DataTemplate>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <TextBlock Grid.Row="6" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="BodyGenEditor.AllowedRaces">Allowed Races</TextBlock>
                <local:UC_NamedFormKeyMultiPicker MaxHeight="500" Grid.Row="6" Grid.Column="2" MinWidth="150" FormKeys="{Binding AllowedRaces}" LinkCache="{Binding lk}" ScopedTypes="{Binding RacePickerFormKeys}" />

                <TextBlock Grid.Row="7" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="BodyGenEditor.AllowedRaceGroupings">Allowed Race Groupings</TextBlock>
                <ContentPresenter Grid.Row="7" Grid.Column="2"  Content="{Binding AllowedRaceGroupings}">
                    <ContentPresenter.Resources>
                        <DataTemplate DataType="{x:Type local:VM_RaceGroupingCheckboxList}">
                            <local:UC_RaceGroupingCheckboxList Background="{DynamicResource SecondaryBackground}" Margin="0 0 0 10"/>
                        </DataTemplate>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <TextBlock Grid.Row="8" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="BodyGenEditor.DisallowedRaces">Disallowed Races</TextBlock>
                <local:UC_NamedFormKeyMultiPicker MaxHeight="500" Grid.Row="8" Grid.Column="2" MinWidth="150" FormKeys="{Binding DisallowedRaces}" LinkCache="{Binding lk}" ScopedTypes="{Binding RacePickerFormKeys}" />

                <TextBlock Grid.Row="9" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="BodyGenEditor.DisallowedRaceGroupings">Disallowed Race Groupings</TextBlock>
                <ContentPresenter Grid.Row="9" Grid.Column="2"  Content="{Binding DisallowedRaceGroupings}">
                    <ContentPresenter.Resources>
                        <DataTemplate DataType="{x:Type local:VM_RaceGroupingCheckboxList}">
                            <local:UC_RaceGroupingCheckboxList Background="{DynamicResource SecondaryBackground}" Margin="0 0 0 10"/>
                        </DataTemplate>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <TextBlock Grid.Row="10" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="BodyGenEditor.AllowedAttributes">Allowed NPC Attributes</TextBlock>
                <Button Grid.Row="10" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding AddAllowedAttribute}" Foreground="{DynamicResource ActionGoodForeground}">Add New</Button>

                <ItemsControl Grid.Row="9" Grid.Column="2" ItemsSource="{Binding AllowedAttributes}" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:VM_NPCAttribute}">
                            <local:UC_NPCAttribute Background="{DynamicResource SecondaryBackground}" Margin="0 0 0 10"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


                <TextBlock Grid.Row="11" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="BodyGenEditor.DisallowedAttributes">Disallowed NPC Attributes</TextBlock>
                <Button Grid.Row="11" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding AddDisallowedAttribute}" Foreground="{DynamicResource ActionGoodForeground}">Add New</Button>
                <ItemsControl Grid.Row="11" Grid.Column="2" ItemsSource="{Binding DisallowedAttributes}" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:VM_NPCAttribute}">
                            <local:UC_NPCAttribute Background="{DynamicResource SecondaryBackground}" Margin="0 0 0 10"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="12" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="BodyGenEditor.WeightRange">Allowed NPC Weight Range</TextBlock>
                <StackPanel Grid.Row="12" Grid.Column="2" Orientation="Horizontal">
                    <TextBox MinWidth="50" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding Path=WeightRange.Lower}"/>
                    <TextBlock Text="to" Margin="15 0 15 0" VerticalAlignment="Center"/>
                    <TextBox MinWidth="50" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding Path=WeightRange.Upper}"/>
                </StackPanel>

                <TextBlock Grid.Row="13" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="BodyGenEditor.AllowRandom">Distribute to non-forced NPCs</TextBlock>
                <CheckBox Grid.Row="13" Grid.Column="2" IsChecked="{Binding Path=bAllowRandom, Mode=TwoWay}"></CheckBox>

                <TextBlock Grid.Row="14" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="BodyGenEditor.AllowUnique">Allow Unique NPCs</TextBlock>
                <CheckBox Grid.Row="14" Grid.Column="2" IsChecked="{Binding Path=bAllowUnique, Mode=TwoWay}"></CheckBox>

                <TextBlock Grid.Row="15" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="BodyGenEditor.AllowNonUnique">Allow Non-Unique NPCs</TextBlock>
                <CheckBox Grid.Row="15" Grid.Column="2" IsChecked="{Binding Path=bAllowNonUnique, Mode=TwoWay}"></CheckBox>

                <TextBlock Grid.Row="16" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="BodyGenEditor.ProbabilityWeighting">Distribution Probability Weighting</TextBlock>
                <TextBox Grid.Row="16" Grid.Column="2" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding Path=ProbabilityWeighting}"/>

                <TextBlock Grid.Row="17" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="BodyGenEditor.ProbabilityModifiers">Probability Modifiers</TextBlock>
                <Button Grid.Row="17" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding AddProbabilityWeightModifier}" Foreground="{DynamicResource ActionGoodForeground}">Add New</Button>
                <ItemsControl Grid.Row="17" Grid.Column="2" ItemsSource="{Binding ProbabilityWeightModifiers}" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:VM_AttributeWeightModifier}">
                            <local:UC_AttributeWeightModifier Background="{DynamicResource SecondaryBackground}" Margin="0 0 0 10"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="18" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="BodyGenEditor.RequiredTemplates">Required Templates</TextBlock>
                <Button Grid.Row="18" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding AddRequiredTemplate}" Foreground="{DynamicResource ActionGoodForeground}">Add New</Button>
                <ListBox Grid.Row="18" Grid.Column="2" ItemsSource="{Binding RequiredTemplates}" IsSynchronizedWithCurrentItem="True" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.OtherGroupsTemplateCollection}" SelectedValuePath="Label" DisplayMemberPath="Label" SelectedValue="{Binding Content}"></ComboBox>
                                <Button Width="75" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left" Command="{Binding DeleteCommand}">Remove</Button>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="19" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left" Command="{Binding DeleteMe}">Delete Morph</Button>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
