<UserControl x:Class="SynthEBD.UC_HeadPartCategoryRules"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SynthEBD"
             xmlns:plugins="clr-namespace:Mutagen.Bethesda.WPF.Plugins;assembly=Mutagen.Bethesda.WPF"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:VM_HeadPartCategoryRules}"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <local:BodyGenVisibilityConverter x:Key="BGVisibilityConverter" />
        <local:BodySlideVisibilityConverter x:Key="BSVisibilityConverter" />
    </UserControl.Resources>
    
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center">Distribute to Males</TextBlock>
                <CheckBox Grid.Row="0" Grid.Column="2" IsChecked="{Binding Path=bAllowMale, Mode=TwoWay}"></CheckBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center">Distribute to Females</TextBlock>
                <CheckBox Grid.Row="1" Grid.Column="2" IsChecked="{Binding Path=bAllowFemale, Mode=TwoWay}"></CheckBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="HeadParts.CategoryRestrictToExistingType">Lock to NPCs with this Head Part type</TextBlock>
                <CheckBox Grid.Row="2" Grid.Column="2" IsChecked="{Binding Path=bRestrictToNPCsWithThisType, Mode=TwoWay}"></CheckBox>

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="HeadParts.CategoryAllowedRaces">Allowed Races</TextBlock>
                <local:UC_NamedFormKeyMultiPicker MaxHeight="500" Grid.Row="3" Grid.Column="2" MinWidth="150" FormKeys="{Binding AllowedRaces}" LinkCache="{Binding lk}" ScopedTypes="{Binding RacePickerFormKeys}" />

                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="HeadParts.CategoryAllowedRaceGroupings">Allowed Race Groupings</TextBlock>
                <ContentPresenter Grid.Row="4" Grid.Column="2"  Content="{Binding AllowedRaceGroupings}">
                    <ContentPresenter.Resources>
                        <DataTemplate DataType="{x:Type local:VM_RaceGroupingCheckboxList}">
                            <local:UC_RaceGroupingCheckboxList Background="Black" Margin="0 0 0 10"/>
                        </DataTemplate>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="HeadParts.CategoryDisallowedRaces">Disallowed Races</TextBlock>
                <local:UC_NamedFormKeyMultiPicker MaxHeight="500" Grid.Row="5" Grid.Column="2" MinWidth="150" FormKeys="{Binding DisallowedRaces}" LinkCache="{Binding lk}" ScopedTypes="{Binding RacePickerFormKeys}" />

                <TextBlock Grid.Row="6" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="HeadParts.CategoryDisallowedRaceGroupings">Disallowed Race Groupings</TextBlock>
                <ContentPresenter Grid.Row="6" Grid.Column="2"  Content="{Binding DisallowedRaceGroupings}">
                    <ContentPresenter.Resources>
                        <DataTemplate DataType="{x:Type local:VM_RaceGroupingCheckboxList}">
                            <local:UC_RaceGroupingCheckboxList Background="Black" Margin="0 0 0 10"/>
                        </DataTemplate>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <TextBlock Grid.Row="7" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="HeadParts.CategoryAllowedAttributes">Allowed NPC Attributes</TextBlock>
                <Button Grid.Row="7" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding AddAllowedAttribute}" Foreground="Lightgreen">Add New</Button>
                <ItemsControl Grid.Row="7" Grid.Column="2" ItemsSource="{Binding AllowedAttributes}" BorderThickness="1" BorderBrush="#5844b4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:VM_NPCAttribute}">
                            <local:UC_NPCAttribute Background="Black" Margin="0 0 0 10"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="8" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="HeadParts.CategoryDisallowedAttributes">Disallowed NPC Attributes</TextBlock>
                <Button Grid.Row="8" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding AddDisallowedAttribute}" Foreground="Lightgreen">Add New</Button>
                <ItemsControl Grid.Row="8" Grid.Column="2" ItemsSource="{Binding DisallowedAttributes}" BorderThickness="1" BorderBrush="#5844b4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:VM_NPCAttribute}">
                            <local:UC_NPCAttribute Background="Black" Margin="0 0 0 10"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="9" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="HeadParts.CategoryWeightRange">Allowed NPC Weight Range</TextBlock>
                <StackPanel Grid.Row="9" Grid.Column="2" Orientation="Horizontal">
                    <TextBox MinWidth="50" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding Path=WeightRange.Lower}"/>
                    <TextBlock Text="to" Margin="15 0 15 0" VerticalAlignment="Center"/>
                    <TextBox MinWidth="50" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding Path=WeightRange.Upper}"/>
                </StackPanel>

                <TextBlock Grid.Row="10" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="HeadParts.CategoryDistributeToNonForced">Distribute to non-forced NPCs</TextBlock>
                <CheckBox Grid.Row="10" Grid.Column="2" IsChecked="{Binding Path=bAllowRandom, Mode=TwoWay}"></CheckBox>

                <TextBlock Grid.Row="11" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="HeadParts.CategoryAllowUnique">Allow Unique NPCs</TextBlock>
                <CheckBox Grid.Row="11" Grid.Column="2" IsChecked="{Binding Path=bAllowUnique, Mode=TwoWay}"></CheckBox>

                <TextBlock Grid.Row="12" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="HeadParts.CategoryAllowNonUnique">Allow Non-Unique NPCs</TextBlock>
                <CheckBox Grid.Row="12" Grid.Column="2" IsChecked="{Binding Path=bAllowNonUnique, Mode=TwoWay}"></CheckBox>

                <TextBlock Grid.Row="13" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="HeadParts.CategoryDistributionProbability"> Distribution Probability</TextBlock>
                <TextBox Grid.Row="13" Grid.Column="2" MinWidth="50" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding Path=DistributionProbability, UpdateSourceTrigger=PropertyChanged}"/>

                <!--OBody-->
                <TextBlock Grid.Row="14" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" Visibility="{Binding ParentMenu.BodyShapeMode, Converter={StaticResource BSVisibilityConverter}}" local:DocTooltip.Key="HeadParts.CategoryAllowedBodySlideDescriptors">Allowed BodySlide Descriptors</TextBlock>
                <local:UC_BodyShapeDescriptorSelectionMenu Grid.Row="14" Grid.Column="2"  Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.ParentMenu.BodyShapeMode, Converter={StaticResource BSVisibilityConverter}}" DataContext="{Binding AllowedBodySlideDescriptors}"/>

                <TextBlock Grid.Row="15" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" Visibility="{Binding ParentMenu.BodyShapeMode, Converter={StaticResource BSVisibilityConverter}}" local:DocTooltip.Key="HeadParts.CategoryDisallowedBodySlideDescriptors">Disallowed BodySlide Descriptors</TextBlock>
                <local:UC_BodyShapeDescriptorSelectionMenu Grid.Row="15" Grid.Column="2"  Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.ParentMenu.BodyShapeMode, Converter={StaticResource BSVisibilityConverter}}" DataContext="{Binding DisallowedBodySlideDescriptors}"/>

                <!--BodyGen-->
                <TextBlock Grid.Row="14" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" Visibility="{Binding ParentMenu.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" local:DocTooltip.Key="HeadParts.CategoryAllowedBodyGenDescriptors">Allowed Male BodyGen Descriptors</TextBlock>
                <local:UC_BodyShapeDescriptorSelectionMenu Grid.Row="14" Grid.Column="2" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.ParentMenu.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" DataContext="{Binding AllowedBodyGenDescriptorsMale}"/>

                <TextBlock Grid.Row="15" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" Visibility="{Binding ParentMenu.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" local:DocTooltip.Key="HeadParts.CategoryDisallowedBodyGenDescriptors">Disallowed Male BodyGen Descriptors</TextBlock>
                <local:UC_BodyShapeDescriptorSelectionMenu Grid.Row="15" Grid.Column="2"  Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.ParentMenu.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" DataContext="{Binding DisallowedBodyGenDescriptorsMale}" />

                <TextBlock Grid.Row="16" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" Visibility="{Binding ParentMenu.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" local:DocTooltip.Key="HeadParts.CategoryAllowedBodyGenDescriptors">Allowed Female BodyGen Descriptors</TextBlock>
                <local:UC_BodyShapeDescriptorSelectionMenu Grid.Row="16" Grid.Column="2" Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.ParentMenu.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" DataContext="{Binding AllowedBodyGenDescriptorsFemale}"/>

                <TextBlock Grid.Row="17" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" Visibility="{Binding ParentMenu.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" local:DocTooltip.Key="HeadParts.CategoryDisallowedBodyGenDescriptors">Disallowed Female BodyGen Descriptors</TextBlock>
                <local:UC_BodyShapeDescriptorSelectionMenu Grid.Row="17" Grid.Column="2"  Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.ParentMenu.BodyShapeMode, Converter={StaticResource BGVisibilityConverter}}" DataContext="{Binding DisallowedBodyGenDescriptorsFemale}" />

            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
