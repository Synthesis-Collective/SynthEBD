<Window x:Class="SynthEBD.Window_BodyTypeSpread"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SynthEBD"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:VM_BodyTypeSpread}"
        Title="{Binding Title}"
        Height="900" Width="1500" MinHeight="400" MinWidth="900"
        Style="{DynamicResource ThemedWindowStyle}">

    <i:Interaction.Behaviors>
        <local:TitleBarThemingBehavior/>
    </i:Interaction.Behaviors>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Loading placeholder: the same rotating dashed ring as the CharacterViewer busy
             overlay (UC_CharacterViewer.xaml), so a pending render reads the same everywhere.
             The storyboard starts/stops with visibility so hidden rings don't animate. -->
        <Style x:Key="SpreadSpinnerStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Stroke" Value="#FFFFCC40"/>
            <Setter Property="StrokeThickness" Value="4"/>
            <Setter Property="StrokeDashArray" Value="2.4 1.2"/>
            <Setter Property="StrokeDashCap" Value="Round"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="SpreadSpinnerStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360"
                                                 Duration="0:0:1.2"
                                                 RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SpreadSpinnerStoryboard"/>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- One statistic's representative: front-or-back + side images over a caption.
             Clicking anywhere on the cell loads the slice into the editor's live viewer. -->
        <DataTemplate x:Key="SpreadCellTemplate" DataType="{x:Type local:VM_BodyTypeSpreadCell}">
            <Border Margin="3" Padding="3" Cursor="Hand"
                    Background="{DynamicResource SecondaryBackground}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3"
                    local:DocTooltip.Key="BodyTypeSpread.Cell">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding LoadInViewerCommand}"/>
                </Border.InputBindings>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,3,0,0">
                        <!-- Orange + explanatory tooltip when the preset's manual annotation
                             contradicts the rules (only while annotations are included). -->
                        <DockPanel>
                        <Button DockPanel.Dock="Right" Content="HD" Margin="4,0,0,0" Padding="3,0" VerticalAlignment="Center" Foreground="Firebrick" Command="{Binding HideAndDisableCommand}" CommandParameter="{Binding}" local:DocTooltip.Key="BodySlides.HideAndDisableListButton"/>
                        <TextBlock Text="{Binding PresetLabel}" FontWeight="Bold" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="ToolTip" Value="{Binding PresetLabel}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsContradicted}" Value="True">
                                            <Setter Property="Foreground" Value="DarkOrange"/>
                                            <Setter Property="ToolTip" Value="{Binding Contradiction}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        </DockPanel>
                        <TextBlock Text="{Binding Caption}" Foreground="{DynamicResource SecondaryForeground}"
                                   TextTrimming="CharacterEllipsis" FontSize="11"/>
                    </StackPanel>
                    <UniformGrid Columns="2" Height="250">
                        <Grid>
                            <Image Source="{Binding PrimaryImage}" Stretch="Uniform"/>
                            <Ellipse Style="{StaticResource SpreadSpinnerStyle}"
                                     Visibility="{Binding IsPrimaryLoading, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="Render failed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForeground}"
                                       Visibility="{Binding IsPrimaryFailed, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <Grid>
                            <Image Source="{Binding SideImage}" Stretch="Uniform"/>
                            <Ellipse Style="{StaticResource SpreadSpinnerStyle}"
                                     Visibility="{Binding IsSideLoading, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="Render failed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForeground}"
                                       Visibility="{Binding IsSideFailed, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </UniformGrid>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="6">
        <!-- Controls -->
        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="Metric:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="260" VerticalAlignment="Center" Margin="0,0,14,0"
                      ItemsSource="{Binding Metrics}"
                      SelectedItem="{Binding SelectedMetric}"
                      DisplayMemberPath="Display"
                      local:DocTooltip.Key="BodyTypeSpread.Metric"/>
            <CheckBox Content="Back view" IsChecked="{Binding ShowBack}"
                      VerticalAlignment="Center" Margin="0,0,14,0"
                      local:DocTooltip.Key="BodyTypeSpread.ShowBack"/>
            <CheckBox Content="Ignore manual annotations" IsChecked="{Binding IgnoreManualAnnotations}"
                      VerticalAlignment="Center" Margin="0,0,14,0"
                      local:DocTooltip.Key="BodyTypeSpread.IgnoreManualAnnotations"/>
            <CheckBox Content="Show measurements" IsChecked="{Binding ShowMeasurements}"
                      VerticalAlignment="Center" Margin="0,0,14,0"
                      local:DocTooltip.Key="BodyTypeSpread.ShowMeasurements"/>
            <Button Content="Sort rows" Command="{Binding SortRowsCommand}"
                    Padding="6,2" VerticalAlignment="Center" Margin="0,0,14,0"
                    local:DocTooltip.Key="BodyTypeSpread.SortRows"/>
            <TextBlock Text="Peak bins:" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <xctk:IntegerUpDown Width="60" Minimum="1" Maximum="100" VerticalAlignment="Center" Margin="0,0,14,0"
                                Value="{Binding PeakBinCount}"
                                local:DocTooltip.Key="BodyTypeSpread.PeakBins"/>
            <TextBlock Text="{Binding RenderStatus}" FontStyle="Italic" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryForeground}"/>
        </WrapPanel>

        <!-- Column headers: row-label column + one per statistic, sized like the rows below. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,18,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Bottom" FontStyle="Italic"
                       Foreground="{DynamicResource SecondaryForeground}">
                <Run Text="{Binding PrimaryViewLabel, Mode=OneWay}"/><Run Text=" + Side"/>
            </TextBlock>
            <ItemsControl Grid.Column="1" ItemsSource="{Binding ColumnHeaders}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- One row per descriptor value -->
        <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:VM_BodyTypeSpreadRow}">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                <TextBlock Text="{Binding Header}" FontWeight="Bold" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="&#x25B2;" Width="26" Margin="0,0,4,0"
                                            Command="{Binding DataContext.MoveRowUpCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            local:DocTooltip.Key="BodyTypeSpread.MoveRow"/>
                                    <Button Content="&#x25BC;" Width="26"
                                            Command="{Binding DataContext.MoveRowDownCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            local:DocTooltip.Key="BodyTypeSpread.MoveRow"/>
                                </StackPanel>
                            </StackPanel>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}"
                                          ItemTemplate="{StaticResource SpreadCellTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" Columns="5"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Grid.Column="1" Text="{Binding EmptyMessage}" FontStyle="Italic"
                                       Foreground="{DynamicResource SecondaryForeground}"
                                       VerticalAlignment="Center" Margin="6,12"
                                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
