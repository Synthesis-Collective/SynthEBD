<UserControl x:Class="SynthEBD.UC_BodySlideMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             d:DataContext="{d:DesignInstance Type=local:VM_BodySlidesMenu}"
             xmlns:local="clr-namespace:SynthEBD"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2.25*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0">
            <TextBlock Text="Gender:" VerticalAlignment="Center" Margin="0,0,3,0"/>
            <ComboBox SelectedValue="{Binding SelectedGender}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type local:Gender}}}" IsSynchronizedWithCurrentItem="True"/>
            <TextBlock Text="Body Type:" VerticalAlignment="Center" Margin="8,0,3,0"/>
            <ComboBox SelectedValue="{Binding SelectedBodyType}" ItemsSource="{Binding AvailableBodyTypesForGender}" IsSynchronizedWithCurrentItem="True" MinWidth="100"/>
            <local:UC_Alphabetizer DataContext="{Binding Alphabetizer}" Margin="8,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,3,0"/>
            <TextBox Text="{Binding PresetFilterText, UpdateSourceTrigger=PropertyChanged}" MinWidth="140" VerticalAlignment="Center"
                     local:DocTooltip.Key="BodySlides.PresetNameFilter"/>
            <TextBlock Text=" Preset (" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <CheckBox IsChecked="{Binding ShowHidden}" VerticalAlignment="Center"/>
            <TextBlock Text=" Show Hidden)" VerticalAlignment="Center"/>
        </StackPanel>
        <Button Grid.Row="2" Grid.Column="0" Command="{Binding AddPreset}" Foreground="{DynamicResource ActionGoodForeground}">Add New</Button>

        <ListBox Grid.Row="3" Grid.Column="0" Grid.RowSpan="2" SelectedValue="{Binding SelectedPlaceHolder}" ItemsSource="{Binding CurrentlyDisplayedBodySlides}" IsSynchronizedWithCurrentItem="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1" BorderBrush="{Binding BorderColor}" MaxWidth="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Margin="1 0 0 1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" PreviewMouseLeftButtonDown="TextBlock_PreviewMouseLeftButtonDown"/>
                            </ScrollViewer>
                            <Button Grid.Column="1" HorizontalAlignment="Right" Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.RemovePreset}" CommandParameter="{Binding}" Foreground="Firebrick">X</Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsVisible}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <StackPanel Grid.Row="5" Grid.Column="0" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="Delete"/>
            <Button Margin="5 0 5 0" Command="{Binding RemovePresetsMissing}" Foreground="Firebrick">Missing</Button>
            <Button Margin="5 0 5 0" Command="{Binding RemovePresetsUnannotated}" Foreground="Firebrick">Unannotated</Button>
            <Button Margin="5 0 5 0" Command="{Binding RemovePresetsAll}" Foreground="Firebrick">All</Button>
        </StackPanel>

        <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal">
            <Button Margin="5 0 5 0" Command="{Binding ImportAnnotations}" Foreground="{DynamicResource ActionAccentForeground}">Import</Button>
            <TextBlock Text=" | "/>
            <Button Margin="5 0 5 0" Command="{Binding ExportAnnotations}" Foreground="{DynamicResource ActionAccentForeground}">Export</Button>
        </StackPanel>

        <ContentPresenter Grid.Row="0" Grid.Column="1" Grid.RowSpan="4" Content="{Binding CurrentlyDisplayedBodySlide}">
            <ContentPresenter.Resources>
                <DataTemplate DataType="{x:Type local:VM_BodySlideSetting}">
                    <local:UC_BodySlideSetting/>
                </DataTemplate>
            </ContentPresenter.Resources>
        </ContentPresenter>

        <local:UC_BodyShapeDescriptorSelectionMenu Grid.Row="4" Grid.Column="1" Grid.RowSpan="3" DataContext="{Binding DescriptorFilter}"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FilterCaption}" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0 5 0 0"/>
    </Grid>
</UserControl>
