<Window x:Class="SynthEBD.Window_RuleDeleteExportPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SynthEBD"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:VM_RuleDeleteExportPicker}"
        Title="Export Rules Patch — Mark for Deletion"
        Height="700" Width="600"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource ThemedWindowStyle}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <i:Interaction.Behaviors>
        <local:TitleBarThemingBehavior/>
    </i:Interaction.Behaviors>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource SecondaryForeground}">
            <Run Text="The add/edit set was pre-seeded from the Rules-tab tree node that was selected when you triggered Ctrl+Shift+Alt+P."/>
            <LineBreak/>
            <Run Text="Tick 'Mark for deletion' to add a rule's Id to the patch's RulesToDelete list. On rules already in the add/edit set, tick 'Exclude' to drop them from the patch."/>
        </TextBlock>

        <TreeView Grid.Row="1" ItemsSource="{Binding Categories}">
            <TreeView.Resources>
                <!-- Category-level node: shows category name. -->
                <HierarchicalDataTemplate DataType="{x:Type local:VM_RuleDeletePickerCategoryNode}"
                                          ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="Bold"/>
                </HierarchicalDataTemplate>

                <!-- Value-level node: shows value name. -->
                <HierarchicalDataTemplate DataType="{x:Type local:VM_RuleDeletePickerValueNode}"
                                          ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding DisplayLabel}" FontStyle="Italic"/>
                </HierarchicalDataTemplate>

                <!-- Leaf: per-rule row with the two user toggles + read-only "in add/edit set" badge. -->
                <DataTemplate DataType="{x:Type local:VM_RuleDeletePickerRuleNode}">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="Delete"
                                  IsChecked="{Binding IsMarkedForDeletion}"
                                  Foreground="{DynamicResource ActionDangerForeground}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  local:DocTooltip.Key="BodyTypeProfiles.RuleExport.MarkForDeletion"/>
                        <CheckBox Content="Exclude from add/edit"
                                  IsChecked="{Binding IsExcludedFromAddEdit}"
                                  Visibility="{Binding IsInAddEditSet, Converter={StaticResource BoolToVis}}"
                                  Foreground="{DynamicResource StatusPendingForeground}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  local:DocTooltip.Key="BodyTypeProfiles.RuleExport.ExcludeFromAddEdit"/>
                        <TextBlock Text="{Binding DisplayLabel}" VerticalAlignment="Center"/>
                        <TextBlock Text=" (in add/edit set)"
                                   Foreground="{DynamicResource StatusValidForeground}"
                                   FontStyle="Italic"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsInAddEditSet, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </DataTemplate>
            </TreeView.Resources>
            <TreeView.ItemContainerStyle>
                <Style TargetType="{x:Type TreeViewItem}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                </Style>
            </TreeView.ItemContainerStyle>
        </TreeView>

        <TextBlock Grid.Row="2" Margin="0,8,0,0" FontWeight="SemiBold"
                   Text="{Binding SummaryText}"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="OK" Width="80" Margin="0,0,8,0"
                    Command="{Binding OkCommand}" IsDefault="True"
                    Foreground="{DynamicResource ActionGoodForeground}" FontWeight="Bold"/>
            <Button Content="Cancel" Width="80"
                    Command="{Binding CancelCommand}" IsCancel="True"
                    Foreground="{DynamicResource ActionDangerForeground}" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
