<UserControl x:Class="SynthEBD.UC_SliderClassificationRulesByBodyType"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SynthEBD"
             d:DataContext="{d:DesignInstance Type=local:VM_SliderClassificationRulesByBodyType}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Shown only for registry body types with no installed BodySlide presets: the rules below
             are editable, but there is nothing to apply/test them against until presets are added. -->
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                   Foreground="{DynamicResource StatusErrorForeground}"
                   TextWrapping="Wrap" Margin="0 0 0 6"
                   Text="No BodySlide presets are installed for this body type. You can author rules below (the available slider names come from the Body Type Registry), but there are no presets to apply or test them against yet.">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasLoadedPresets}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Only meaningful when a registry catalog exists; without one the full preset union is
             always shown and the toggle is hidden. -->
        <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0 0 0 6"
                  IsChecked="{Binding ShowPresetOnlySliders}"
                  Visibility="{Binding HasSliderCatalog, Converter={StaticResource BoolToVis}}"
                  local:DocTooltip.Key="OBody.AnnotatorShowPresetOnlySliders">
            <TextBlock>
                <Run Text="Show preset-only sliders ("/><Run Text="{Binding PresetOnlySliderCount, Mode=OneWay}"/><Run Text=" hidden outfit/custom names)"/>
            </TextBlock>
        </CheckBox>

        <ListBox Grid.Row="2" Grid.Column="0" SelectedValue="{Binding SelectedDescriptor}" ItemsSource="{Binding DescriptorClassifiers}" IsSynchronizedWithCurrentItem="False" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                        <TextBlock Text="{Binding DescriptorCategory}" Margin="2" HorizontalAlignment="Center"/>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="3" Grid.Column="0" Content="Re-Annotate Selected" Foreground="Purple" Command="{Binding SelectedDescriptor.ApplyAnnotationsCommand}" VerticalAlignment="Top"/>

        <ContentPresenter Grid.Row="2" Grid.Column="1" Grid.RowSpan="2" Content="{Binding SelectedDescriptor}" Margin="5 0 0 0">
            <ContentPresenter.Resources>
                <DataTemplate DataType="{x:Type local:VM_DescriptorClassificationRuleSet}">
                    <local:UC_DescriptorClassificationRuleSet/>
                </DataTemplate>
            </ContentPresenter.Resources>
        </ContentPresenter>
    </Grid>
</UserControl>
