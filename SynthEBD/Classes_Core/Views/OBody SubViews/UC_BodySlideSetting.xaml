<UserControl x:Class="SynthEBD.UC_BodySlideSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:plugins="clr-namespace:Mutagen.Bethesda.WPF.Plugins;assembly=Mutagen.Bethesda.WPF"
             xmlns:local="clr-namespace:SynthEBD"
             d:DataContext="{d:DesignInstance Type=local:VM_BodySlideSetting}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    
    <Border BorderThickness="1" BorderBrush="{Binding BorderColor}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="100" MinWidth="60"/>
            </Grid.ColumnDefinitions>

            <!-- Section B preview viewer: embedded per-preset 3D viewer, pinned to the right
                 so the main settings grid keeps its existing layout. Bound to the per-preset
                 CharacterViewer VM (Func<VM_CharacterViewer> factory in the ctor). The
                 GridSplitter in column 1 lets the user resize the viewer; the column's
                 starting Width (100) is intentionally narrow so the viewer doesn't obscure
                 the main settings grid. -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          ShowsPreview="True"
                          local:DocTooltip.Key="BodySlides.PreviewResizer"/>

            <Grid Grid.Column="2" Margin="5 0 0 0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <local:UC_CharacterViewer Grid.Row="0" DataContext="{Binding CharacterViewer}"
                                          MinHeight="400"/>
                <Border Grid.Row="1" Background="{DynamicResource SecondaryBackground}" Padding="6 4">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="Preview NPC:" VerticalAlignment="Center" Margin="0 0 5 0"/>
                        <local:UC_NamedFormKeyPicker FormKey="{Binding PreviewNpcOverride, Mode=TwoWay}" LinkCache="{Binding lk}" ScopedTypes="{Binding NPCPickerFormKeys}" MaxHeight="180"
                                               local:DocTooltip.Key="BodySlides.PreviewNpcOverride"/>
                    </DockPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" Text="{Binding Path=StatusHeader, UpdateSourceTrigger=PropertyChanged}" Foreground="{Binding BorderColor}" Visibility="{Binding Path=ShowStatus, Converter={StaticResource BoolToVis}}"></TextBlock>
                <TextBlock Background="{DynamicResource TextBoxBackground}" Grid.Row="0" Grid.Column="2" MinWidth="150" HorizontalAlignment="Left" Text="{Binding Path=StatusText, UpdateSourceTrigger=PropertyChanged}" Foreground="{Binding BorderColor}" Visibility="{Binding Path=ShowStatus, Converter={StaticResource BoolToVis}}"></TextBlock>
                
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center">Name</TextBlock>
                <TextBox Background="{DynamicResource TextBoxBackground}" Grid.Row="1" Grid.Column="2" MinWidth="150" HorizontalAlignment="Left" Text="{Binding Path=Label, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center">BodySlide</TextBlock>
                <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                    <TextBox Background="{DynamicResource TextBoxBackground}"  MinWidth="150" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Path=ReferencedBodySlide, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ReferenceUnlocked}"/>
                    <Button Margin="5 0 0 0" Command="{Binding ToggleLock}" local:DocTooltip.Key="BodySlides.EditReferencedBodySlide" Foreground="{DynamicResource ActionAccentForeground}" Content="{Binding LockLabel}"/>
                </StackPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center">Slider Group</TextBlock>
                <TextBox Background="{DynamicResource TextBoxBackground}" Grid.Row="3" Grid.Column="2" MinWidth="150" HorizontalAlignment="Left" Text="{Binding Path=SliderGroup, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center"
                           local:DocTooltip.Key="BodySlides.RegistryBodyType">Registry Body Type</TextBlock>
                <TextBlock Grid.Row="4" Grid.Column="2" MinWidth="150" HorizontalAlignment="Left" VerticalAlignment="Center"
                           Text="{Binding MatchedRegistryBodyType}" Foreground="{Binding MatchedRegistryBrush}"
                           ToolTip="{Binding MatchedRegistryTooltip}"
                           ToolTipService.IsEnabled="{Binding MatchedRegistryTooltipEnabled}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="BodySlides.Notes">Notes</TextBlock>
                <TextBox Grid.Row="5" Grid.Column="2" MinWidth="150" HorizontalAlignment="Left" Text="{Binding Path=Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"></TextBox>

                <TextBlock Grid.Row="6" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Top" local:DocTooltip.Key="BodySlides.WeightSlotDescriptors">Descriptors</TextBlock>
                <StackPanel Grid.Row="6" Grid.Column="2" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
                        <TextBlock VerticalAlignment="Center" Margin="0 0 5 0">Add slot at weight:</TextBlock>
                        <TextBox MinWidth="40" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding NewSlotWeight, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Margin="5 0 0 0" Foreground="{DynamicResource ActionGoodForeground}" Content="Add Slot" Command="{Binding AddWeightSlotCommand}"
                                local:DocTooltip.Key="BodySlides.AddWeightSlot"/>
                    </StackPanel>
                    <TabControl ItemsSource="{Binding WeightSlots}" SelectedItem="{Binding SelectedWeightSlot}" Background="{DynamicResource SecondaryBackground}" MinHeight="100">
                        <TabControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:VM_BodySlideWeightSlot}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Header}" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <Button Content="x" Foreground="{DynamicResource ActionDangerForeground}" Background="Transparent" BorderThickness="0" Padding="3 0 3 0"
                                            Command="{Binding RemoveCommand}"
                                            local:DocTooltip.Key="BodySlides.RemoveWeightSlot"/>
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type local:VM_BodySlideWeightSlot}">
                                <ContentPresenter Content="{Binding DescriptorsSelectionMenu}">
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type local:VM_BodyShapeDescriptorSelectionMenu}">
                                            <local:UC_BodyShapeDescriptorSelectionMenu Background="{DynamicResource SecondaryBackground}"/>
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </StackPanel>

                <Button Grid.Row="7" Grid.Column="2" HorizontalAlignment="Left" Content="Accept Auto-Annotated Descriptors (All Slots)" Foreground="{DynamicResource ActionGoodForeground}" Margin="0 0 0 5" Command="{Binding AcceptAutoAnnotations}" Visibility="{Binding ShowAcceptAnnotationsButton, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Grid.Row="8" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="BodySlides.AllowedRaces">Allowed Races</TextBlock>
                <local:UC_NamedFormKeyMultiPicker MaxHeight="500" Grid.Row="8" Grid.Column="2" MinWidth="150" FormKeys="{Binding AllowedRaces}" LinkCache="{Binding lk}" ScopedTypes="{Binding RacePickerFormKeys}" />

                <TextBlock Grid.Row="9" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="BodySlides.AllowedRaceGroupings">Allowed Race Groupings</TextBlock>
                <ContentPresenter Grid.Row="9" Grid.Column="2"  Content="{Binding AllowedRaceGroupings}">
                    <ContentPresenter.Resources>
                        <DataTemplate DataType="{x:Type local:VM_RaceGroupingCheckboxList}">
                            <local:UC_RaceGroupingCheckboxList Background="{DynamicResource SecondaryBackground}" Margin="0 0 0 10"/>
                        </DataTemplate>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <TextBlock Grid.Row="10" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="BodySlides.DisallowedRaces">Disallowed Races</TextBlock>
                <local:UC_NamedFormKeyMultiPicker MaxHeight="500" Grid.Row="10" Grid.Column="2" MinWidth="150" FormKeys="{Binding DisallowedRaces}" LinkCache="{Binding lk}" ScopedTypes="{Binding RacePickerFormKeys}" />

                <TextBlock Grid.Row="11" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="BodySlides.DisallowedRaceGroupings">Disallowed Race Groupings</TextBlock>
                <ContentPresenter Grid.Row="11" Grid.Column="2"  Content="{Binding DisallowedRaceGroupings}">
                    <ContentPresenter.Resources>
                        <DataTemplate DataType="{x:Type local:VM_RaceGroupingCheckboxList}">
                            <local:UC_RaceGroupingCheckboxList Background="{DynamicResource SecondaryBackground}" Margin="0 0 0 10"/>
                        </DataTemplate>
                    </ContentPresenter.Resources>
                </ContentPresenter>

                <TextBlock Grid.Row="12" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="BodySlides.AllowedAttributes">Allowed NPC Attributes</TextBlock>
                <Button Grid.Row="12" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding AddAllowedAttribute}" Foreground="{DynamicResource ActionGoodForeground}">Add New</Button>

                <ItemsControl Grid.Row="12" Grid.Column="2" ItemsSource="{Binding AllowedAttributes}" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:VM_NPCAttribute}">
                            <local:UC_NPCAttribute Background="{DynamicResource SecondaryBackground}" Margin="0 0 0 10"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="13" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="BodySlides.DisallowedAttributes">Disallowed NPC Attributes</TextBlock>
                <Button Grid.Row="13" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding AddDisallowedAttribute}" Foreground="{DynamicResource ActionGoodForeground}">Add New</Button>
                <ItemsControl Grid.Row="13" Grid.Column="2" ItemsSource="{Binding DisallowedAttributes}" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:VM_NPCAttribute}">
                            <local:UC_NPCAttribute Background="{DynamicResource SecondaryBackground}" Margin="0 0 0 10"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="14" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="BodySlides.WeightRange">Allowed NPC Weight Range</TextBlock>
                <StackPanel Grid.Row="14" Grid.Column="2" Orientation="Horizontal">
                    <TextBox MinWidth="50" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding Path=WeightRange.Lower}"/>
                    <TextBlock Text="to" Margin="15 0 15 0" VerticalAlignment="Center"/>
                    <TextBox MinWidth="50" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding Path=WeightRange.Upper}"/>
                </StackPanel>

                <TextBlock Grid.Row="15" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="BodySlides.AllowRandom">Distribute to non-forced NPCs</TextBlock>
                <CheckBox Grid.Row="15" Grid.Column="2" IsChecked="{Binding Path=bAllowRandom, Mode=TwoWay}"></CheckBox>

                <TextBlock Grid.Row="16" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="BodySlides.AllowUnique">Allow Unique NPCs</TextBlock>
                <CheckBox Grid.Row="16" Grid.Column="2" IsChecked="{Binding Path=bAllowUnique, Mode=TwoWay}"></CheckBox>

                <TextBlock Grid.Row="17" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="BodySlides.AllowNonUnique">Allow Non-Unique NPCs</TextBlock>
                <CheckBox Grid.Row="17" Grid.Column="2" IsChecked="{Binding Path=bAllowNonUnique, Mode=TwoWay}"></CheckBox>

                <TextBlock Grid.Row="18" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="BodySlides.ProbabilityWeighting"> Distribution Probability Weighting</TextBlock>
                <TextBox Grid.Row="18" Grid.Column="2" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding Path=ProbabilityWeighting}"/>

                <TextBlock Grid.Row="19" Grid.Column="0" Margin="0 0 15 0" local:DocTooltip.Key="BodySlides.ProbabilityWeightModifiers">Probability Modifiers</TextBlock>
                <Button Grid.Row="19" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Command="{Binding AddProbabilityWeightModifier}" Foreground="{DynamicResource ActionGoodForeground}">Add New</Button>
                <ItemsControl Grid.Row="19" Grid.Column="2" ItemsSource="{Binding ProbabilityWeightModifiers}" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:VM_AttributeWeightModifier}">
                            <local:UC_AttributeWeightModifier Background="{DynamicResource SecondaryBackground}" Margin="0 0 0 10"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="20" Grid.Column="0" Margin="0 0 15 0" VerticalAlignment="Center" local:DocTooltip.Key="BodySlides.SliderValues">Slider Values</TextBlock>
                <Expander Grid.Row="20" Grid.Column="2">
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding SliderValues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>
                
                <Button Grid.Row="21" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left" Command="{Binding ToggleHide}" local:DocTooltip.Key="BodySlides.HideUnhide" Foreground="{DynamicResource ActionAccentForeground}" Content="{Binding HideButtonText}"></Button>
                <Button Grid.Row="22" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left" Command="{Binding CloneCommand}" local:DocTooltip.Key="BodySlides.ClonePreset" Foreground="{DynamicResource ActionAccentForeground}">Clone Preset</Button>
                <Button Grid.Row="23" Grid.Column="0" VerticalAlignment="Top" HorizontalAlignment="Left" Command="{Binding DeleteMe}" local:DocTooltip.Key="BodySlides.DeletePreset">Delete Preset</Button>
            </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
