<Window x:Class="SynthEBD.Window_AnnotationPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SynthEBD"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:VM_AnnotationPanel}"
        Title="{Binding Title}"
        Height="950" Width="1600" MinHeight="400" MinWidth="700"
        Style="{DynamicResource ThemedWindowStyle}">

    <i:Interaction.Behaviors>
        <local:TitleBarThemingBehavior/>
    </i:Interaction.Behaviors>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:UiModeToVisibilityConverter x:Key="UiModeVisibility"/>

        <!-- Same rotating dashed ring as Show Spread's pending render (Window_BodyTypeSpread.xaml). -->
        <Style x:Key="PanelSpinnerStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Stroke" Value="#FFFFCC40"/>
            <Setter Property="StrokeThickness" Value="4"/>
            <Setter Property="StrokeDashArray" Value="2.4 1.2"/>
            <Setter Property="StrokeDashCap" Value="Round"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="PanelSpinnerStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360"
                                                 Duration="0:0:1.2"
                                                 RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="PanelSpinnerStoryboard"/>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- One slice: the Show Spread cell (front-or-back + side images, label, HD, caption;
             clicking the images loads the slice in the editor's live viewer) with a row of value
             toggles underneath. Toggles save immediately and reflect what is stored. -->
        <DataTemplate x:Key="PanelCellTemplate" DataType="{x:Type local:VM_AnnotationPanelCell}">
            <Border Margin="3" Padding="3" Width="250"
                    Background="{DynamicResource SecondaryBackground}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                <DockPanel>
                    <!-- Value selector -->
                    <ItemsControl DockPanel.Dock="Bottom" Margin="0,4,0,0" ItemsSource="{Binding Toggles}"
                                  IsEnabled="{Binding CanEdit}"
                                  local:DocTooltip.Key="AnnotationPanel.ValueToggles">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:VM_AnnotationPanelToggle}">
                                <Border Margin="0,0,3,2" BorderThickness="2" CornerRadius="3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Button Padding="5,1" Command="{Binding ToggleCommand}">
                                        <TextBlock Text="{Binding Value}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="TextDecorations" Value="Underline"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,3,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="HD" Margin="4,0,0,0" Padding="3,0" VerticalAlignment="Center" Foreground="Firebrick" Command="{Binding HideAndDisableCommand}" CommandParameter="{Binding}" local:DocTooltip.Key="BodySlides.HideAndDisableListButton"/>
                            <TextBlock Text="{Binding PresetLabel}" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding AliasTooltip}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Caption}" Foreground="{DynamicResource SecondaryForeground}"
                                   TextTrimming="CharacterEllipsis" FontSize="11"/>
                    </StackPanel>
                    <UniformGrid Columns="2" Height="250" Cursor="Hand" Background="Transparent"
                                 local:DocTooltip.Key="AnnotationPanel.Cell">
                        <UniformGrid.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding LoadInViewerCommand}"/>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding LoadInViewerFreeCommand}"/>
                        </UniformGrid.InputBindings>
                        <Grid>
                            <Image Source="{Binding PrimaryImage}" Stretch="Uniform"/>
                            <Ellipse Style="{StaticResource PanelSpinnerStyle}"
                                     Visibility="{Binding IsPrimaryLoading, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="Render failed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForeground}"
                                       Visibility="{Binding IsPrimaryFailed, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <Grid>
                            <Image Source="{Binding SideImage}" Stretch="Uniform"/>
                            <Ellipse Style="{StaticResource PanelSpinnerStyle}"
                                     Visibility="{Binding IsSideLoading, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="Render failed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForeground}"
                                       Visibility="{Binding IsSideFailed, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </UniformGrid>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="6">
        <!-- Controls -->
        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Metric:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="300" VerticalAlignment="Center" Margin="0,0,14,0"
                      ItemsSource="{Binding Metrics}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Name"
                      SelectedValue="{Binding SelectedMetric}"
                      local:DocTooltip.Key="AnnotationPanel.Metric"/>
            <CheckBox Content="Back view" IsChecked="{Binding ShowBack}"
                      VerticalAlignment="Center" Margin="0,0,14,0"
                      local:DocTooltip.Key="BodyTypeSpread.ShowBack"/>
            <CheckBox Content="Show measurements" IsChecked="{Binding ShowMeasurements}"
                      VerticalAlignment="Center" Margin="0,0,14,0"
                      local:DocTooltip.Key="AnnotationPanel.ShowMeasurements"/>
            <CheckBox Content="Show values" IsChecked="{Binding ShowValues}"
                      VerticalAlignment="Center" Margin="0,0,14,0"
                      Visibility="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeVisibility}, ConverterParameter=Customize}"
                      local:DocTooltip.Key="AnnotationPanel.ShowValues"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,14,0"
                        Visibility="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeVisibility}, ConverterParameter=Customize}">
                <TextBlock Text="Source:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox Width="130" VerticalAlignment="Center" Margin="0,0,8,0"
                          ItemsSource="{Binding SourceOptions}"
                          SelectedItem="{Binding Source}"
                          IsEnabled="{Binding CanChooseSource}"
                          local:DocTooltip.Key="AnnotationPanel.Source"/>
                <TextBlock Text="N:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <xctk:IntegerUpDown Width="60" Minimum="1" Maximum="500" VerticalAlignment="Center"
                                    Value="{Binding EvenlySpacedCount}"
                                    IsEnabled="{Binding IsEvenlySpaced}"
                                    local:DocTooltip.Key="AnnotationPanel.EvenlySpacedCount"/>
            </StackPanel>
            <Button Content="&lt; Prev" Command="{Binding PrevPageCommand}" Padding="6,2" VerticalAlignment="Center"
                    local:DocTooltip.Key="AnnotationPanel.Paging"/>
            <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Margin="8,0"/>
            <Button Content="Next &gt;" Command="{Binding NextPageCommand}" Padding="6,2" VerticalAlignment="Center" Margin="0,0,14,0"
                    local:DocTooltip.Key="AnnotationPanel.Paging"/>
            <Button Content="Copy Order" Command="{Binding CopyOrderCommand}" Padding="6,2" VerticalAlignment="Center" Margin="0,0,6,0"
                    local:DocTooltip.Key="AnnotationPanel.CopyOrder"/>
            <TextBlock Text="{Binding CopyStatus}" VerticalAlignment="Center" Margin="0,0,14,0"
                       Foreground="{DynamicResource SecondaryForeground}"/>
            <TextBlock Text="{Binding RenderStatus}" FontStyle="Italic" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryForeground}"/>
        </WrapPanel>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Foreground="{DynamicResource SecondaryForeground}">
            <Run Text="{Binding Summary, Mode=OneWay}"/><Run Text=" - low to high, left to right. Images: "/><Run Text="{Binding PrimaryViewLabel, Mode=OneWay}"/><Run Text=" + Side."/>
        </TextBlock>

        <!-- Stale banner: the queue changed under the panel. -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,4" Padding="6,3" BorderThickness="1" CornerRadius="3"
                BorderBrush="DarkOrange"
                Visibility="{Binding IsStale, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StaleMessage}" Foreground="DarkOrange" FontWeight="Bold" TextWrapping="Wrap"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- Drag-and-drop reordering is live only in the Free sort mode. -->
            <ItemsControl ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource PanelCellTemplate}"
                          dd:DragDrop.IsDragSource="{Binding IsFreeOrder}"
                          dd:DragDrop.IsDropTarget="{Binding IsFreeOrder}"
                          dd:DragDrop.DropHandler="{Binding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
