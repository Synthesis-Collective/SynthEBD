<Window x:Class="SynthEBD.Window_DescriptorSample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SynthEBD"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:VM_DescriptorSample}"
        Title="{Binding Title}"
        Height="950" Width="1600" MinHeight="400" MinWidth="700"
        Style="{DynamicResource ThemedWindowStyle}">

    <i:Interaction.Behaviors>
        <local:TitleBarThemingBehavior/>
    </i:Interaction.Behaviors>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:UiModeToVisibilityConverter x:Key="UiModeVisibility"/>

        <!-- Same rotating dashed ring as Show Spread's pending render (Window_BodyTypeSpread.xaml). -->
        <Style x:Key="SampleSpinnerStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Stroke" Value="#FFFFCC40"/>
            <Setter Property="StrokeThickness" Value="4"/>
            <Setter Property="StrokeDashArray" Value="2.4 1.2"/>
            <Setter Property="StrokeDashCap" Value="Round"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard x:Name="SampleSpinnerStoryboard">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360"
                                                 Duration="0:0:1.2"
                                                 RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="SampleSpinnerStoryboard"/>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- One drawn slice: the annotation Panel's cell without the value toggles (front-or-back +
             side images, label, HD, 3D, caption; clicking the images loads the slice in the editor's
             live viewer). -->
        <DataTemplate x:Key="SampleCellTemplate" DataType="{x:Type local:VM_DescriptorSampleCell}">
            <Border Margin="3" Padding="3"
                    Width="{Binding DataContext.CellWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                    Background="{DynamicResource SecondaryBackground}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,3,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="HD" Margin="4,0,0,0" Padding="3,0" VerticalAlignment="Center" Foreground="Firebrick" Command="{Binding HideAndDisableCommand}" CommandParameter="{Binding}" local:DocTooltip.Key="BodySlides.HideAndDisableListButton"/>
                            <Button DockPanel.Dock="Right" Content="3D" Margin="4,0,0,0" Padding="3,0" VerticalAlignment="Center" Command="{Binding OpenIn3DCommand}" local:DocTooltip.Key="BodyTypeSpread.OpenIn3D"/>
                            <TextBlock Text="{Binding PresetLabel}" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding PresetLabel}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Caption}" Foreground="{DynamicResource SecondaryForeground}"
                                   TextTrimming="CharacterEllipsis" FontSize="11" ToolTip="{Binding Caption}"/>
                    </StackPanel>
                    <UniformGrid Columns="2" Cursor="Hand" Background="Transparent"
                                 Height="{Binding DataContext.CellImageHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                 local:DocTooltip.Key="DescriptorSample.Cell">
                        <UniformGrid.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding LoadInViewerCommand}"/>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding LoadInViewerFreeCommand}"/>
                        </UniformGrid.InputBindings>
                        <Grid>
                            <Image Source="{Binding PrimaryImage}" Stretch="Uniform"/>
                            <Ellipse Style="{StaticResource SampleSpinnerStyle}"
                                     Visibility="{Binding IsPrimaryLoading, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="Render failed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForeground}"
                                       Visibility="{Binding IsPrimaryFailed, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                        <Grid>
                            <Image Source="{Binding SideImage}" Stretch="Uniform"/>
                            <Ellipse Style="{StaticResource SampleSpinnerStyle}"
                                     Visibility="{Binding IsSideLoading, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="Render failed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryForeground}"
                                       Visibility="{Binding IsSideFailed, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </UniformGrid>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="6">
        <!-- Sample controls -->
        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Sample size:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <xctk:IntegerUpDown Width="70" Minimum="1" Maximum="5000" Increment="10" VerticalAlignment="Center" Margin="0,0,8,0"
                                Value="{Binding SampleSize}"
                                local:DocTooltip.Key="DescriptorSample.SampleSize"/>
            <Button Content="Reshuffle" Command="{Binding ReshuffleCommand}" Padding="6,2" VerticalAlignment="Center" Margin="0,0,14,0"
                    local:DocTooltip.Key="DescriptorSample.Reshuffle"/>
            <CheckBox Content="One per preset" IsChecked="{Binding OnePerPreset}"
                      VerticalAlignment="Center" Margin="0,0,14,0"
                      local:DocTooltip.Key="DescriptorSample.OnePerPreset"/>
            <CheckBox Content="Ignore Manual Annotations" IsChecked="{Binding IgnoreManualAnnotations}"
                      VerticalAlignment="Center" Margin="0,0,14,0"
                      Visibility="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeVisibility}, ConverterParameter=Customize}"
                      local:DocTooltip.Key="DescriptorSample.IgnoreManualAnnotations"/>
        </WrapPanel>

        <!-- Display controls (as in the annotation Panel) -->
        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="Metric:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox Width="300" VerticalAlignment="Center" Margin="0,0,14,0"
                      ItemsSource="{Binding Metrics}"
                      DisplayMemberPath="Display"
                      SelectedValuePath="Name"
                      SelectedValue="{Binding SelectedMetric}"
                      local:DocTooltip.Key="DescriptorSample.Metric"/>
            <CheckBox Content="Back view" IsChecked="{Binding ShowBack}"
                      VerticalAlignment="Center" Margin="0,0,14,0"
                      local:DocTooltip.Key="BodyTypeSpread.ShowBack"/>
            <TextBlock Text="Resolution:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox Width="56" VerticalAlignment="Center" Margin="0,0,14,0"
                      ItemsSource="{Binding ResolutionScales}"
                      SelectedItem="{Binding ResolutionScale}"
                      ItemStringFormat="{}{0}x"
                      local:DocTooltip.Key="BodyTypeSpread.Resolution"/>
            <CheckBox Content="Show measurements" IsChecked="{Binding ShowMeasurements}"
                      VerticalAlignment="Center" Margin="0,0,14,0"
                      local:DocTooltip.Key="AnnotationPanel.ShowMeasurements"/>
            <CheckBox Content="Show values" IsChecked="{Binding ShowValues}"
                      VerticalAlignment="Center" Margin="0,0,14,0"
                      local:DocTooltip.Key="DescriptorSample.ShowValues"/>
            <TextBlock Text="Per page:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <xctk:IntegerUpDown Width="60" Minimum="1" Maximum="1000" Increment="12" VerticalAlignment="Center" Margin="0,0,14,0"
                                Value="{Binding CellsPerPage}"
                                IsEnabled="{Binding CanSetCellsPerPage}"
                                local:DocTooltip.Key="AnnotationPanel.CellsPerPage"/>
            <Button Content="&lt; Prev" Command="{Binding PrevPageCommand}" Padding="6,2" VerticalAlignment="Center"
                    local:DocTooltip.Key="AnnotationPanel.Paging"/>
            <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Margin="8,0"/>
            <Button Content="Next &gt;" Command="{Binding NextPageCommand}" Padding="6,2" VerticalAlignment="Center" Margin="0,0,14,0"
                    local:DocTooltip.Key="AnnotationPanel.Paging"/>
            <Button Content="Copy Order" Command="{Binding CopyOrderCommand}" Padding="6,2" VerticalAlignment="Center" Margin="0,0,6,0"
                    local:DocTooltip.Key="DescriptorSample.CopyOrder"/>
            <TextBlock Text="{Binding CopyStatus}" VerticalAlignment="Center" Margin="0,0,14,0"
                       Foreground="{DynamicResource SecondaryForeground}"/>
            <TextBlock Text="{Binding RenderStatus}" FontStyle="Italic" VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryForeground}"/>
        </WrapPanel>

        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Foreground="{DynamicResource SecondaryForeground}">
            <Run Text="{Binding Summary, Mode=OneWay}"/><Run Text=" - low to high, left to right. Images: "/><Run Text="{Binding PrimaryViewLabel, Mode=OneWay}"/><Run Text=" + Side."/>
        </TextBlock>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      PreviewMouseWheel="OnCellsPreviewMouseWheel">
            <!-- Drag-and-drop reordering is live only in the Free sort mode. -->
            <ItemsControl ItemsSource="{Binding Cells}" ItemTemplate="{StaticResource SampleCellTemplate}"
                          dd:DragDrop.IsDragSource="{Binding IsFreeOrder}"
                          dd:DragDrop.IsDropTarget="{Binding IsFreeOrder}"
                          dd:DragDrop.DropHandler="{Binding}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
