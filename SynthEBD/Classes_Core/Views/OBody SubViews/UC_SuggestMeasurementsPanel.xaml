<UserControl x:Class="SynthEBD.UC_SuggestMeasurementsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SynthEBD"
             d:DataContext="{d:DesignInstance Type=local:VM_SuggestMeasurementsPanel}"
             mc:Ignorable="d"
             d:DesignHeight="240" d:DesignWidth="900">
    <DockPanel>
        <!-- Action bar: algorithm picker + Suggest / Clear buttons + status. -->
        <Border DockPanel.Dock="Top" Background="#FF2A2A2A" Padding="6,4" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Algorithm:" Foreground="#FFCCCCCC"
                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Grid.Column="1" MinWidth="160"
                          ItemsSource="{Binding AvailableAlgorithms}"
                          SelectedItem="{Binding SelectionAlgorithm, Mode=TwoWay}"
                          local:DocTooltip.Key="BodyTypeProfiles.SuggestAlgorithm"/>
                <Button Grid.Column="2" Content="Suggest Measurements" Command="{Binding SuggestCommand}"
                        Padding="10,2" Margin="6,0,0,0"/>
                <Button Grid.Column="3" Content="Clear" Command="{Binding ClearCommand}"
                        Padding="10,2" Margin="4,0,0,0"/>
                <TextBlock Grid.Column="4" Text="{Binding Status}" Foreground="#FFCCCCCC"
                           VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- Per-Category suggestion lists. Each Category gets an Expander; rows inside show
             the measurement name, the algorithm score, and a remove button. An "Add" line at
             the bottom of each Category lets the user inject a measurement the algorithm
             missed. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:VM_CategorySuggestionGroup}">
                        <Expander Header="{Binding HeaderDisplay}" IsExpanded="True" Margin="0,0,0,4">
                            <Border BorderBrush="#FF555555" BorderThickness="1" Padding="6">
                                <StackPanel>
                                    <TextBlock Text="{Binding EmptyReason}" Foreground="#FFCC8888" FontStyle="Italic"
                                               TextWrapping="Wrap" Margin="0,0,0,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EmptyReason}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding EmptyReason}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <ItemsControl ItemsSource="{Binding Measurements}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:VM_MeasurementSuggestion}">
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                        <ColumnDefinition Width="36"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding MeasurementName}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ScoreDisplay}"
                                                               VerticalAlignment="Center" Foreground="#FFAAAAAA"
                                                               FontFamily="Consolas" FontSize="11"/>
                                                    <Button Grid.Column="2" Content="X" Padding="4,0"
                                                            Command="{Binding RemoveCommand}"
                                                            local:DocTooltip.Key="BodyTypeProfiles.SuggestRemoveMeasurement"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Add-measurement row. Hidden if no candidates remain. -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AvailableToAdd.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Add: " VerticalAlignment="Center" Foreground="#FFAAAAAA"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding AvailableToAdd}"
                                                  SelectedItem="{Binding SelectedMeasurementToAdd, Mode=TwoWay}"/>
                                        <Button Grid.Column="2" Content="Add" Padding="6,1" Margin="4,0,0,0"
                                                Command="{Binding AddMeasurementCommand}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
