<UserControl x:Class="SynthEBD.UC_BodyTypeProfileEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SynthEBD"
             xmlns:plugins="clr-namespace:Mutagen.Bethesda.WPF.Plugins;assembly=Mutagen.Bethesda.WPF"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             d:DataContext="{d:DesignInstance Type=local:VM_BodyTypeProfileEditor}"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1400">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:EnumDescriptionConverter x:Key="EnumDesc"/>
        <local:EnumShortLabelConverter x:Key="EnumShortLabel"/>

        <!-- Cell-level red wash for any Name cell whose row carries HasDuplicateName=True.
             Shared by both the KeyVertices and Measurements grids (each row VM exposes the
             identically-named bool). CellStyle is used in preference to ElementStyle so the
             highlight spans both display and edit modes — the TextBox that DataGridTextColumn
             swaps in during editing sits on top of the cell background, which stays colored. -->
        <Style x:Key="DuplicateNameCellStyle" TargetType="DataGridCell">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasDuplicateName}" Value="True">
                    <Setter Property="Background" Value="#33FF6B6B"/>
                    <Setter Property="BorderBrush" Value="#FFE53935"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="ToolTip"
                            Value="Duplicate name — downstream resolution is first-wins, so only the first row with this name will be used at evaluation time. Rename one of the rows to remove the ambiguity."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Profile-level warning banner that surfaces above each grid when one or more
             names are duplicated. The caller binds Visibility through BoolToVis on a
             HasDuplicate* bool — earlier attempts used a DataTrigger on the int count
             property, but WPF compares the boxed int to the trigger's string Value via
             int.Equals(string) which always returns false, so the trigger never fired and
             the banner stayed visible at zero. -->
        <Style x:Key="DuplicateNameBannerStyle" TargetType="Border">
            <Setter Property="Background" Value="#33FF6B6B"/>
            <Setter Property="BorderBrush" Value="#FFE53935"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- ComboBox styles for the Measurements grid's vertex-ref columns. Each fires its
             red wash on a different per-row IsRef{A|B|C|D}Valid bool — WPF DataTrigger Value
             doesn't take a parameter, so four styles are required even though their bodies
             are identical except for the bound property. ToolTip surfaces the explanation so
             the user knows the red means "ref doesn't resolve to a current Key Vertex". -->
        <Style x:Key="InvalidRefAComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRefAValid}" Value="False">
                    <Setter Property="Background" Value="#33FF6B6B"/>
                    <Setter Property="BorderBrush" Value="#FFE53935"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="ToolTip" Value="Reference does not match any current Key Vertex name — the source vertex was renamed or deleted. Pick an existing name or fix the typo."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InvalidRefBComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRefBValid}" Value="False">
                    <Setter Property="Background" Value="#33FF6B6B"/>
                    <Setter Property="BorderBrush" Value="#FFE53935"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="ToolTip" Value="Reference does not match any current Key Vertex name — the source vertex was renamed or deleted. Pick an existing name or fix the typo."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InvalidRefCComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRefCValid}" Value="False">
                    <Setter Property="Background" Value="#33FF6B6B"/>
                    <Setter Property="BorderBrush" Value="#FFE53935"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="ToolTip" Value="Reference does not match any current Key Vertex name — the source vertex was renamed or deleted. Pick an existing name or fix the typo."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InvalidRefDComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRefDValid}" Value="False">
                    <Setter Property="Background" Value="#33FF6B6B"/>
                    <Setter Property="BorderBrush" Value="#FFE53935"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="ToolTip" Value="Reference does not match any current Key Vertex name — the source vertex was renamed or deleted. Pick an existing name or fix the typo."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox style for the Rules tab's per-condition MeasurementName combo. Fires
             when the condition references a measurement that no longer exists in the
             profile. -->
        <Style x:Key="InvalidConditionRefComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMeasurementRefValid}" Value="False">
                    <Setter Property="Background" Value="#33FF6B6B"/>
                    <Setter Property="BorderBrush" Value="#FFE53935"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="ToolTip" Value="Reference does not match any current Measurement name — the source measurement was renamed or deleted. Pick an existing name or fix the typo."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Per-row badge for each VM_NamedKeyVertex's ResolutionState. Hard-failure states
             (ShapeNotLoaded, IndexOutOfRange) use the same red as the duplicate-name styles
             so the visual vocabulary stays consistent. NeedsRepick uses amber because the
             row still "renders" — it just renders against stale anatomy after a Capture
             remap. Unknown / no-viewer uses neutral grey. Tooltips spell out the cause +
             remedy so the user doesn't have to guess. -->
        <Style x:Key="ResolutionStateBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#22000000"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ResolutionState}" Value="Resolved">
                    <Setter Property="Background" Value="#338BC34A"/>
                    <Setter Property="ToolTip" Value="Resolved — this key vertex maps to a vertex on the active mesh."/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResolutionState}" Value="ShapeNotLoaded">
                    <Setter Property="Background" Value="#FFE53935"/>
                    <Setter Property="ToolTip" Value="Shape not loaded — no mesh in the active viewer has this Shape name, so overlays and measurements that reference this row will silently skip. Click 'Capture from active viewer' to auto-remap onto the loaded body, or edit the Shape column directly."/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResolutionState}" Value="IndexOutOfRange">
                    <Setter Property="Background" Value="#FFE53935"/>
                    <Setter Property="ToolTip" Value="Index out of range — Shape matched but Vertex Index is past the end of the mesh's vertex buffer. Pick a new vertex or fix the index."/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResolutionState}" Value="NeedsRepick">
                    <Setter Property="Background" Value="#FFFB8C00"/>
                    <Setter Property="ToolTip" Value="Needs re-pick — Capture from active viewer just remapped this row's Shape onto a different body. The stored Vertex Index almost certainly points at unrelated anatomy on the new topology; pick the vertex again on the loaded mesh. The flag clears as soon as you edit the index."/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResolutionState}" Value="Unknown">
                    <Setter Property="Background" Value="#22000000"/>
                    <Setter Property="ToolTip" Value="No active viewer — load a body in the viewer to evaluate this row."/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- TextBlock inside the badge: maps each ResolutionState to a short user-facing
             label. Kept separate from the Border style so the cell template can compose
             them without duplicating the trigger list. -->
        <Style x:Key="ResolutionStateLabelStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Text" Value="?"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ResolutionState}" Value="Resolved">
                    <Setter Property="Text" Value="OK"/>
                    <Setter Property="Foreground" Value="#2E7D32"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResolutionState}" Value="ShapeNotLoaded">
                    <Setter Property="Text" Value="Shape?"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResolutionState}" Value="IndexOutOfRange">
                    <Setter Property="Text" Value="Idx?"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResolutionState}" Value="NeedsRepick">
                    <Setter Property="Text" Value="Re-pick"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResolutionState}" Value="Unknown">
                    <Setter Property="Text" Value="—"/>
                    <Setter Property="Foreground" Value="#666"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Amber-tinted variant of DuplicateNameBannerStyle for the unresolved-KV banner
             above the KeyVertices grid. Amber rather than red so it visually separates from
             the duplicate-name banner when both are active — the user sees two distinct
             problems instead of one merged red bar. -->
        <Style x:Key="UnresolvedKeyVertexBannerStyle" TargetType="Border">
            <Setter Property="Background" Value="#33FFA726"/>
            <Setter Property="BorderBrush" Value="#FFFB8C00"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Region badge: per-row status for each VM_NamedRegion's RegionResolutionState. Mirrors
             ResolutionStateBadgeStyle but keyed on the region states (Resolved / ShapeNotLoaded /
             Invalid / Unknown). The ResolveDiagnostic string is the tooltip so the user reads the
             exact reason ("3 boundary loops found, expected 1") on hover. -->
        <Style x:Key="RegionResolutionStateBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="4,1"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#22000000"/>
            <Setter Property="ToolTip" Value="{Binding ResolveDiagnostic}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ResolutionState}" Value="Resolved">
                    <Setter Property="Background" Value="#338BC34A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResolutionState}" Value="ShapeNotLoaded">
                    <Setter Property="Background" Value="#FFFB8C00"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResolutionState}" Value="Invalid">
                    <Setter Property="Background" Value="#FFE53935"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResolutionState}" Value="Unknown">
                    <Setter Property="Background" Value="#22000000"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RegionResolutionStateLabelStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Text" Value="?"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ResolutionState}" Value="Resolved">
                    <Setter Property="Text" Value="OK"/>
                    <Setter Property="Foreground" Value="#2E7D32"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResolutionState}" Value="ShapeNotLoaded">
                    <Setter Property="Text" Value="Shape?"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResolutionState}" Value="Invalid">
                    <Setter Property="Text" Value="Bad box"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ResolutionState}" Value="Unknown">
                    <Setter Property="Text" Value="—"/>
                    <Setter Property="Foreground" Value="#666"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="480"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="420" MinWidth="220"/>
        </Grid.ColumnDefinitions>

        <!-- Top profile toolbar: title, profile selector, profile-management buttons.
             Lives above all three columns so the left rail it replaces can be reclaimed
             by the middle pane. The ListBox-of-profiles collapses into a ComboBox here
             because a visible list in a horizontal bar would waste either width (always
             showing every row) or height (wrapping). -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                BorderBrush="Gray" BorderThickness="0,0,0,1"
                Padding="0,0,0,5" Margin="0,0,0,5">
            <!-- DockPanel (not StackPanel) so the Keyboard Shortcuts button can sit
                 right-justified at the far end of the row while the existing
                 ComboBox + Add/Delete/Duplicate/Export/Import buttons keep their
                 left-aligned horizontal flow. LastChildFill=False because we want
                 the right-docked button to keep its natural width rather than
                 expanding to fill the gap between it and the import button. -->
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Keyboard Shortcuts"
                        Click="KeyboardShortcuts_Click" Padding="8,1"
                        ToolTip="Lists every keyboard shortcut available in this menu, broken down per tab plus the global preset-iteration shortcuts."/>
                <TextBlock Text="Body Type Profiles:" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding SelectedProfile}"
                          DisplayMemberPath="Name"
                          MinWidth="220" Margin="0,0,12,0"
                          VerticalAlignment="Center"/>
                <Button Content="Add" Command="{Binding AddProfile}" Padding="6,1" Margin="0,0,4,0"/>
                <Button Content="Delete" Command="{Binding DeleteSelectedProfile}" Padding="6,1" Margin="0,0,4,0"/>
                <Button Content="Duplicate" Command="{Binding DuplicateSelectedProfile}" Padding="6,1" Margin="0,0,12,0"
                        ToolTip="Clones the selected profile in place — equivalent to Export then Import without the disk round-trip. The copy gets a fresh Id and a default '&lt;name&gt; - copy' name (with a numeric suffix if that's already taken)."/>
                <Button Content="Export" Command="{Binding ExportSelectedProfile}" Padding="6,1" Margin="0,0,4,0"
                        ToolTip="Save the selected profile to a JSON file for sharing or backup."/>
                <Button Content="Import" Command="{Binding ImportProfile}" Padding="6,1"
                        ToolTip="Load a profile from a JSON file and append it to this list."/>
            </DockPanel>
        </Border>

        <!-- Resizable splitter between the profile panel and the embedded viewer. -->
        <GridSplitter Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" Background="#333333"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                      ShowsPreview="True"
                      ToolTip="Drag to resize the preview viewer"/>

        <!-- Right rail: embedded CharacterViewer + searchable preset picker. Lets the user
             load any BodySlide preset and pick key vertices without leaving this menu. -->
        <DockPanel Grid.Row="1" Grid.Column="2" Margin="5,0,0,0">
            <Border DockPanel.Dock="Top" Background="#FF2A2A2A" Padding="6,4" Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Gender:" Foreground="#FFCCCCCC" Margin="0,0,5,2" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,2"
                              ItemsSource="{Binding Source={local:EnumBindingSource {x:Type local:Gender}}}"
                              SelectedValue="{Binding PreviewGender}"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="Refresh" Command="{Binding RefreshPresetList}" Padding="6,1" Margin="5,0,0,2"
                            ToolTip="Rebuild the preset dropdown from the BodySlides menu."/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Filter:" Foreground="#FFCCCCCC" Margin="0,0,5,2" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,2"
                             Text="{Binding PresetFilterText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Type to filter the preset list by substring match on Label."/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Preset:" Foreground="#FFCCCCCC" Margin="0,0,5,2" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                              ItemsSource="{Binding FilteredPresets}"
                              SelectedItem="{Binding SelectedPreset}"
                              DisplayMemberPath="Label"
                              IsTextSearchEnabled="True"
                              TextSearch.TextPath="Label"
                              MaxDropDownHeight="400"
                              Margin="0,0,0,2"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Weight:" Foreground="#FFCCCCCC" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="3" Grid.Column="1"
                              ItemsSource="{Binding AvailableWeights}"
                              SelectedItem="{Binding PreviewWeight}"/>
                    <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" Margin="5,0,0,0">
                        <TextBlock Text="NPC:" Foreground="#FFCCCCCC" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <plugins:FormKeyPicker FormKey="{Binding PreviewNpcOverride, Mode=TwoWay}"
                                               LinkCache="{Binding lk}"
                                               ScopedTypes="{Binding NPCPickerFormKeys}"
                                               MaxHeight="180" MinWidth="180"
                                               ToolTip="Override the preview NPC. Leave blank to use the weight-based default from OBody preview settings."/>
                    </StackPanel>
                </Grid>
            </Border>
            <local:UC_CharacterViewer DataContext="{Binding CharacterViewer}" MinHeight="400"/>
        </DockPanel>

        <!-- Middle pane: tabs for the active profile -->
        <ContentControl Grid.Row="1" Grid.Column="0" Content="{Binding SelectedProfile}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="{x:Type local:VM_BodyTypeProfile}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Profile metadata -->
                        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="0,0,0,5" Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Body Type:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="0" Grid.Column="3"
                                          ItemsSource="{Binding AvailableBodyTypeNames}"
                                          IsEditable="True"
                                          Text="{Binding BodyTypeName, UpdateSourceTrigger=PropertyChanged}"/>

                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock Text="Topology fingerprint:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="vertex count =" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding FingerprintVertexCount, UpdateSourceTrigger=PropertyChanged}" Width="80" Margin="0,0,10,0"/>
                                    <TextBlock Text="per-shape:" Margin="0,0,3,0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding FingerprintShapeCounts, UpdateSourceTrigger=PropertyChanged}" Width="280" Margin="0,0,10,0"/>
                                    <Button Content="Capture from active viewer" Command="{Binding CaptureFingerprintFromActiveViewer}" Padding="6,1"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Three panels: KeyVertices / Measurements / Rules / Suggest -->
                        <TabControl Grid.Row="1" SelectionChanged="ProfileTabControl_SelectionChanged">

                            <TabItem Header="Key Vertices">
                                <DockPanel>
                                    <!-- Developer convenience:
                                         Ctrl+S  → writes the current KeyVertices to a JSON file
                                                   ({ "IsPatch": ..., "KeyVertices": [...] }). Smart-mode:
                                                   no rows selected (or all rows selected) writes a full
                                                   snapshot (IsPatch=false). A strict subset selection
                                                   writes a patch (IsPatch=true) containing only those
                                                   rows; the default filename gets a "_patch" suffix.
                                         Ctrl+L  → parses the same shape and either wholesale-replaces
                                                   the current KeyVertices (legacy / IsPatch=false, with
                                                   a confirmation if any exist) or applies the patch by
                                                   Name (IsPatch=true, add-or-replace; original row index
                                                   preserved on hit). -->
                                    <DockPanel.InputBindings>
                                        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveKeyVerticesToJson}"/>
                                        <KeyBinding Modifiers="Control" Key="L" Command="{Binding LoadKeyVerticesFromJson}"/>
                                    </DockPanel.InputBindings>
                                    <Border DockPanel.Dock="Top"
                                            Style="{StaticResource DuplicateNameBannerStyle}"
                                            Visibility="{Binding HasDuplicateKeyVertexNames, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Foreground="#FFC62828" FontWeight="SemiBold"
                                                   Text="{Binding DuplicateKeyVertexCount, StringFormat='{}{0} duplicate key-vertex name(s) detected — only the first row with each name is used at evaluation time. Rename or delete the highlighted rows to remove the ambiguity.'}"/>
                                    </Border>
                                    <Border DockPanel.Dock="Top"
                                            Style="{StaticResource UnresolvedKeyVertexBannerStyle}"
                                            Visibility="{Binding HasUnresolvedKeyVertices, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Foreground="#E65100" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Text="{Binding UnresolvedKeyVertexCount, StringFormat='{}{0} key-vertex row(s) can''t be resolved on the active mesh — preview markers, picks, and any measurement that references them will be silently skipped. See the Status column on each row for the cause (hover for tooltip).'}"/>
                                    </Border>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,5">
                                        <CheckBox Content="Capture picks from viewer"
                                                  IsChecked="{Binding CapturePicks}"
                                                  VerticalAlignment="Center"
                                                  ToolTip="When enabled, every pick made in the viewer is appended to this profile's Key Vertices automatically. Toggle Pick Vertex on the viewer toolbar to start picking."/>
                                        <Button Content="Capture Selected Picks"
                                                Command="{Binding CaptureSelectedPicks}"
                                                Margin="10,0,0,0" Padding="6,1"
                                                ToolTip="Imports the picks currently highlighted in the viewer's pick list as Key Vertex rows. Picks already in this profile (same shape and vertex index) are skipped. Works even when 'Capture picks from viewer' is off."/>
                                        <Button Content="Show picks in viewer"
                                                Command="{Binding ShowPicksInViewer}"
                                                Margin="10,0,0,0" Padding="6,1"
                                                ToolTip="Sends this profile's Key Vertices to the viewer as pick markers so they can be re-visualized in a new session. References that don't resolve on the current mesh are silently skipped."/>
                                        <Button Content="Remove Selected" Command="{Binding RemoveSelectedKeyVertex}" Margin="15,0,0,0" Padding="6,1"/>
                                    </StackPanel>
                                    <DataGrid x:Name="KeyVerticesGrid"
                                              ItemsSource="{Binding KeyVertices}"
                                              SelectedItem="{Binding SelectedKeyVertex}"
                                              SelectionMode="Extended"
                                              SelectionChanged="KeyVerticesGrid_SelectionChanged"
                                              CellEditEnding="NameCell_EditEnding"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              RowHeaderWidth="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name"
                                                                Binding="{Binding Name}"
                                                                Width="160"
                                                                CellStyle="{StaticResource DuplicateNameCellStyle}"/>
                                            <DataGridTemplateColumn Header="Status" Width="70" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource ResolutionStateBadgeStyle}">
                                                            <TextBlock Style="{StaticResource ResolutionStateLabelStyle}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Shape" Binding="{Binding ShapeName, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                            <DataGridTemplateColumn Header="Strategy" Width="110">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox SelectedValue="{Binding Strategy, UpdateSourceTrigger=PropertyChanged}"
                                                                  ItemsSource="{Binding Source={local:EnumBindingSource {x:Type local:KeyVertexStrategy}}}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Vertex Index" Binding="{Binding VertexIndex, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                            <!-- Criterion picker: closed button shows the short [DisplayName] of the
                                                 current criterion with its long [Description] as tooltip; clicking the
                                                 button opens a Popup containing a TreeView grouped by algorithm category
                                                 (Axis Extremes / Mirrored Across Midline / Waist Pinch / Hip Bulge /
                                                 Paired / Centerline-Anchored). The tree's structure lives in
                                                 BoundingBoxCriterionTree.Categories; per-leaf labels and tooltips come
                                                 from the enum's [DisplayName] and [Description] attributes via reflection
                                                 — single source of truth. TreeView.Tag carries the row VM so the
                                                 SelectedItemChanged handler in code-behind can write Criterion back
                                                 without coupling to the surrounding DataGrid's selected row. -->
                                            <DataGridTemplateColumn Header="Criterion" Width="170">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <ToggleButton x:Name="CritToggle"
                                                                          Content="{Binding Criterion, Converter={StaticResource EnumShortLabel}}"
                                                                          ToolTip="{Binding Criterion, Converter={StaticResource EnumDesc}}"
                                                                          HorizontalContentAlignment="Stretch"
                                                                          VerticalContentAlignment="Center"
                                                                          Padding="4,1"/>
                                                            <Popup IsOpen="{Binding IsChecked, ElementName=CritToggle, Mode=TwoWay}"
                                                                   PlacementTarget="{Binding ElementName=CritToggle}"
                                                                   Placement="Bottom"
                                                                   StaysOpen="False"
                                                                   AllowsTransparency="True">
                                                                <Border Background="#FF2A2A2A" BorderBrush="Gray" BorderThickness="1" Padding="4">
                                                                    <TreeView ItemsSource="{x:Static local:BoundingBoxCriterionTree.Categories}"
                                                                              Tag="{Binding}"
                                                                              SelectedItemChanged="CriterionTree_SelectedItemChanged"
                                                                              MinWidth="380" MaxHeight="520"
                                                                              Background="Transparent" BorderThickness="0">
                                                                        <TreeView.Resources>
                                                                            <HierarchicalDataTemplate DataType="{x:Type local:BoundingBoxCriterionCategory}"
                                                                                                      ItemsSource="{Binding Children}">
                                                                                <TextBlock Text="{Binding Header}" FontWeight="SemiBold"
                                                                                           ToolTip="{Binding Description}" TextWrapping="NoWrap"/>
                                                                            </HierarchicalDataTemplate>
                                                                            <DataTemplate DataType="{x:Type local:BoundingBoxCriterionLeaf}">
                                                                                <TextBlock Text="{Binding Label}" ToolTip="{Binding Description}" TextWrapping="NoWrap"/>
                                                                            </DataTemplate>
                                                                        </TreeView.Resources>
                                                                    </TreeView>
                                                                </Border>
                                                            </Popup>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Box (min / max)" Width="240">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontFamily="Consolas" FontSize="10" VerticalAlignment="Center">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="({0:F1},{1:F1},{2:F1}) / ({3:F1},{4:F1},{5:F1})">
                                                                    <Binding Path="BoxMinX"/>
                                                                    <Binding Path="BoxMinY"/>
                                                                    <Binding Path="BoxMinZ"/>
                                                                    <Binding Path="BoxMaxX"/>
                                                                    <Binding Path="BoxMaxY"/>
                                                                    <Binding Path="BoxMaxZ"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Width="40">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="X" Command="{Binding DeleteCommand}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="Regions">
                                <DockPanel>
                                    <DockPanel.InputBindings>
                                        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoRegionEditCommand}"/>
                                        <KeyBinding Modifiers="Control" Key="Y" Command="{Binding RedoRegionEditCommand}"/>
                                    </DockPanel.InputBindings>
                                    <Border DockPanel.Dock="Top"
                                            Style="{StaticResource DuplicateNameBannerStyle}"
                                            Visibility="{Binding HasDuplicateRegionNames, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Foreground="#FFC62828" FontWeight="SemiBold"
                                                   Text="{Binding DuplicateRegionCount, StringFormat='{}{0} duplicate region name(s) detected — only the first row with each name is used at evaluation time. Rename or delete the highlighted rows.'}"/>
                                    </Border>
                                    <Border DockPanel.Dock="Top"
                                            Style="{StaticResource UnresolvedKeyVertexBannerStyle}"
                                            Visibility="{Binding HasUnresolvedRegions, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Foreground="#E65100" FontWeight="SemiBold" TextWrapping="Wrap"
                                                   Text="{Binding UnresolvedRegionCount, StringFormat='{}{0} region(s) don''t resolve to a valid volume on the active mesh — any RegionVolume measurement that references them is skipped. See the Status column (hover for the reason).'}"/>
                                    </Border>
                                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,4" Foreground="#FFBBBBBB" FontSize="11"
                                               Text="Author a region by drawing a box in the viewer (Pick Box), then clicking 'Confirm as Region' on the pending-box panel. A region selects a body patch whose enclosed volume a RegionVolume measurement integrates. Expected Caps: 1 for a chest bump, 2 for a limb segment, blank to accept any valid count."/>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,2,0,4">
                                        <TextBlock Text="Viewer display:" VerticalAlignment="Center" Foreground="#FFBBBBBB" FontSize="11" Margin="0,0,6,0"/>
                                        <ComboBox SelectedItem="{Binding RegionViewMode, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemsSource="{Binding RegionViewModeOptions}"
                                                  Width="120"
                                                  ToolTip="How the selected region is drawn in the viewer. End-Cap: just the cyan cut contour. Solid: the whole region as a magenta filled object, visible through the body from any angle, with cyan vertices + edges on top."/>
                                        <Separator Margin="10,0" Background="#FF555555"/>
                                        <Button Content="↶ Undo" FontSize="11" Padding="8,2" Margin="0,0,4,0"
                                                Command="{Binding UndoRegionEditCommand}"
                                                ToolTip="Undo the last vertex add/remove on the selected region (a click or a lasso = one action; up to 50 steps). Ctrl+Z."/>
                                        <Button Content="↷ Redo" FontSize="11" Padding="8,2"
                                                Command="{Binding RedoRegionEditCommand}"
                                                ToolTip="Redo the last undone vertex edit on the selected region. Ctrl+Y."/>
                                    </StackPanel>
                                    <DataGrid x:Name="RegionsGrid"
                                              ItemsSource="{Binding Regions}"
                                              SelectedItem="{Binding SelectedRegion}"
                                              SelectionMode="Single"
                                              SelectionChanged="RegionsGrid_SelectionChanged"
                                              CellEditEnding="NameCell_EditEnding"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              RowHeaderWidth="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name"
                                                                Binding="{Binding Name}"
                                                                Width="160"
                                                                CellStyle="{StaticResource DuplicateNameCellStyle}"/>
                                            <DataGridTemplateColumn Header="Status" Width="80" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource RegionResolutionStateBadgeStyle}">
                                                            <TextBlock Style="{StaticResource RegionResolutionStateLabelStyle}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Shape" Binding="{Binding ShapeName, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                            <DataGridTextColumn Header="Expected Caps"
                                                                Binding="{Binding ExpectedCapCount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                                                Width="100"
                                                                ElementStyle="{StaticResource {x:Type TextBlock}}"/>
                                            <DataGridTemplateColumn Header="Cap" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox SelectedItem="{Binding CapMode, UpdateSourceTrigger=PropertyChanged}"
                                                                  ItemsSource="{Binding CapModeOptions}"
                                                                  ToolTip="How the loop is closed (and what the volume means): FlatPlane = tissue protruding past a flat plane (a 'salami cut', no scoop). AnatomicalFan = enclosed by the deformed ring (lid follows the ring, can look scooped on a curvy bust)."/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Defined On"
                                                                Binding="{Binding DefiningPresetDisplay, Mode=OneWay}"
                                                                Width="170" IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="ToolTip" Value="The preset + weight the box was drawn against. The box is stored in undeformed (sliders-0) space; this records the authoring context so you can reload it to re-edit."/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTemplateColumn Header="Box (min / max)" Width="240" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontFamily="Consolas" FontSize="10" VerticalAlignment="Center">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="({0:F1},{1:F1},{2:F1}) / ({3:F1},{4:F1},{5:F1})">
                                                                    <Binding Path="BoxMinX"/>
                                                                    <Binding Path="BoxMinY"/>
                                                                    <Binding Path="BoxMinZ"/>
                                                                    <Binding Path="BoxMaxX"/>
                                                                    <Binding Path="BoxMaxY"/>
                                                                    <Binding Path="BoxMaxZ"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Rotation (X / Y / Z °)" Width="180">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    ToolTip="Box rotation about its center, degrees. 0/0/0 = axis-aligned. Use to tilt the cut plane onto a feature that isn't square to the body axes.">
                                                            <xctk:SingleUpDown Value="{Binding RotX, UpdateSourceTrigger=PropertyChanged}" Increment="5" FormatString="F0" Width="48"
                                                                               Foreground="Black" Background="White"/>
                                                            <xctk:SingleUpDown Value="{Binding RotY, UpdateSourceTrigger=PropertyChanged}" Increment="5" FormatString="F0" Width="48"
                                                                               Foreground="Black" Background="White"/>
                                                            <xctk:SingleUpDown Value="{Binding RotZ, UpdateSourceTrigger=PropertyChanged}" Increment="5" FormatString="F0" Width="48"
                                                                               Foreground="Black" Background="White"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Vertex Edits" Width="120" IsReadOnly="True">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                                    ToolTip="Hand-curated add/remove vertex edits layered on the box. Non-zero means this region resolves by the vertex-granular induced patch (box ∪ adds \ removes) instead of the smooth box clip. Select the row, enable 'Edit Region Verts' in the viewer toolbar, then click/drag vertices. 'Clear' reverts to the plain box.">
                                                            <TextBlock Foreground="#FFFF66CC" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding EditedVertexCount, StringFormat='✎ {0}'}"
                                                                       Visibility="{Binding HasVertexEdits, Converter={StaticResource BoolToVis}}"/>
                                                            <Button Content="Clear" FontSize="10" Margin="6,0,0,0" Padding="4,0"
                                                                    Command="{Binding ClearEditsCommand}"
                                                                    Visibility="{Binding HasVertexEdits, Converter={StaticResource BoolToVis}}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Width="40">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="X" Command="{Binding DeleteCommand}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="Measurements">
                                <DockPanel>
                                    <!-- Developer convenience shortcuts, scoped to this tab's DockPanel
                                         so they only fire while focus is inside the Measurements tab.
                                           Ctrl+S            → save full JSON snapshot ({ "IsPatch": false,
                                                               "Measurements": [...] }) — uniform with the
                                                               KeyVertices and Rules tabs.
                                           Ctrl+L            → load JSON. Auto-detects IsPatch: legacy /
                                                               IsPatch=false replaces the current
                                                               Measurements (confirm dialog if non-empty);
                                                               IsPatch=true adds-or-replaces by Name in place.
                                           Ctrl+Shift+P      → patch export: write only the rows currently
                                                               selected in the grid, flagged IsPatch=true.
                                                               Requires at least one row selected.
                                           Ctrl+Shift+S      → secondary export: CSV file including the
                                                               live-evaluated LiveValue column for
                                                               spreadsheet analysis.
                                           Ctrl+C            → copy the same table as TSV onto the clipboard
                                                               for direct paste into Excel / Sheets.
                                           Ctrl+Alt+Shift+S  → cumulative CSV across every (preset, weight)
                                                               target — one row per slice, one column per
                                                               measurement. Drives a scan first if the cache
                                                               isn't already complete. -->
                                    <DockPanel.InputBindings>
                                        <KeyBinding Modifiers="Control"           Key="S" Command="{Binding SaveMeasurementsToJson}"/>
                                        <KeyBinding Modifiers="Control"           Key="L" Command="{Binding LoadMeasurementsFromJson}"/>
                                        <KeyBinding Modifiers="Control+Shift"     Key="P" Command="{Binding SaveMeasurementsPatchToJson}"/>
                                        <KeyBinding Modifiers="Control+Shift"     Key="S" Command="{Binding SaveMeasurementsToCsv}"/>
                                        <KeyBinding Modifiers="Control"           Key="C" Command="{Binding CopyMeasurementsToClipboard}"/>
                                        <KeyBinding Modifiers="Control+Alt+Shift" Key="S" Command="{Binding SaveAllMeasurementsToCsv}"/>
                                        <KeyBinding Modifiers="Control+Shift"     Key="H" Command="{Binding SaveAllMeasurementHistogramsToCsv}"/>
                                    </DockPanel.InputBindings>
                                    <Border DockPanel.Dock="Top"
                                            Style="{StaticResource DuplicateNameBannerStyle}"
                                            Visibility="{Binding HasDuplicateMeasurementNames, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Foreground="#FFC62828" FontWeight="SemiBold"
                                                   Text="{Binding DuplicateMeasurementCount, StringFormat='{}{0} duplicate measurement name(s) detected — only the first row with each name is used at evaluation time. Rename or delete the highlighted rows to remove the ambiguity.'}"/>
                                    </Border>
                                    <Button DockPanel.Dock="Top" Content="Add Measurement" Command="{Binding AddMeasurement}"
                                            HorizontalAlignment="Left" Padding="6,2" Margin="0,5"/>
                                    <DataGrid x:Name="MeasurementsGrid"
                                              ItemsSource="{Binding Measurements}"
                                              SelectedItem="{Binding SelectedMeasurement}"
                                              SelectionMode="Extended"
                                              SelectionChanged="MeasurementsGrid_SelectionChanged"
                                              CellEditEnding="NameCell_EditEnding"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                              ClipboardCopyMode="None"
                                              RowHeaderWidth="0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name"
                                                                Binding="{Binding Name}"
                                                                Width="160"
                                                                CellStyle="{StaticResource DuplicateNameCellStyle}"/>
                                            <DataGridTemplateColumn Header="Kind" Width="140">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox SelectedValue="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                                                  ItemsSource="{Binding Source={local:EnumBindingSource {x:Type local:MeasurementKind}}}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="A" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding AvailableKeyVertexNames}" IsEditable="True"
                                                                  Text="{Binding VertexRefA, UpdateSourceTrigger=PropertyChanged}"
                                                                  Style="{StaticResource InvalidRefAComboBoxStyle}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="B" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding AvailableKeyVertexNames}" IsEditable="True"
                                                                  Text="{Binding VertexRefB, UpdateSourceTrigger=PropertyChanged}"
                                                                  Style="{StaticResource InvalidRefBComboBoxStyle}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Region" Width="140">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding AvailableRegionNames}" IsEditable="True"
                                                                  IsEnabled="{Binding ShowRegionField}"
                                                                  Text="{Binding RegionRefName, UpdateSourceTrigger=PropertyChanged}"
                                                                  ToolTip="RegionVolume only: the region whose enclosed volume this measurement integrates. Author regions on the Regions tab."/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="C (Ratio)" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding AvailableKeyVertexNames}" IsEditable="True"
                                                                  IsEnabled="{Binding ShowSecondPair}"
                                                                  Text="{Binding VertexRefC, UpdateSourceTrigger=PropertyChanged}"
                                                                  Style="{StaticResource InvalidRefCComboBoxStyle}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="D (Ratio)" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding AvailableKeyVertexNames}" IsEditable="True"
                                                                  IsEnabled="{Binding ShowSecondPair}"
                                                                  Text="{Binding VertexRefD, UpdateSourceTrigger=PropertyChanged}"
                                                                  Style="{StaticResource InvalidRefDComboBoxStyle}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Axis" Width="140">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding AxisOptionsList}"
                                                                  SelectedValuePath="Value"
                                                                  DisplayMemberPath="Label"
                                                                  SelectedValue="{Binding Axis, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding ShowAxisField}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Num Axis" Width="140"
                                                                    Visibility="Visible">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding RatioAxisOptionsList}"
                                                                  SelectedValuePath="Value"
                                                                  DisplayMemberPath="Label"
                                                                  SelectedValue="{Binding NumeratorAxis, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding ShowSecondPair}"
                                                                  ToolTip="RatioDistance only: how to reduce the numerator pair (A, B). 3D = legacy Euclidean length; X/Y/Z = projection onto that axis."/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Denom Axis" Width="140">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding RatioAxisOptionsList}"
                                                                  SelectedValuePath="Value"
                                                                  DisplayMemberPath="Label"
                                                                  SelectedValue="{Binding DenominatorAxis, UpdateSourceTrigger=PropertyChanged}"
                                                                  IsEnabled="{Binding ShowSecondPair}"
                                                                  ToolTip="RatioDistance only: how to reduce the denominator pair (C, D). 3D = legacy Euclidean length; X/Y/Z = projection onto that axis."/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Live" Binding="{Binding LiveValue, Mode=OneWay, StringFormat=F3}" Width="80" IsReadOnly="True"/>
                                            <DataGridTemplateColumn Width="40">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="H" Command="{Binding OpenHistogramCommand}"
                                                                ToolTip="Open a histogram of this measurement's values across every (preset, weight) entry in the profile's cache. Triggers a scan first if the measurement cache is stale."/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Width="40">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="X" Command="{Binding DeleteCommand}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="Rules">
                                <Grid>
                                    <!-- Developer convenience:
                                         Ctrl+S            → write the current rules to a full JSON snapshot
                                                             ({ "IsPatch": false, "Rules": [...], "RulesToDelete": [] }).
                                                             Compatible with the Revised_BodyTypeProfile_Rules.json
                                                             reference. Documentation __comment_* fields are
                                                             tolerated on load.
                                         Ctrl+L            → load JSON. Auto-detects IsPatch: legacy /
                                                             IsPatch=false wholesale-replaces (confirm dialog
                                                             if rules exist); IsPatch=true applies the patch by
                                                             Id — deletes RulesToDelete entries first, then
                                                             adds-or-replaces by Id (original row index preserved
                                                             on hit). Distinct "Apply patch?" confirmation.
                                         Ctrl+Shift+P      → patch export: writes every rule under the currently-
                                                             selected TreeView node (Category node = all rules in
                                                             that category; Value node = exact descriptor match)
                                                             with IsPatch=true, empty RulesToDelete.
                                         Ctrl+Shift+Alt+P  → patch export with deletes: opens a picker window
                                                             pre-seeded with the same tree-node set as the
                                                             add/edit list, plus a delete-mark checkbox per
                                                             rule. On OK, writes IsPatch=true with both the
                                                             refined add/edit list and the deletion Ids. -->
                                    <Grid.InputBindings>
                                        <KeyBinding Modifiers="Control"           Key="S" Command="{Binding SaveRulesToJson}"/>
                                        <KeyBinding Modifiers="Control"           Key="L" Command="{Binding LoadRulesFromJson}"/>
                                        <KeyBinding Modifiers="Control+Shift"     Key="P" Command="{Binding SaveRulesPatchToJson}"/>
                                        <KeyBinding Modifiers="Control+Shift+Alt" Key="P" Command="{Binding SaveRulesPatchWithDeletesToJson}"/>
                                    </Grid.InputBindings>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" MinWidth="200"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left pane: tree of TemplateDescriptors (Category -> Value),
                                         inline Add-Descriptor form, Delete-selected-node button. -->
                                    <DockPanel Grid.Column="0">
                                        <TextBlock DockPanel.Dock="Top" Text="Descriptor catalog"
                                                   FontWeight="Bold" Margin="0,5,0,3"/>
                                        <Grid DockPanel.Dock="Bottom" Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Add descriptor:"
                                                       FontStyle="Italic" Margin="0,0,0,2"/>
                                            <TextBox Grid.Row="1" Grid.Column="0"
                                                     Text="{Binding NewCategoryInput, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Category name. New categories get created on Add; pick an existing name to add a new Value under it."
                                                     Margin="0,0,4,2">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="ToolTip" Value="Category"/>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Cat" Margin="2,0,0,2"
                                                       VerticalAlignment="Center" Foreground="Gray" FontSize="10"/>
                                            <TextBox Grid.Row="2" Grid.Column="0"
                                                     Text="{Binding NewValueInput, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="Value name within the Category above."
                                                     Margin="0,0,4,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Val" Margin="2,0,0,0"
                                                       VerticalAlignment="Center" Foreground="Gray" FontSize="10"/>
                                        </Grid>
                                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,5,0,0">
                                            <Button Content="+ Add" Command="{Binding AddDescriptorCommand}"
                                                    Padding="6,2" Margin="0,0,5,0"
                                                    ToolTip="Add the (Category, Value) pair to TemplateDescriptors and select it in the tree."/>
                                            <Button Content="Delete selected" Command="{Binding DeleteSelectedTreeNodeCommand}"
                                                    Padding="6,2"
                                                    ToolTip="Remove the selected Category or Value from TemplateDescriptors. Blocked when any rule still produces a descriptor under the node — move those rules first."/>
                                        </StackPanel>
                                        <TreeView ItemsSource="{Binding RuleTreeCategories}"
                                                  SelectedItemChanged="RuleTree_SelectedItemChanged"
                                                  Margin="0,0,0,0">
                                            <TreeView.ItemContainerStyle>
                                                <Style TargetType="TreeViewItem">
                                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                                </Style>
                                            </TreeView.ItemContainerStyle>
                                            <TreeView.Resources>
                                                <HierarchicalDataTemplate DataType="{x:Type local:VM_RuleTreeCategoryNode}"
                                                                          ItemsSource="{Binding Values}">
                                                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="Bold"/>
                                                </HierarchicalDataTemplate>
                                                <DataTemplate DataType="{x:Type local:VM_RuleTreeValueNode}">
                                                    <TextBlock Text="{Binding DisplayLabel}"/>
                                                </DataTemplate>
                                            </TreeView.Resources>
                                        </TreeView>
                                    </DockPanel>

                                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                                                  VerticalAlignment="Stretch" Background="#FF333333"/>

                                    <!-- Right pane: rules filtered to the current selection (top) plus a
                                         matching-presets list for the selected node (bottom). The bottom
                                         list mirrors Match Presets but scoped to the rules under the
                                         selected tree node; each row shows every measurement value
                                         referenced by those rules so the user can see at a glance which
                                         numbers cleared the thresholds. Click loads the slice in the
                                         viewer via the editor's OnRuleNodeMatchProfilePropertyChanged
                                         handler (mirrors Match Presets' SelectedMatchRow behavior). -->
                                    <Grid Grid.Column="2" Margin="6,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" MinHeight="120"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="260" MinHeight="80"/>
                                        </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0">
                                        <Button DockPanel.Dock="Top" Content="+ Add Rule" Command="{Binding AddRule}"
                                                HorizontalAlignment="Left" Padding="6,2" Margin="0,5"
                                                ToolTip="Adds a new rule pre-filled with the selected tree node's (Category, Value). Without a selection the rule starts blank."/>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding FilteredRules}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:VM_MeasurementRule}">
                                                    <Border BorderBrush="DarkGray" BorderThickness="1" Margin="0,0,0,8" Padding="6">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="160"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="160"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="100"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="Descriptor Category:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                <ComboBox Grid.Column="1"
                                                                          ItemsSource="{Binding AvailableDescriptorCategories}"
                                                                          SelectedItem="{Binding DescriptorCategory, UpdateSourceTrigger=PropertyChanged}"
                                                                          Margin="0,0,10,0"
                                                                          ToolTip="Categories listed here come from Settings_OBody.TemplateDescriptors. Add a new template descriptor in OBody Misc Settings to expand this dropdown."/>
                                                                <TextBlock Grid.Column="2" Text="Value:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                <ComboBox Grid.Column="3"
                                                                          ItemsSource="{Binding AvailableDescriptorValues}"
                                                                          SelectedItem="{Binding DescriptorValue, UpdateSourceTrigger=PropertyChanged}"
                                                                          Margin="0,0,10,0"
                                                                          ToolTip="Values listed here are filtered by the selected Category. Changing Category clears Value if the prior choice isn't defined under the new Category."/>
                                                                <TextBlock Grid.Column="4" Text="Gender:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                                <ComboBox Grid.Column="5"
                                                                          ItemsSource="{Binding AvailableGenders}"
                                                                          SelectedItem="{Binding Gender, UpdateSourceTrigger=PropertyChanged}"
                                                                          Margin="0,0,10,0"
                                                                          ToolTip="Either (default) fires the rule for both genders. Male / Female scope the rule so it only contributes a descriptor when the preset's gender matches — useful when the same descriptor has different physical signal per gender (e.g. Powerful needs to accept Chubby for males but not females, since the measurements can't distinguish fat from muscle without texture cues)."/>
                                                                <CheckBox Grid.Column="6" Content="Draft" IsChecked="{Binding IsDraft}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                          ToolTip="When checked, the evaluator skips this rule. Use the Promote button after reviewing."/>
                                                                <Button Grid.Column="7" Content="Promote" Command="{Binding PromoteFromDraft}" HorizontalAlignment="Left" Padding="6,1"/>
                                                                <Button Grid.Column="8" Content="Delete Rule" Command="{Binding DeleteCommand}" Padding="6,1"/>
                                                            </Grid>
                                                            <TextBlock Text="Predicate (OR of AND-gated condition groups):" Margin="0,5,0,3" FontStyle="Italic"/>
                                                            <ItemsControl ItemsSource="{Binding Groups}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type local:VM_AndGatedMeasurementGroup}">
                                                                        <!-- Per-branch mute: IsDisabled=true greys the border + dims its
                                                                             children + disables the inner controls so the user can see at
                                                                             a glance which branches are muted without losing their content.
                                                                             The evaluator (MeasurementMath.RuleMatches) skips disabled
                                                                             groups, and the editor's existing scan-invalidation hook fires
                                                                             on IsDisabled toggle so MatchingPresets re-derives. -->
                                                                        <Border Margin="10,2" Padding="4">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                                    <Setter Property="BorderBrush" Value="LightGray"/>
                                                                                    <Setter Property="Opacity" Value="1.0"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                                            <Setter Property="BorderBrush" Value="Gray"/>
                                                                                            <Setter Property="Background" Value="#15808080"/>
                                                                                            <Setter Property="Opacity" Value="0.55"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <StackPanel>
                                                                                <DockPanel Margin="0,0,0,3">
                                                                                    <TextBlock Text="AND group" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                                                                    <CheckBox DockPanel.Dock="Left" Content="Disable" IsChecked="{Binding IsDisabled}"
                                                                                              Margin="10,0,0,0" VerticalAlignment="Center"
                                                                                              ToolTip="Skip this OR-branch during evaluation. The branch and its conditions stay in the rule so toggling back restores the original behavior; useful for short iteration cycles without re-typing conditions."/>
                                                                                    <!-- Temp Edits: enters a preview session for this branch. The matching-presets
                                                                                         list below shows the parent rule's conform-diff (green "+ " = newly matching,
                                                                                         red "- " = no longer matching) recomputed live on every edit. Save keeps the
                                                                                         edits; Discard reverts this branch to its pre-session state. The button is
                                                                                         swapped for Save/Discard via DataTriggers on IsTempEditing. -->
                                                                                    <Button DockPanel.Dock="Left" Content="Temp Edits" Command="{Binding StartTempEdit}"
                                                                                            Padding="4,0" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                                            ToolTip="Preview how editing this branch changes which presets conform to the rule. New matches show green with '+ ', dropped matches show red with '- '.">
                                                                                        <Button.Style>
                                                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsTempEditing}" Value="True">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Button.Style>
                                                                                    </Button>
                                                                                    <Button DockPanel.Dock="Left" Content="Save" Command="{Binding SaveTempEdit}"
                                                                                            Padding="4,0" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                                            ToolTip="Keep the temp edits and end the preview session.">
                                                                                        <Button.Style>
                                                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsTempEditing}" Value="True">
                                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Button.Style>
                                                                                    </Button>
                                                                                    <Button DockPanel.Dock="Left" Content="Discard" Command="{Binding DiscardTempEdit}"
                                                                                            Padding="4,0" Margin="5,0,0,0" VerticalAlignment="Center"
                                                                                            ToolTip="Revert this branch to its state when the preview session began.">
                                                                                        <Button.Style>
                                                                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsTempEditing}" Value="True">
                                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </Button.Style>
                                                                                    </Button>
                                                                                    <Button DockPanel.Dock="Right" Content="X" Command="{Binding DeleteCommand}" Padding="4,0" HorizontalAlignment="Right"/>
                                                                                    <Button DockPanel.Dock="Right" Content="+ Condition" Command="{Binding AddCondition}" Padding="4,0" Margin="0,0,5,0" HorizontalAlignment="Right"
                                                                                            IsEnabled="{Binding IsEnabled}"/>
                                                                                    <TextBlock/>
                                                                                </DockPanel>
                                                                                <ItemsControl ItemsSource="{Binding Conditions}"
                                                                                              IsEnabled="{Binding IsEnabled}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate DataType="{x:Type local:VM_MeasurementCondition}">
                                                                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                                                                <!-- Kind picker: Measurement | DescriptorRef. Toggling swaps which controls are visible
                                                                                                     via the IsMeasurementKind / IsDescriptorRefKind visibility bindings. The inactive
                                                                                                     kind's fields stay in memory so flipping back doesn't lose the prior values. -->
                                                                                                <ComboBox ItemsSource="{Binding KindOptions}"
                                                                                                          SelectedItem="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                                                                                          MinWidth="105" Margin="0,0,5,0"
                                                                                                          ToolTip="Measurement: classic threshold test on a measurement value. DescriptorRef: aggregator — match when another rule's (Category, Value) descriptor has already fired (or hasn't, when Negate is checked)."/>

                                                                                                <!-- Measurement-kind row -->
                                                                                                <ComboBox ItemsSource="{Binding AvailableMeasurementNames}" IsEditable="True"
                                                                                                          Text="{Binding MeasurementName, UpdateSourceTrigger=PropertyChanged}"
                                                                                                          Style="{StaticResource InvalidConditionRefComboBoxStyle}"
                                                                                                          MinWidth="160" Margin="0,0,5,0"
                                                                                                          Visibility="{Binding IsMeasurementKind, Converter={StaticResource BoolToVis}}"/>
                                                                                                <ComboBox SelectedValue="{Binding Comparator, UpdateSourceTrigger=PropertyChanged}"
                                                                                                          ItemsSource="{Binding Source={local:EnumBindingSource {x:Type local:MeasurementComparator}}}"
                                                                                                          MinWidth="140" Margin="0,0,5,0"
                                                                                                          Visibility="{Binding IsMeasurementKind, Converter={StaticResource BoolToVis}}"/>
                                                                                                <TextBox Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" MinWidth="80" Margin="0,0,5,0"
                                                                                                         Visibility="{Binding IsMeasurementKind, Converter={StaticResource BoolToVis}}"/>

                                                                                                <!-- DescriptorRef-kind row -->
                                                                                                <CheckBox Content="NOT" IsChecked="{Binding Negate, UpdateSourceTrigger=PropertyChanged}"
                                                                                                          VerticalAlignment="Center" Margin="0,0,5,0"
                                                                                                          Visibility="{Binding IsDescriptorRefKind, Converter={StaticResource BoolToVis}}"
                                                                                                          ToolTip="When checked, the condition matches only if the referenced descriptor did NOT fire (exclude flavor)."/>
                                                                                                <ComboBox ItemsSource="{Binding AvailableRefCategories}"
                                                                                                          SelectedItem="{Binding RefCategory, UpdateSourceTrigger=PropertyChanged}"
                                                                                                          MinWidth="120" Margin="0,0,5,0"
                                                                                                          Visibility="{Binding IsDescriptorRefKind, Converter={StaticResource BoolToVis}}"
                                                                                                          ToolTip="Category of the descriptor this condition checks. Cycle-inducing choices are pre-filtered out."/>
                                                                                                <ComboBox ItemsSource="{Binding AvailableRefValues}"
                                                                                                          SelectedItem="{Binding RefValue, UpdateSourceTrigger=PropertyChanged}"
                                                                                                          MinWidth="140" Margin="0,0,5,0"
                                                                                                          Visibility="{Binding IsDescriptorRefKind, Converter={StaticResource BoolToVis}}"
                                                                                                          ToolTip="Value of the descriptor this condition checks. Filtered by Category and by cycle-safety."/>

                                                                                                <!-- Live readout for the currently-previewed preset: measurement value (Measurement
                                                                                                     kind) or Match/Not Match (DescriptorRef, honoring NOT). Green = the preset satisfies
                                                                                                     this condition, red = it doesn't, gray = no preset loaded / value unresolved. -->
                                                                                                <TextBlock Text="{Binding ConditionReadout}" VerticalAlignment="Center"
                                                                                                           FontWeight="Bold" MinWidth="55" Margin="4,0,8,0"
                                                                                                           ToolTip="Value of this condition for the preset currently loaded in the viewer. Green = the preset satisfies the condition; red = it doesn't.">
                                                                                                    <TextBlock.Style>
                                                                                                        <Style TargetType="TextBlock">
                                                                                                            <Setter Property="Foreground" Value="Gray"/>
                                                                                                            <Style.Triggers>
                                                                                                                <DataTrigger Binding="{Binding ConditionConforms}" Value="True">
                                                                                                                    <Setter Property="Foreground" Value="#FF2E7D32"/>
                                                                                                                </DataTrigger>
                                                                                                                <DataTrigger Binding="{Binding ConditionConforms}" Value="False">
                                                                                                                    <Setter Property="Foreground" Value="#FFC62828"/>
                                                                                                                </DataTrigger>
                                                                                                            </Style.Triggers>
                                                                                                        </Style>
                                                                                                    </TextBlock.Style>
                                                                                                </TextBlock>

                                                                                                <Button Content="X" Command="{Binding DeleteCommand}" Padding="4,0"/>
                                                                                            </StackPanel>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Content="+ OR group" Command="{Binding AddGroup}" HorizontalAlignment="Left" Padding="6,1" Margin="10,2,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>

                                    <!-- Horizontal splitter so the user can rebalance "edit rules" vs
                                         "see what they match" without giving up either view. -->
                                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" Background="#FF333333"
                                                  ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>

                                    <!-- Bottom: matching-preset list for the selected tree node. Driven
                                         entirely by the shared scan cache (see VM_BodyTypeProfile.ScanResults
                                         + MeasurementCache); cache staleness flips this to an empty state
                                         with an inline reason. Clicking a row loads the slice in the viewer
                                         (handled editor-side via PropertyChanged on SelectedNodeMatchRow). -->
                                    <DockPanel Grid.Row="2" Margin="0,4,0,0">
                                        <TextBlock DockPanel.Dock="Top" Text="Presets matching this rule node"
                                                   FontWeight="Bold" Margin="0,2,0,2"/>
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedNodeMatchingStatus}"
                                                   FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <!-- Sort selector, mirroring the Match Presets tab. "Name" (default) keeps the
                                             Gender/Preset/Weight order; any measurement sorts rows by that metric's cached
                                             value descending. Options list the metrics referenced by the displayed node's
                                             rule(s) first, then the rest. -->
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Sort:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <ComboBox Width="220" VerticalAlignment="Center"
                                                      ItemsSource="{Binding RuleNodeSortOptions}"
                                                      SelectedItem="{Binding SelectedRuleNodeSortOption}"
                                                      ToolTip="Sort the list below. 'Name' uses the default Gender/Preset/Weight order; pick a measurement to rank slices by that metric's cached value (highest first). Metrics referenced by this node's rules are listed first."/>
                                            <!-- Mirrors the Match Presets "Show Measurements" toggle: draws every
                                                 measurement referenced by the in-view rule(s) in the viewer overlay. -->
                                            <CheckBox Content="Show Measurements" IsChecked="{Binding ShowRuleNodeMeasurements}"
                                                      VerticalAlignment="Center" Margin="20,0,0,0"
                                                      ToolTip="When on, every measurement referenced by the rules for the selected node (or the rule being temp-edited) is drawn in the viewer, same overlay as the Measurements tab. Updates as you change node or edit conditions. While on, this overrides any selection in the Measurements tab; unchecking restores it."/>
                                        </StackPanel>
                                        <ListBox ItemsSource="{Binding SelectedNodeMatchingPresets}"
                                                 SelectedItem="{Binding SelectedNodeMatchRow}"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 HorizontalContentAlignment="Stretch"
                                                 ToolTip="Click a row to load that (preset, weight) slice in the viewer. Arrow keys auto-preview each row, same as the Match Presets tab.">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:VM_RuleNodeMatchRow}">
                                                    <StackPanel Margin="2">
                                                        <!-- PrefixedDisplay adds "+ "/"- " in temp-edit mode (empty otherwise).
                                                             DiffState drives the row color: green = newly conforming, red = no
                                                             longer conforming, default foreground = unchanged. -->
                                                        <TextBlock Text="{Binding PrefixedDisplay}" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding DiffState}" Value="Added">
                                                                            <Setter Property="Foreground" Value="#FF2E7D32"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding DiffState}" Value="Removed">
                                                                            <Setter Property="Foreground" Value="#FFC62828"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding MeasurementsDisplay}" FontFamily="Consolas"
                                                                   FontSize="10" Foreground="Gray" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                    </Grid>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Label-then-Suggest">
                                <!-- The enclosing ContentControl on line 105 sets the DataContext
                                     to VM_BodyTypeProfile via DataTemplate, but AnnotationEditor /
                                     AnnotationTable / SuggestMeasurements / SuggestRules live on
                                     VM_BodyTypeProfileEditor (one level up). Walk RelativeSource
                                     to the root UserControl and pull from its DataContext. -->
                                <DockPanel>
                                    <!-- Ctrl+Shift+S mirrors the Measurements / Preview / Match Presets
                                         tabs: writes the currently-evaluated measurement table for the
                                         loaded preset+weight to a CSV named
                                         {PresetLabel}_w{Weight}_Measurements.csv. Same underlying
                                         SaveMeasurementsToCsvFile on the profile VM. -->
                                    <DockPanel.InputBindings>
                                        <KeyBinding Modifiers="Control+Shift" Key="S" Command="{Binding SaveMeasurementsToCsv}"/>
                                    </DockPanel.InputBindings>
                                    <local:UC_PresetAnnotationEditor DockPanel.Dock="Top"
                                                                      DataContext="{Binding DataContext.AnnotationEditor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                      MaxHeight="260"/>
                                    <Expander DockPanel.Dock="Top" Header="Suggest Measurements" IsExpanded="False" Margin="0,2,0,0">
                                        <local:UC_SuggestMeasurementsPanel DataContext="{Binding DataContext.SuggestMeasurements, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                            MaxHeight="240"/>
                                    </Expander>
                                    <Expander DockPanel.Dock="Top" Header="Suggest Rules" IsExpanded="False" Margin="0,2,0,0">
                                        <local:UC_SuggestRulesPanel DataContext="{Binding DataContext.SuggestRules, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                     MaxHeight="240"/>
                                    </Expander>
                                    <local:UC_PresetAnnotationTable DataContext="{Binding DataContext.AnnotationTable, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"/>
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="Preview">
                                <DockPanel>
                                    <!-- Ctrl+Shift+S mirrors the Measurements-tab shortcut: writes the
                                         currently-evaluated measurement table for the loaded preset+weight
                                         to a CSV named {PresetLabel}_w{Weight}_Measurements.csv. Same
                                         underlying SaveMeasurementsToCsvFile on the profile VM. -->
                                    <DockPanel.InputBindings>
                                        <KeyBinding Modifiers="Control+Shift" Key="S" Command="{Binding SaveMeasurementsToCsv}"/>
                                    </DockPanel.InputBindings>
                                    <TextBlock DockPanel.Dock="Top" Margin="0,5,0,3" TextWrapping="Wrap"
                                               Text="Rules that match the currently-loaded preset, including drafts. Draft matches are shown in orange -- they're safely skipped by the real classifier pipeline, so calibrating thresholds here won't leak descriptors. Refreshes automatically whenever the viewer's preset or weight changes."/>
                                    <TextBlock DockPanel.Dock="Top" Text="{Binding PreviewStatus}" Margin="0,0,0,5"
                                               FontStyle="Italic" FontWeight="Bold"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding PreviewMatches}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:VM_PreviewMatch}">
                                                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="4,3" Margin="0,0,0,2">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DescriptorDisplay}" FontWeight="Bold"
                                                                       Foreground="{Binding DisplayBrush}"/>
                                                            <TextBlock Text="{Binding ConditionTrace}" FontFamily="Consolas" FontSize="10" Foreground="Gray"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </TabItem>

                            <TabItem Header="Match Presets">
                                <Grid>
                                    <!-- Match Presets tab shortcuts (scoped to this Grid so they only
                                         fire while focus is inside the tab):
                                           Ctrl+Shift+S      → per-slice CSV for the currently-selected
                                                               scan row (same format as the Measurements
                                                               tab's Ctrl+Shift+S).
                                           Ctrl+Alt+Shift+S  → long-format descriptor-matches CSV across
                                                               every scanned (preset, weight). Drives a
                                                               scan first when the cache is stale.
                                           Ctrl+C            → copy the selected row's "{Label} ({Weight})"
                                                               identifier to the clipboard.
                                         Ctrl+Shift+I (filter-mode iteration) is intercepted by the editor's
                                         global PreviewKeyDown handler so it works from any tab — see
                                         UC_BodyTypeProfileEditor.xaml.cs. -->
                                    <Grid.InputBindings>
                                        <KeyBinding Modifiers="Control+Shift"     Key="S" Command="{Binding SaveMeasurementsToCsv}"/>
                                        <KeyBinding Modifiers="Control+Alt+Shift" Key="S" Command="{Binding SaveDescriptorMatchesToCsv}"/>
                                        <KeyBinding Modifiers="Control"           Key="C"
                                                    Command="{Binding DataContext.CopySelectedMatchToClipboardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </Grid.InputBindings>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Margin="0,5,0,3" TextWrapping="Wrap"
                                               Text="Runs the classifier (including drafts) across every preset whose SliderGroup matches this profile's Body Type, at every weight in DefaultWeightSlots. Select descriptors and weights below to filter; arrow-key navigation in the results list live-previews each (preset, weight) combo."/>

                                    <ContentPresenter Grid.Row="1" Content="{Binding DataContext.DescriptorFilter, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,0,5">
                                        <ContentPresenter.Resources>
                                            <DataTemplate DataType="{x:Type local:VM_BodyShapeDescriptorSelectionMenu}">
                                                <local:UC_BodyShapeDescriptorSelectionMenu/>
                                            </DataTemplate>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,5" VerticalAlignment="Center">
                                        <TextBlock Text="Weights:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ItemsControl ItemsSource="{Binding DataContext.WeightFilterOptions, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:VM_WeightFilterOption}">
                                                    <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected}"
                                                              Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="All"
                                                Command="{Binding DataContext.SelectAllWeightsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Padding="6,1" Margin="6,0,2,0"/>
                                        <Button Content="None"
                                                Command="{Binding DataContext.SelectNoWeightsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Padding="6,1"/>
                                    </StackPanel>

                                    <!-- Top toolbar row: scan controls + progress + post-scan status/cache info.
                                         WrapPanel so the row degrades to multiple lines as the renderer's
                                         splitter narrows the right-hand pane instead of clipping the trailing
                                         items (which were previously cut off even at the default splitter
                                         position once the cache status + Purge button were added). -->
                                    <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,5">
                                        <Button Content="Scan All Presets"
                                                Command="{Binding DataContext.ScanAllPresetsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Padding="6,2" Margin="0,0,5,5"/>
                                        <CheckBox Content="Verbose Scan"
                                                  IsChecked="{Binding DataContext.VerboseScan, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  VerticalAlignment="Center" Margin="0,0,10,5"
                                                  ToolTip="Emit diagnostic lines (target count, viewer/key-vertex/fingerprint shape comparison, first-iteration measurement snapshot, first-vs-last identity check, and summary) to the Status Log when scanning. Off by default; enable when investigating why a scan returns zero matches."/>
                                        <Button Content="Cancel"
                                                Command="{Binding DataContext.CancelScanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Padding="6,2" Margin="0,0,10,5"/>
                                        <ProgressBar Width="220" Height="16" Minimum="0" Maximum="100"
                                                     Value="{Binding DataContext.ScanProgressPercent, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     VerticalAlignment="Center" Margin="0,0,10,5"/>
                                        <!-- Scan status text + results-stale indicator. Lives on the same row as
                                             the controls now so a quick glance at the toolbar shows both "what
                                             can I do?" and "what just happened?" without scanning a second line. -->
                                        <TextBlock Text="{Binding DataContext.ScanStatus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   FontStyle="Italic" VerticalAlignment="Center" Margin="0,0,10,5"/>
                                        <TextBlock Text="(results stale — re-scan recommended)" Foreground="OrangeRed"
                                                   FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,5"
                                                   Visibility="{Binding DataContext.ScanCacheStale, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                        <!-- Disk-cache status + Purge. The cache stores measurements (not descriptors)
                                             per (preset, gender, weight) under a snapshot keyed by the profile's
                                             BodyTypeName. Updated automatically after every scan; "Purge" drops
                                             the active body-type's snapshot from disk so the next scan starts
                                             fresh. Other body-type snapshots in the same profile's cache file
                                             (e.g., a dormant BHUNP snapshot from a previous experiment) are
                                             preserved unless purged separately. -->
                                        <TextBlock Text="{Binding DataContext.CacheStatusSummary, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Foreground="#80C080" FontStyle="Italic" VerticalAlignment="Center" Margin="0,0,8,5"
                                                   ToolTip="Number of (preset, gender, weight) entries persisted to disk for the active body-type snapshot. The on-disk cache lets a session start without rescanning every preset; entries are invalidated automatically when a preset's sliders change or when a measurement definition / key vertex is edited."/>
                                        <Button Content="Purge"
                                                Command="{Binding DataContext.PurgeCacheForActiveProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Padding="6,1" VerticalAlignment="Center" Margin="0,0,0,5"
                                                ToolTip="Delete the cached measurements for this profile's active body type (current BodyTypeName). Other body-type snapshots in this profile's cache file are preserved. A subsequent scan rescans from scratch."/>
                                    </WrapPanel>

                                    <!-- Bottom toolbar row: view toggles + sort selector. Also WrapPanel so the
                                         Similarity / Measurement-value sub-pickers wrap to their own line when
                                         the splitter narrows the pane. -->
                                    <WrapPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,5">
                                        <!-- "Show Measurements" pushes every measurement referenced by any rule whose
                                             descriptor is currently checked in the filter above into the viewer's
                                             measurement-line overlay (same channel the Measurements grid's
                                             multi-selection uses). Replaces the Measurements-grid selection while
                                             on; unchecking restores the fallback. Driven by both this toggle and
                                             filter-selection changes. -->
                                        <CheckBox Content="Show Measurements"
                                                  IsChecked="{Binding DataContext.ShowMatchPresetMeasurements, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  VerticalAlignment="Center" Margin="0,0,20,5"
                                                  ToolTip="When on, every measurement referenced by any rule whose descriptor is currently checked above is drawn in the viewer (yellow/cyan, same overlay the Measurements tab uses). Updates as the filter selection changes. While on, this overrides any selection in the Measurements tab; unchecking restores the Measurements-tab selection."/>
                                        <!-- Match-strength sort selector. Only meaningful when exactly one
                                             descriptor value is selected in the filter above; otherwise the
                                             list falls back to the default (Gender, Preset, Weight) order
                                             regardless of which mode is picked. The two non-Off modes differ
                                             in how they normalize the raw (value − threshold) margin —
                                             see MarginScoreMode for the formulas. -->
                                        <TextBlock Text="Sort:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,5"/>
                                        <ComboBox Width="280" VerticalAlignment="Center" Margin="0,0,10,5"
                                                  ItemsSource="{Binding DataContext.ScoreSortModeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedValuePath="Value"
                                                  DisplayMemberPath="Label"
                                                  SelectedValue="{Binding DataContext.ScoreSortMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  ToolTip="Active only when exactly one descriptor value is selected in the filter. Match-strength sorts score each row against the filter's own rule; Similarity-to sorts score against a sibling value picked from the second dropdown (e.g., filter Shape:Hourglass + similarity to Rectangle to see Hourglass-tagged presets ranked by how close they are to also matching Rectangle). σ-normalized reads as 'N standard deviations past the line'; % of threshold reads as 'N% past the threshold.' Both pick the OR-group with the most slack per row and use its tightest condition (min margin) as the row's score."/>
                                        <!-- Target picker for the Similarity sort modes. Visibility binds to the
                                             editor's IsSimilarityScoreMode flag (recomputed on ScoreSortMode change).
                                             When hidden, the bound SimilarityTarget stays put so re-entering a
                                             Similarity mode restores the prior pick instead of forcing reselection. -->
                                        <TextBlock Text="vs:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,5"
                                                   Visibility="{Binding DataContext.IsSimilarityScoreMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                        <ComboBox Width="160" VerticalAlignment="Center" Margin="0,0,10,5"
                                                  ItemsSource="{Binding DataContext.SimilarityTargetOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding DataContext.SimilarityTarget, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  Visibility="{Binding DataContext.IsSimilarityScoreMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                  ToolTip="Sibling descriptor value to measure similarity against. Populated with every value in the filter's category that has at least one rule, minus the filter's own selected value (comparing to self would just reproduce the Match-strength sort)."/>
                                        <!-- Measurement picker for the MeasurementValue sort mode. Shares the row
                                             with the Similarity "vs:" picker but bound to its own visibility flag,
                                             so the two never appear at once (their sort modes are mutually
                                             exclusive). The bound SelectedMeasurementForSort stays put when the
                                             user switches modes so re-entering MeasurementValue restores the prior
                                             pick. -->
                                        <TextBlock Text="Measurement:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,5"
                                                   Visibility="{Binding DataContext.IsMeasurementValueScoreMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                                        <ComboBox Width="220" VerticalAlignment="Center" Margin="0,0,10,5"
                                                  ItemsSource="{Binding DataContext.MeasurementValueOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding DataContext.SelectedMeasurementForSort, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  Visibility="{Binding DataContext.IsMeasurementValueScoreMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"
                                                  ToolTip="Measurement (or RatioDistance) whose cached value each row is sorted by, descending. Independent of the descriptor filter — every (preset, weight) that survives the filter is ranked as long as its cache entry contains a value for this measurement. The row's badge shows the per-row value."/>

                                        <!-- Name-substring filter. Layered ON TOP of the descriptor + weight
                                             filters + sort: shows only rows whose PresetLabel contains the
                                             typed substring (case-insensitive). Empty box = show every row
                                             that survives the other filters. UpdateSourceTrigger=PropertyChanged
                                             so the list re-filters on every keystroke; RefreshMatchingPresets
                                             is cheap (in-memory ScanResults walk, no mesh / GL work). -->
                                        <TextBlock Text="Filter:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,5"/>
                                        <TextBox Width="200" VerticalAlignment="Center" Margin="0,0,10,5"
                                                 Text="{Binding DataContext.MatchPresetNameFilter, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Case-insensitive substring filter applied to preset names in the list below, on top of the descriptor + weight + sort filters. Empty = show all surviving rows. Updates the list as you type."/>
                                    </WrapPanel>

                                    <ListBox Grid.Row="5"
                                             ItemsSource="{Binding DataContext.MatchingPresets, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             SelectedItem="{Binding DataContext.SelectedMatchRow, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             HorizontalContentAlignment="Stretch"
                                             ToolTip="Arrow keys navigate (and auto-preview) each matching (preset, weight) row.">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:VM_PresetScanRow}">
                                                <StackPanel Margin="2">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Display}" FontWeight="Bold"/>
                                                        <!-- Score badge: empty string when no sort is active so the
                                                             TextBlock collapses; visible (and colored a calm blue
                                                             so it doesn't compete with the "stale results" red)
                                                             when ScoreSortMode is non-Off and a single descriptor
                                                             is selected. ToolTip hosts the sibling-scores list
                                                             (every value in the selected Category and how strongly
                                                             this preset matches each — closest-to-matching first).
                                                             SiblingScoresTooltip is null when there's nothing to
                                                             show; WPF auto-suppresses string-typed tooltips on null,
                                                             so no extra converter is needed. -->
                                                        <TextBlock Text="{Binding ScoreDisplay}"
                                                                   Margin="8,0,0,0"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#FF1E88E5"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip="{Binding SiblingScoresTooltip}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding MatchSummary}" FontFamily="Consolas" FontSize="10" Foreground="Gray" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </TabItem>

                        </TabControl>
                    </Grid>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>
</UserControl>
