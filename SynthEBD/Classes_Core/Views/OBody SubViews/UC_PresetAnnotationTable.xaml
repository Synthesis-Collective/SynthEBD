<UserControl x:Class="SynthEBD.UC_PresetAnnotationTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SynthEBD"
             d:DataContext="{d:DesignInstance Type=local:VM_PresetAnnotationTable}"
             mc:Ignorable="d"
             d:DesignHeight="320" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <DockPanel>
        <!-- Top action bar: scan + cancel + progress + status + flyouts -->
        <Border DockPanel.Dock="Top" Background="#FF2A2A2A" Padding="6,4" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Scan All Presets" Command="{Binding ScanCommand}" Padding="10,2"
                        local:DocTooltip.Key="BodySlides.AnnotationScan"/>
                <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelScanCommand}" Padding="10,2" Margin="4,0,0,0"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                <!-- Always-visible progress bar so the user can see scan-completion state at a
                     glance: 0% before the first scan, last percent reached after a cancel,
                     100% on the last completed scan. Live-updates during IsScanning. -->
                <Grid Grid.Column="2" Width="140" Height="16" Margin="6,0,6,0">
                    <ProgressBar Value="{Binding ScanProgressPercent, Mode=OneWay}" Maximum="100"/>
                    <TextBlock Text="{Binding ScanProgressPercent, StringFormat={}{0}%}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="10" FontWeight="SemiBold"/>
                </Grid>
                <TextBlock Grid.Column="3" Text="{Binding ScanStatus}" VerticalAlignment="Center" Foreground="#FFCCCCCC"/>

                <!-- Weight slot flyout -->
                <ToggleButton Grid.Column="4" x:Name="WeightSlotsBtn" Content="Weight Slots" Padding="6,2" Margin="2,0"
                              local:DocTooltip.Key="BodySlides.AnnotationWeightSlots"/>
                <Popup Grid.Column="4" IsOpen="{Binding IsChecked, ElementName=WeightSlotsBtn, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=WeightSlotsBtn}" StaysOpen="False"
                       AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="#FF222222" BorderBrush="#FF888888" BorderThickness="1" Padding="6">
                        <DockPanel MinWidth="180">
                            <TextBlock DockPanel.Dock="Top" Text="Weight slots (0-100)" Foreground="#FFCCCCCC" Margin="0,0,0,4"/>
                            <Button x:Name="ApplyWeightSlotsBtn" DockPanel.Dock="Bottom"
                                    Content="Apply" Click="OnApplyWeightSlots" Margin="0,4,0,0" Padding="6,2"/>
                            <TextBox x:Name="WeightSlotsBox" MinWidth="160"
                                     Text="0,25,50,75,100"
                                     local:DocTooltip.Key="BodySlides.AnnotationWeightSlots"/>
                        </DockPanel>
                    </Border>
                </Popup>

                <!-- Column visibility flyout -->
                <ToggleButton Grid.Column="5" x:Name="ColumnsBtn" Content="Columns" Padding="6,2" Margin="2,0"
                              local:DocTooltip.Key="BodySlides.AnnotationColumns"/>
                <Popup Grid.Column="5" IsOpen="{Binding IsChecked, ElementName=ColumnsBtn, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=ColumnsBtn}" StaysOpen="False"
                       AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="#FF222222" BorderBrush="#FF888888" BorderThickness="1" Padding="6">
                        <DockPanel MinWidth="200">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="All" Padding="6,2" Margin="0,0,4,0" Click="OnShowAllColumns"
                                        local:DocTooltip.Key="BodySlides.AnnotationColumnsAll"/>
                                <Button Content="None" Padding="6,2" Click="OnHideAllColumns"
                                        local:DocTooltip.Key="BodySlides.AnnotationColumnsNone"/>
                            </StackPanel>
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AllColumns}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Margin="0,2"
                                                      IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                      Content="{Binding Header}"
                                                      Click="OnColumnVisibilityClicked"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <!-- Main table. Fixed columns (Preset, Gender, Weight, Annotated count, Annotation
             summary) live in XAML; per-measurement columns are appended in code-behind from
             VisibleColumns and bind via indexer path into MeasurementValues. -->
        <DataGrid x:Name="AnnotationDataGrid"
                  ItemsSource="{Binding Rows}"
                  SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  Sorting="OnDataGridSorting">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Preset" Binding="{Binding PresetLabel}" SortMemberPath="PresetLabel" Width="200"/>
                <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" SortMemberPath="Gender" Width="64"/>
                <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" SortMemberPath="Weight" Width="64"/>
                <DataGridTextColumn Header="#Annot" Binding="{Binding AnnotationCount}" SortMemberPath="AnnotationCount" Width="60"
                                    ToolTipService.ToolTip="Number of descriptors annotated for this slice."/>
                <DataGridTextColumn Header="Annotations" Binding="{Binding AnnotationSummary}" SortMemberPath="AnnotationSummary" Width="200"
                                    ToolTipService.ToolTip="Comma-separated Category:Value descriptors annotated for this slice."/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
