<UserControl x:Class="SynthEBD.UC_BodySlideAnnotator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SynthEBD"
             d:DataContext="{d:DesignInstance Type=local:VM_BodySlideAnnotator}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*" MinWidth="380"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="400" MinWidth="240"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0" Grid.Column="0" SelectedValue="{Binding DisplayedRuleSet}" ItemsSource="{Binding AnnotationRules}" IsSynchronizedWithCurrentItem="False" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                        <TextBlock Text="{Binding BodyTypeGroup}" Margin="2" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
                                    <Style.Triggers>
                                        <!-- Registry body type with no installed BodySlide presets: rules stay
                                             editable (slider names come from the registry catalog) but there is
                                             nothing to apply/test them against, so flag it in red. -->
                                        <DataTrigger Binding="{Binding HasLoadedPresets}" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource StatusErrorForeground}"/>
                                            <Setter Property="ToolTip" Value="No BodySlide presets are installed for this body type, so there are no presets to apply annotations to yet. You can still author rules here; the available slider names come from the Body Type Registry."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="1" Grid.Column="0" Content="Re-Annotate Selected" Foreground="Purple" Command="{Binding DisplayedRuleSet.ApplyAnnotationsCommand}" VerticalAlignment="Top"/>
        <Button Grid.Row="2" Grid.Column="0" Content="Re-Annotate All" Foreground="{DynamicResource ActionAccentForeground}" Command="{Binding ApplyAnnotationsCommand}" VerticalAlignment="Top"/>

        <ContentPresenter Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Content="{Binding DisplayedRuleSet}" Margin="5 0 0 0">
            <ContentPresenter.Resources>
                <DataTemplate DataType="{x:Type local:VM_SliderClassificationRulesByBodyType}">
                    <local:UC_SliderClassificationRulesByBodyType/>
                </DataTemplate>
            </ContentPresenter.Resources>
        </ContentPresenter>

        <!-- Resizable splitter between the rule editor and the preview rail. -->
        <GridSplitter Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" Width="5" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                      ShowsPreview="True"
                      local:DocTooltip.Key="OBody.AnnotatorViewerSplitter"/>

        <!-- Right rail: sortable preset list + slider readout + CharacterViewer + NPC-at-weight
             search, so rule thresholds can be sanity-checked against real presets in 3D without
             leaving the annotator. -->
        <local:UC_SliderAnnotatorPreviewPanel Grid.Row="0" Grid.Column="3" Grid.RowSpan="3"
                                              DataContext="{Binding PreviewPanel}" Margin="5 0 0 0"/>
    </Grid>
</UserControl>
