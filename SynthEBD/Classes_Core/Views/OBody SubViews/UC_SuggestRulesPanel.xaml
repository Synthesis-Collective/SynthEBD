<UserControl x:Class="SynthEBD.UC_SuggestRulesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SynthEBD"
             d:DataContext="{d:DesignInstance Type=local:VM_SuggestRulesPanel}"
             mc:Ignorable="d"
             d:DesignHeight="220" d:DesignWidth="900">
    <DockPanel>
        <!-- Action bar: algorithm picker + Suggest / Accept All / Clear + status. -->
        <Border DockPanel.Dock="Top" Background="#FF2A2A2A" Padding="6,4" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Algorithm:" Foreground="#FFCCCCCC"
                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox Grid.Column="1" MinWidth="220"
                          ItemsSource="{Binding AvailableAlgorithms}"
                          SelectedItem="{Binding SynthesisAlgorithm, Mode=TwoWay}"
                          ToolTip="OptimalThresholdPerValue: per-measurement threshold by max Youden's J. MedianSplit: legacy halfway-between-medians. DecisionStump: single best (measurement, threshold) by Gini gain."/>
                <Button Grid.Column="2" Content="Suggest Rules" Command="{Binding SuggestCommand}"
                        Padding="10,2" Margin="6,0,0,0"/>
                <Button Grid.Column="3" Content="Accept All as Drafts" Command="{Binding AcceptAllCommand}"
                        Padding="10,2" Margin="4,0,0,0"
                        ToolTip="Add every pending suggestion to the profile's Rules collection as IsDraft=true."/>
                <Button Grid.Column="4" Content="Clear" Command="{Binding ClearCommand}"
                        Padding="10,2" Margin="4,0,0,0"/>
                <TextBlock Grid.Column="5" Text="{Binding Status}" Foreground="#FFCCCCCC"
                           VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- Suggestion list. One outer item per (Category, Value); inside, one row per
             OR-combined condition, plus an Accept button on the right. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding RuleSuggestions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:VM_RuleSuggestion}">
                        <Border BorderBrush="#FF555555" BorderThickness="1" Padding="6" Margin="0,0,0,4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="1.0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAccepted}" Value="True">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Header}"/>
                                    <TextBlock Text="{Binding Stats}" Foreground="#FFAAAAAA"
                                               FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock Text="Match when ANY of:" FontStyle="Italic"
                                               Foreground="#FFAAAAAA" FontSize="11"/>
                                    <ItemsControl ItemsSource="{Binding Conditions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:VM_RuleConditionPreview}">
                                                <TextBlock Text="{Binding Display}" FontFamily="Consolas"
                                                           FontSize="11" Margin="6,1,0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Button Content="Accept" Command="{Binding AcceptCommand}"
                                            Padding="10,3" MinWidth="80"
                                            ToolTip="Add this suggestion to the profile's Rules collection as a draft.">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAccepted}" Value="True">
                                                        <Setter Property="Content" Value="Accepted"/>
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
