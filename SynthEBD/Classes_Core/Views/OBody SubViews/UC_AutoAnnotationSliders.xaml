<UserControl x:Class="SynthEBD.UC_AutoAnnotationSliders"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SynthEBD"
             d:DataContext="{d:DesignInstance Type=local:VM_AutoAnnotationSliders}"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <!-- Auto-Annotation > Sliders: the body type's presets with one picked slider's values (left) and
         the selected preset's sliders, editable, with Save / Save As (right). Selecting a preset here
         selects it in the right rail, and edits morph the rail's viewer live. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="240"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="260"/>
        </Grid.ColumnDefinitions>

        <!-- Preset table -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SecondaryBackground}" Padding="6,4" Margin="0,0,0,2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Slider:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,8,0"
                              ItemsSource="{Binding AvailableSliderNames}"
                              SelectedItem="{Binding SelectedSliderName}"
                              IsTextSearchEnabled="True" MaxDropDownHeight="400"
                              local:DocTooltip.Key="AutoAnnotationSliders.SliderPicker"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Filter:" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="3" VerticalAlignment="Center"
                             Text="{Binding PresetFilterText, UpdateSourceTrigger=PropertyChanged}"
                             local:DocTooltip.Key="AutoAnnotationSliders.PresetFilter"/>
                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,4,0,0">
                        <CheckBox Content="Show preset-only sliders" IsChecked="{Binding ShowPresetOnlySliders}" Margin="0,0,12,0"
                                  local:DocTooltip.Key="AutoAnnotationSliders.ShowPresetOnlySliders"/>
                        <CheckBox Content="Show moved vertices (heatmap)" IsChecked="{Binding ShowMovedVertices}"
                                  local:DocTooltip.Key="AutoAnnotationSliders.ShowMovedVertices"/>
                    </StackPanel>
                </Grid>
            </Border>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding FilteredPresetRows}"
                      SelectedItem="{Binding SelectedPresetRow}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                      HeadersVisibility="Column" SelectionMode="Single"
                      local:DocTooltip.Key="AutoAnnotationSliders.PresetList">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Preset" Binding="{Binding Label}" Width="*"/>
                    <DataGridTextColumn Header="Low" Binding="{Binding Low}" Width="Auto"/>
                    <DataGridTextColumn Header="High" Binding="{Binding High}" Width="Auto"/>
                    <DataGridTextColumn Header="Interp" Binding="{Binding Interpolated, StringFormat={}{0:0.##}}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" ShowsPreview="True"/>

        <!-- Selected preset: editable sliders + Save / Save As -->
        <Grid Grid.Column="2" Margin="5,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource SecondaryBackground}" Padding="6,4" Margin="0,0,0,2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" FontWeight="SemiBold" VerticalAlignment="Center"
                               local:DocTooltip.Key="AutoAnnotationSliders.Readout">
                        <Run Text="{Binding SelectedPresetLabel, Mode=OneWay}"/>
                        <Run Text="  -  " />
                        <Run Text="{Binding SourceFileDisplay, Mode=OneWay}" FontWeight="Normal" FontStyle="Italic"/>
                    </TextBlock>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="unsaved edits" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource StatusErrorForeground}"
                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Filter:" Margin="0,4,5,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,8,0" VerticalAlignment="Center"
                             Text="{Binding SliderReadoutFilterText, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Grid.Row="1" Grid.Column="2" Content="Show unset sliders" Margin="0,4,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding ShowUnsetSliders}"
                              local:DocTooltip.Key="AutoAnnotationSliders.ShowUnsetSliders"/>
                </Grid>
            </Border>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding SliderReadoutRows}"
                      SelectedItem="{Binding SelectedReadoutRow}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                      HeadersVisibility="Column" SelectionMode="Single"
                      local:DocTooltip.Key="AutoAnnotationSliders.ReadoutGrid">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Slider" Width="*" SortMemberPath="SliderName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SliderName}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsModified}" Value="True">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource ActionAccentForeground}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSet}" Value="False">
                                                    <Setter Property="FontStyle" Value="Italic"/>
                                                    <Setter Property="Opacity" Value="0.6"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Low (W0)" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding LowText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="High (W100)" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding HighText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Interp" Binding="{Binding Interpolated, StringFormat={}{0:0.##}}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Save" Command="{Binding SaveCommand}" Padding="10,1" Margin="0,0,4,0"
                        Foreground="{DynamicResource ActionGoodForeground}"
                        local:DocTooltip.Key="AutoAnnotationSliders.Save"/>
                <Button Grid.Column="1" Content="Revert" Command="{Binding RevertCommand}" Padding="10,1" Margin="0,0,12,0"
                        local:DocTooltip.Key="AutoAnnotationSliders.Revert"/>
                <TextBox Grid.Column="2" Text="{Binding SaveAsName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0" VerticalAlignment="Center"
                         local:DocTooltip.Key="AutoAnnotationSliders.SaveAsName"/>
                <Button Grid.Column="3" Content="Save As..." Command="{Binding SaveAsCommand}" Padding="10,1"
                        local:DocTooltip.Key="AutoAnnotationSliders.SaveAs"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
