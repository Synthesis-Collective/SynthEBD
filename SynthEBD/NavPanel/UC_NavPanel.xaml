<UserControl x:Class="SynthEBD.UC_NavPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             d:DataContext="{d:DesignInstance Type=local:VM_NavPanel}"
             xmlns:local="clr-namespace:SynthEBD"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" HorizontalAlignment="Center" FontSize="18">SynthEBD</TextBlock>
        <StackPanel Grid.Row="1">
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" Command="{Binding ClickDash}" Style="{DynamicResource NavToggleButtonStyle}" HorizontalContentAlignment="Center" IsChecked="True">Dashboard</RadioButton>
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" Command="{Binding ClickSG}" Style="{DynamicResource NavToggleButtonStyle}" HorizontalContentAlignment="Center">General Settings</RadioButton>
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" Command="{Binding ClickMM}" Style="{DynamicResource NavToggleButtonStyle}" HorizontalContentAlignment="Center">Mod Manager Integration</RadioButton>
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" Command="{Binding ClickTM}" Style="{DynamicResource NavToggleButtonStyle}" HorizontalContentAlignment="Center">Asset Patching</RadioButton>
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" Command="{Binding ClickCE}" Style="{DynamicResource NavToggleButtonStyle}" HorizontalContentAlignment="Center">Config Editor</RadioButton>
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" Command="{Binding ClickBG}" Style="{DynamicResource NavToggleButtonStyle}" HorizontalContentAlignment="Center" Visibility="{Binding ShowBodyGenNav, Converter={StaticResource BoolToVis}}">BodyGen Integration</RadioButton>
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" Command="{Binding ClickOB}" Style="{DynamicResource NavToggleButtonStyle}" HorizontalContentAlignment="Center" Visibility="{Binding ShowOBodyNav, Converter={StaticResource BoolToVis}}">(O/Auto)Body Integration</RadioButton>
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" Command="{Binding ClickH}" Style="{DynamicResource NavToggleButtonStyle}" HorizontalContentAlignment="Center">Height Assignment</RadioButton>
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" Command="{Binding ClickHP}" Style="{DynamicResource NavToggleButtonStyle}" HorizontalContentAlignment="Center">Head Parts</RadioButton>
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" Command="{Binding ClickDS}" Style="{DynamicResource NavToggleButtonStyle}" HorizontalContentAlignment="Center">Destandalone Patching</RadioButton>
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" Command="{Binding ClickSA}" Style="{DynamicResource NavToggleButtonStyle}" HorizontalContentAlignment="Center">Specific NPC Assignments</RadioButton>
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" Command="{Binding ClickC}" Style="{DynamicResource NavToggleButtonStyle}" HorizontalContentAlignment="Center">Consistency</RadioButton>
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" Command="{Binding ClickBL}" Style="{DynamicResource NavToggleButtonStyle}" HorizontalContentAlignment="Center">Block List</RadioButton>
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" Command="{Binding ClickLog}" Style="{DynamicResource NavToggleButtonStyle}" HorizontalContentAlignment="Center">Status Log</RadioButton>
        </StackPanel>
        <TextBlock Grid.Row="2" HorizontalAlignment="Center" Text="{Binding Version}"/>
    </Grid>
</UserControl>
