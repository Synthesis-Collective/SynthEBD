<Window x:Class="SynthEBD.Window_SubgroupLinker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SynthEBD"
        d:DataContext="{d:DesignInstance Type=local:VM_SubgroupLinker}"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="Subgroup Linker" Height="450" Width="800"
        Style="{DynamicResource ThemedWindowStyle}">
    <i:Interaction.Behaviors>
        <local:TitleBarThemingBehavior/>
    </i:Interaction.Behaviors>
    <ScrollViewer>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="ID To Match" VerticalAlignment="Center"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding IdToMatch, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Case-Sensitive" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="0" Grid.Column="3" IsChecked="{Binding IDcaseSensitive}" Margin="5 0 0 0"/>
            <TextBlock Grid.Row="0" Grid.Column="4" Text="Match Partial" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="0" Grid.Column="5" IsChecked="{Binding IDallowPartial}" Margin="5 0 0 0"/>

            <ComboBox Grid.Row="1" Grid.Column="0" SelectedValue="{Binding AndOrSelection}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type local:AndOr}}}" IsSynchronizedWithCurrentItem="True"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Name To Match" VerticalAlignment="Center"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NameToMatch, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="Case-Sensitive" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="2" Grid.Column="3" IsChecked="{Binding NameCaseSensitive}" Margin="5 0 0 0"/>
            <TextBlock Grid.Row="2" Grid.Column="4" Text="Match Partial" VerticalAlignment="Center"/>
            <CheckBox Grid.Row="2" Grid.Column="5" IsChecked="{Binding NameAllowPartial}" Margin="5 0 0 0"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Text="Subgroups to Link"/>

            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <ItemsControl ItemsSource="{Binding CollectedSubgroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:UC_SelectableSubgroupShell DataContext="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        
            <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal">
                <Button Command="{Binding LinkThisTo}" Foreground="{DynamicResource ActionAccentForeground}" local:DocTooltip.Key="SubgroupLinker.LinkToThese">Link To These</Button>
                <Button Command="{Binding LinkToThis}" Foreground="{DynamicResource ActionAccentForeground}" Margin="10 0 0 0" local:DocTooltip.Key="SubgroupLinker.LinkTheseTo">Link These To</Button>
                <Button Command="{Binding LinkReciprocally}" Foreground="{DynamicResource ActionAccentForeground}" Margin="10 0 0 0" local:DocTooltip.Key="SubgroupLinker.LinkReciprocally">Link Reciprocally</Button>
                <Button Command="{Binding LinkWholeGroup}" Foreground="{DynamicResource ActionAccentForeground}" Margin="10 0 0 0" local:DocTooltip.Key="SubgroupLinker.LinkWholeGroup">Link Whole Group</Button>
            </StackPanel>
        
            <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal">
                <Button Command="{Binding UnlinkThisFrom}" Foreground="{DynamicResource ActionDangerForeground}" local:DocTooltip.Key="SubgroupLinker.UnlinkFromThese">Unlink From These</Button>
                <Button Command="{Binding UnlinkFromThis}" Foreground="{DynamicResource ActionDangerForeground}" Margin="10 0 0 0" local:DocTooltip.Key="SubgroupLinker.UnlinkTheseFrom">Unlink These From</Button>
                <Button Command="{Binding UnlinkReciprocally}" Foreground="{DynamicResource ActionDangerForeground}" Margin="10 0 0 0" local:DocTooltip.Key="SubgroupLinker.UnlinkReciprocally">Unlink Group Reciprocally</Button>
                <Button Command="{Binding UnlinkWholeGroup}" Foreground="{DynamicResource ActionDangerForeground}" Margin="10 0 0 0" local:DocTooltip.Key="SubgroupLinker.UnlinkWholeGroup">Unlink Whole Group</Button>
            </StackPanel>

            <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal">
                <Button Command="{Binding AddAsLinkedAlternative}" Foreground="{DynamicResource ActionAccentForeground}" local:DocTooltip.Key="SubgroupLinker.SetAsAlternateRequired">Set as Alternate Required Subgroup</Button>
                <TextBlock Text="Include Chained Required Subgroups" VerticalAlignment="Center" Margin="5 0 5 0" local:DocTooltip.Key="SubgroupLinker.IncludeChainedRequired"/>
                <CheckBox IsChecked="{Binding AddAsLinkedAlternativeRecursive}"/>
                <TextBlock Text="Exclude Neighbors" VerticalAlignment="Center" Margin="5 0 5 0" local:DocTooltip.Key="SubgroupLinker.ExcludeNeighbors"/>
                <CheckBox IsChecked="{Binding AddAsLinkedAlternativeExcludeNeighbors}"/>
            </StackPanel>

            <StackPanel Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal">
                <Button Command="{Binding UnlinkAllFromThis}" Foreground="{DynamicResource ActionDangerForeground}" local:DocTooltip.Key="SubgroupLinker.UnlinkAllFromThis">Unlink All From This</Button>
                <Button Command="{Binding Close}" Foreground="{DynamicResource ActionDangerForeground}" local:DocTooltip.Key="SubgroupLinker.Close"  Margin="10 0 0 0">Close</Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
