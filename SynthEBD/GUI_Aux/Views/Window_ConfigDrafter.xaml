<Window x:Class="SynthEBD.Window_ConfigDrafter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SynthEBD"
        d:DataContext="{d:DesignInstance Type=local:VM_ConfigDrafter}"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="SynthEBD Config Drafter" Height="450" Width="800"
        Style="{DynamicResource ThemedWindowStyle}">

    <Window.Resources>
        <local:ConfigDrafterVisibilityConverterArchive x:Key="ArchiveVisibilityConverter" />
        <local:ConfigDrafterVisibilityConverterDirectory x:Key="DirectoryVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:BoolToSolidColorBrushConverter x:Key="BoolToBrushConverter_Multiplets"
                                              TrueColor="{StaticResource PrimaryForeground}"
                                              FalseColor="{StaticResource StatusPendingForeground}"/>
        <local:BoolToSolidColorBrushConverter x:Key="BoolToBrushConverter_Unmatched"
                                              TrueColor="{StaticResource StatusPendingForeground}"
                                              FalseColor="{StaticResource PrimaryForeground}"/>
    </Window.Resources>

    <i:Interaction.Behaviors>
        <local:TitleBarThemingBehavior/>
    </i:Interaction.Behaviors>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition>
                <RowDefinition.Style>
                    <Style TargetType="{x:Type RowDefinition}">
                        <Setter Property="Height" Value="*"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded, ElementName=DuplicateTexturesExpander}" Value="False">
                                <Setter Property="Height" Value="Auto"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
            <RowDefinition>
                <RowDefinition.Style>
                    <Style TargetType="{x:Type RowDefinition}">
                        <Setter Property="Height" Value="*"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded, ElementName=UnusedTexturesExpander}" Value="False">
                                <Setter Property="Height" Value="Auto"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </RowDefinition.Style>
            </RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Load textures from " Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
        <ComboBox  Width="auto" HorizontalAlignment="Left" SelectedValue="{Binding SelectedSource}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type local:DrafterTextureSource}}}" IsSynchronizedWithCurrentItem="True"  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"/>

        <TextBlock Text="Destination Mod Name" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Visibility="{ Binding SelectedSource, Converter={StaticResource ArchiveVisibilityConverter}}" ToolTip="{Binding ModNameToolTip}" ToolTipService.IsEnabled="{Binding Source={x:Static local:TooltipController.Instance}, Path=DisplayToolTips}"/>
        <TextBox Text="{Binding GeneratedModName}" Grid.Row="1" Grid.Column="2" IsReadOnly="{Binding LockGeneratedModName}" Visibility="{ Binding SelectedSource, Converter={StaticResource ArchiveVisibilityConverter}}"/>

        <TextBlock Text="Archives to install" Grid.Row="2" Grid.Column="0" Visibility="{ Binding SelectedSource, Converter={StaticResource ArchiveVisibilityConverter}}"/>
        <ScrollViewer Grid.Row="2" Grid.Column="2" Visibility="{ Binding SelectedSource, Converter={StaticResource ArchiveVisibilityConverter}}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding SelectedFileArchives}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="File Name: " Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <Button Content="Select" Foreground="{DynamicResource ActionAccentForeground}" Command="{Binding SelectArchive}" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding FilePath}" Grid.Row="0" Grid.Column="2" MinWidth="50"/>

                                    <TextBlock Text="Prefix: " Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding Prefix}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" MinWidth="50"/>

                                    <Button Content="Remove" Foreground="{DynamicResource ActionDangerForeground}" Command="{Binding DeleteMe}" Grid.Row="2" Grid.Column="1"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Add Another Archive" Foreground="{DynamicResource ActionAccentForeground}" Command="{Binding AddFileArchiveButton}" HorizontalAlignment="Left"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Text="Directories to scan" Grid.Row="2" Grid.Column="0" Margin="0 5 0 0" Visibility="{ Binding SelectedSource, Converter={StaticResource DirectoryVisibilityConverter}}"/>
        <ScrollViewer Grid.Row="2" Grid.Column="2" Visibility="{ Binding SelectedSource, Converter={StaticResource DirectoryVisibilityConverter}}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding SelectedTextureFolders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>

                                    <Button Content="Select" Foreground="{DynamicResource ActionAccentForeground}" Command="{Binding SelectPath}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding DirPath}" Grid.Row="0" Grid.Column="1" MinWidth="50"/>
                                    <Button Content="Remove" Foreground="{DynamicResource ActionDangerForeground}" Command="{Binding DeleteMe}" Grid.Row="0" Grid.Column="2"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Add Another Directory" Foreground="{DynamicResource ActionAccentForeground}" Command="{Binding AddDirectoryButton}" HorizontalAlignment="Left"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Auto-Assign: " Margin="0 10 0 0" local:DocTooltip.Key="Drafter.AutoAssign"/>
        <StackPanel Grid.Row="3"  Grid.Column="2" Orientation="Horizontal" Margin="0 10 0 0">
            <CheckBox Margin="0 0 5 0" IsChecked="{Binding AutoApplyNames}" />
            <TextBlock Text="Names" Margin="0 0 15 0" local:DocTooltip.Key="Drafter.AutoAssignNames"/>
            <CheckBox Margin="0 0 5 0" IsChecked="{Binding AutoApplyRules}"/>
            <TextBlock Text="Rules" Margin="0 0 15 0" local:DocTooltip.Key="Drafter.AutoAssignRules"/>
            <CheckBox Margin="0 0 5 0" IsChecked="{Binding AutoApplyLinkage}"/>
            <TextBlock Text="Linkage" local:DocTooltip.Key="Drafter.AutoAssignLinkage"/>
        </StackPanel>

        <Button Content="Draft Config!" Foreground="{DynamicResource ActionGoodForeground}" Command="{Binding DraftConfigButton}" HorizontalAlignment="Left" Grid.Row="4" Grid.Column="0" Visibility="{ Binding SelectedSource, Converter={StaticResource DirectoryVisibilityConverter}}" />
        <Button Content="Extract Archives" Foreground="{DynamicResource ActionGoodForeground}" Command="{Binding ExtractArchivesButton}" HorizontalAlignment="Left" Grid.Row="4" Grid.Column="0" Visibility="{ Binding SelectedSource, Converter={StaticResource ArchiveVisibilityConverter}}" />

        <Grid Grid.Row="4" Grid.Column="2" Visibility="{ Binding SelectedSource, Converter={StaticResource DirectoryVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="Check for Duplicate Textures" Foreground="{DynamicResource ActionAccentForeground}" Command="{Binding CheckDuplicatesButton}" Grid.Column="0" Visibility="{Binding NotYetDrafted, Converter={StaticResource BoolToVis}}" local:DocTooltip.Key="Drafter.CheckDuplicates"/>
            <ProgressBar Value="{Binding HashingProgressCurrent}" Maximum="{Binding HashingProgressMax}" Background="Transparent" BorderThickness="0" Grid.Column="1" />
            <TextBlock Text="{Binding CurrentlyHashingFile}" Grid.Column="1" HorizontalAlignment="Center"/>
            <Button Content="Show Printable Duplicates List" Foreground="{DynamicResource ActionAccentForeground}" Command="{Binding ShowDuplicatesPopupButton}" Grid.Column="2" Visibility="{Binding HasMultiplets, Converter={StaticResource BoolToVis}}" local:DocTooltip.Key="Drafter.ShowDuplicatesList"/>
        </Grid>

        <Separator Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"/>

        <StackPanel Grid.Row="6" Grid.Column="2" Orientation="Horizontal" Visibility="{Binding HasEtcTextures, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Textures are for" Margin="0 0 5 0" VerticalAlignment="Center" local:DocTooltip.Key="Drafter.TexturesBodyType"/>
            <ComboBox  Width="auto" HorizontalAlignment="Left" SelectedValue="{Binding SelectedBodyType}" ItemsSource="{Binding Source={local:EnumBindingSource {x:Type local:DrafterBodyType}}}" IsSynchronizedWithCurrentItem="True"/>
            <TextBlock Text="Body" Margin="5 0 0 0" VerticalAlignment="Center"/>
        </StackPanel>

        <Expander Header="Duplicate textures detected" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Visibility="{Binding HasMultiplets, Converter={StaticResource BoolToVis}}" Name="DuplicateTexturesExpander">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="SynthEBD has detected the following duplicate textures in this mod. Deleting them may simplify the layout of your config file."/>
                <TextBlock Grid.Row="1" Text="Try to preserve the files with the most generic paths to prevent creating erroneously restrictive distribution rules." Visibility="{Binding AutoApplyRules, Converter={StaticResource BoolToVis}}"/>
                <ScrollViewer Grid.Row="2">
                    <ItemsControl ItemsSource="{Binding MultipletTextureGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Margin="0 10 0 0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="{Binding FileName}" Foreground="{DynamicResource StatusPendingForeground}" />
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding FilePaths}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBox Grid.Column="0" Text="{Binding DisplayedPath}" HorizontalScrollBarVisibility="Visible" IsReadOnly="True" Foreground="{Binding IsSelected, Converter={StaticResource BoolToBrushConverter_Multiplets}}"/>
                                                        <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}" Margin="5 0 0 0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" Grid.Row="3">
                    <Button Content="Remove Duplicate Textures" Foreground="{DynamicResource ActionDangerForeground}" Command="{Binding RemoveDuplicatesButton}" HorizontalAlignment="Left" Visibility="{Binding NotYetDrafted, Converter={StaticResource BoolToVis}}" local:DocTooltip.Key="Drafter.RemoveDuplicates" />
                    <TextBlock Margin="10 0 5 0" Text="Handle duplicate textures by: " VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding MultipletHandlingOptions}" SelectedItem="{Binding MutlipletHandlingSelection}"/>
                </StackPanel>
            </Grid>
        </Expander>

        <Expander Header="SynthEBD could not determine what to do with these texture files" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Visibility="{Binding HasUnmatchedTextures, Converter={StaticResource BoolToVis}}" Name="UnusedTexturesExpander">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Any textures selected here will be imported as Uncategorized. You will need to drag and drop them to the appropriate top level subgroup." />
                <ScrollViewer  Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding UnmatchedTextures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Text="{Binding Content}" HorizontalScrollBarVisibility="Visible" IsReadOnly="True" Foreground="{Binding IsSelected, Converter={StaticResource BoolToBrushConverter_Unmatched}}"/>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}" Margin="5 0 0 0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <TextBlock Text="Select" VerticalAlignment="Center" />
                    <Button Margin="5 0 5 0" Content="All" Foreground="{DynamicResource ActionGoodForeground}" Command="{Binding SelectAllUncategorizedButton}" local:DocTooltip.Key="Drafter.UncategorizedSelectAll" />
                    <Button Content="None" Foreground="{DynamicResource ActionDangerForeground}" Command="{Binding DeselectAllUncategorizedButton}" local:DocTooltip.Key="Drafter.UncategorizedSelectNone" />
                </StackPanel>
            </Grid>
        </Expander>
    </Grid>
</Window>
