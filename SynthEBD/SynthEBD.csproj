         the on-disk Themes folder; users can drop in their own), so exclude them from BAML (Page)
         compilation. Dark.xaml is additionally embedded as ThemeManager's fallback for installs
         where the loose folder is missing (e.g. Synthesis-hosted runs). -->
    <Page Remove="Themes\*.xaml" />
    <None Remove="Themes\*.xaml" />
    <Content Include="Themes\*.xaml" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Themes\Dark.xaml" />
  </ItemGroup>

