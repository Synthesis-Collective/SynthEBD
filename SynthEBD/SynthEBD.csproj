<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- ReactiveUI.WPF 23.x (pulled transitively by Mutagen.Bethesda.WPF 0.54.0 via Noggog.WPF)
         ships its WPF assembly only for net*-windows10.0.19041; a plain net10.0-windows
         (=windows7.0) is too low and silently falls back to the .NET Framework 4.6.2 build,
         which breaks ReactiveUI/System.Reactive type resolution. Pin the Windows platform
         version so the real .NET 10 Windows assets resolve. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Mark the apphost NOT CET-compatible so Windows doesn't enable the CET hardware shadow
         stack for the process. The shadow stack fights runtime API-hooking / DLL injection, which
         is exactly what Mod Organizer 2's USVFS does — with CET on, launching under MO2 crashes
         at native init (0xc0000005 in an "unknown" module, before any managed code). Harmless for
         standalone launches; only relaxes a security hardening this tool doesn't rely on. -->
    <CETCompat>false</CETCompat>
    <UseWPF>true</UseWPF>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
    <ApplicationIcon>InternalData\Visual\SynthEBDicon.ico</ApplicationIcon>
    <ImplicitUsings>true</ImplicitUsings>
	<Nullable>enable</Nullable>
  </PropertyGroup>

