<UserControl x:Class="SynthEBD.UC_Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SynthEBD" d:DataContext="{d:DesignInstance Type=local:VM_Dashboard}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Pill-style power toggle. -->
        <Style x:Key="PowerSliderStyle" TargetType="ToggleButton">
            <Setter Property="local:DocTooltip.Key" Value="Dashboard.PowerToggle"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="38" Height="18" CornerRadius="9"
                                Background="{DynamicResource TextBoxBackground}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <Ellipse x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left"
                                     Margin="2,0,0,0" Fill="{DynamicResource SecondaryForeground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccentForeground}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The whole tile is a click target that navigates to the module's detail menu; the
             power toggle inside handles its own clicks without triggering navigation. -->
        <DataTemplate DataType="{x:Type local:VM_DashboardTile}">
            <Button Command="{Binding Open}" Margin="7" local:DocTooltip.Key="{Binding DocKey}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder" Background="{DynamicResource TileBackground}"
                                BorderBrush="{DynamicResource TileBorder}" BorderThickness="1"
                                CornerRadius="6" Padding="14,10" MinHeight="110"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource TileHoverBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <Ellipse DockPanel.Dock="Left" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource HintForeground}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Health}" Value="Ok">
                                            <Setter Property="Fill" Value="{DynamicResource StatusValidForeground}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Health}" Value="Warning">
                                            <Setter Property="Fill" Value="{DynamicResource StatusPendingForeground}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource PowerSliderStyle}" VerticalAlignment="Center"
                                      IsChecked="{Binding IsPowered, Mode=TwoWay}"
                                      Visibility="{Binding HasPowerToggle, Converter={StaticResource BoolToVis}}"/>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Margin="17,8,0,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryForeground}"/>
                        <!-- Optional colored footer line (e.g. mod-manager status on the Environment tile). -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    Visibility="{Binding HasFooter, Converter={StaticResource BoolToVis}}"
                                    local:DocTooltip.Key="{Binding FooterDocKey}">
                            <TextBlock Text="{Binding FooterLabel}" Foreground="{DynamicResource SecondaryForeground}"/>
                            <TextBlock Text="{Binding FooterText}" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <!-- Default = yellow (Warning: no mod manager set). -->
                                        <Setter Property="Foreground" Value="{DynamicResource StatusPendingForeground}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FooterHealth}" Value="Ok">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusValidForeground}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding FooterHealth}" Value="Error">
                                                <Setter Property="Foreground" Value="{DynamicResource StatusErrorForeground}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Welcome to SynthEBD" FontSize="20" FontWeight="SemiBold" Margin="7,2,0,2"/>
            <TextBlock Foreground="{DynamicResource SecondaryForeground}" Margin="7,0,0,8" TextWrapping="Wrap"
                       Text="Each tile shows one of SynthEBD's modules. Use the switches to choose what gets patched, and click a tile to open its detailed settings."/>
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
