<UserControl x:Class="SynthEBD.UC_SpecificNPCAssignmentsUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SynthEBD"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:VM_SpecificNPCAssignmentsUI}"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <local:BodyGenVisibilityConverter x:Key="BGVisibilityConverter" />
        <local:UiModeToGridRowHeightConverter x:Key="UiModeRowHeight"/>
    </UserControl.Resources>

    <!-- Progressive disclosure: forcing looks onto NPCs is a Use-level workflow;
         the BodyGen morphs.ini import is Customize and the deprecated zEBD import
         is Troubleshoot. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeRowHeight}, ConverterParameter=Troubleshoot}"/>
            <RowDefinition Height="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeRowHeight}, ConverterParameter=Customize}"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock>NPC</TextBlock>
            <local:UC_Alphabetizer DataContext="{Binding Alphabetizer}" Margin="3 0 0 0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 0 10 0">
            <CheckBox IsChecked="{Binding Show3DPreview, Mode=TwoWay}" VerticalAlignment="Center" Margin="0 0 5 0"/>
            <TextBlock Text="Show 3D Preview" VerticalAlignment="Center"/>
        </StackPanel>
        
        <Button Grid.Column="0" Grid.Row="1" Command="{Binding AddAssignment}" Foreground="{DynamicResource ActionGoodForeground}" ToolTip="Add a new forced assignment for an NPC" ToolTipService.IsEnabled="{Binding Source={x:Static local:TooltipController.Instance}, Path=DisplayToolTips}">Add New</Button>
        <ScrollViewer Grid.Column="0" Grid.Row="2">
            <ListBox SelectedValue="{Binding SelectedPlaceHolder}" ItemsSource="{Binding Assignments}" IsSynchronizedWithCurrentItem="False" >
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding DispName, UpdateSourceTrigger=PropertyChanged}" MinWidth="100" />
                            <Button Grid.Column="1" HorizontalAlignment="Right" Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.RemoveAssignment}" CommandParameter="{Binding}" Foreground="{DynamicResource ActionDangerForeground}" ToolTip="Remove this assignment" ToolTipService.IsEnabled="{Binding Source={x:Static local:TooltipController.Instance}, Path=DisplayToolTips}">X</Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>

        <ContentPresenter Grid.Row="2" Grid.Column="1" Grid.RowSpan="2" Content="{Binding CurrentlyDisplayedAssignment}">
            <ContentPresenter.Resources>
                <DataTemplate DataType="{x:Type local:VM_SpecificNPCAssignment}">
                    <local:UC_SpecificNPCAssignment/>
                </DataTemplate>
            </ContentPresenter.Resources>
        </ContentPresenter>

        <Button Grid.Row="3" Grid.Column="0" Command="{Binding ImportFromZEBDcommand}" Foreground="{DynamicResource ActionAccentForeground}" ToolTip="Import SpecificNPCAssignments.json from zEBD" ToolTipService.IsEnabled="{Binding Source={x:Static local:TooltipController.Instance}, Path=DisplayToolTips}">Import from zEBD</Button>
        <Button Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Command="{Binding ImportBodyGenMorphsIni}" Foreground="{DynamicResource ActionAccentForeground}" Visibility="{Binding SubscribedGeneralSettings.BodySelectionMode, Converter={StaticResource BGVisibilityConverter}}">Import BodyGen Morphs.ini</Button>
        <Button Grid.Row="5" Grid.Column="0" Command="{Binding Save}" Foreground="{DynamicResource ActionAccentForeground}">Save</Button>
    </Grid>
</UserControl>
