<UserControl x:Class="SynthEBD.UC_ConfigEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SynthEBD" d:DataContext="{d:DesignInstance Type=local:VM_ConfigEditor}"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!-- The inner DataContext is the shared VM_SettingsTexMesh, so the editor bindings are
         identical to when this content lived inside the Textures and Meshes menu. -->
    <Grid DataContext="{Binding TexMesh}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button Command="{Binding AddNewAssetPackConfigFile}" Foreground="{DynamicResource ActionGoodForeground}" local:DocTooltip.Key="ConfigEditor.CreateNewConfig">Create New Config File</Button>
            <Button Margin="10 0 0 0" Command="{Binding CreateConfigArchive}" Foreground="{DynamicResource ActionGoodForeground}" local:DocTooltip.Key="ConfigEditor.PackageConfigs">Package Config File(s)</Button>
            <Button Margin="10 0 0 0" Command="{Binding ValidateAll}" Foreground="{DynamicResource ActionAccentForeground}" local:DocTooltip.Key="ConfigEditor.ValidateConfigs">Validate Configs</Button>
            <Button Margin="10 0 0 0" Command="{Binding SplitScreenToggle}" local:DocTooltip.Key="ConfigEditor.SplitScreen">Split Screen Config Editor</Button>
            <Button Margin="10 0 0 0" Command="{Binding ShowBatchActionsMenu}" Foreground="{DynamicResource ActionAccentForeground}" local:DocTooltip.Key="ConfigEditor.BatchActions">Batch Actions</Button>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 5 0 5">
            <TextBlock VerticalAlignment="Center" local:DocTooltip.Key="ConfigEditor.SubgroupPreview">Subgroup preview</TextBlock>
            <ComboBox Margin="5 0 0 0" ItemsSource="{Binding PreviewModeOptions}" SelectedItem="{Binding PreviewMode, Mode=TwoWay}" MinWidth="80" />
            <TextBlock Text="Preview Image Maximum Size" VerticalAlignment="Center" Margin="5 0 5 0" Visibility="{Binding Path = bShowPreviewImages, Converter={StaticResource BoolToVis}}" local:DocTooltip.Key="ConfigEditor.MaxPreviewImageSize"/>
            <TextBox MinWidth="50" TextAlignment="Left" local:NumericInputBehavior.IsEnabled="True" Text="{Binding Path=MaxPreviewImageSize}" Visibility="{Binding Path = bShowPreviewImages, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="*" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding bShowSecondaryAssetPack}" Value="False">
                                    <Setter Property="Width" Value="0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding bShowSecondaryAssetPack}" Value="True">
                                    <Setter Property="Width" Value="*" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <local:UC_AssetPresenter Grid.Row="0" Grid.Column="0" Background="{DynamicResource SecondaryBackground}" BorderBrush="#5844b4" BorderThickness="1" DataContext="{Binding AssetPresenterPrimary}" />
            <local:UC_AssetPresenter Grid.Row="0" Grid.Column="1" Background="{DynamicResource SecondaryBackground}" BorderBrush="MediumAquamarine" BorderThickness="1" DataContext="{Binding AssetPresenterSecondary}" Margin="5 0 0 0" Visibility="{Binding Path = ParentUI.bShowSecondaryAssetPack, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</UserControl>
