<UserControl x:Class="SynthEBD.UC_SettingsTexMesh"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SynthEBD" d:DataContext="{d:DesignInstance Type=local:VM_SettingsTexMesh}"
             mc:Ignorable="d" 
             d:DesignHeight="838.781" d:DesignWidth="1447.356">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InvertableBooleanToVisibilityConverter x:Key="IBoolToVis"/>
        <local:BoolToGridRowHeightConverter x:Key="GridHeightToggler"/>
        <local:UiModeToGridRowHeightConverter x:Key="UiModeRowHeight"/>
        <local:UiModeToVisibilityConverter x:Key="UiModeVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding bShowTroubleshootingSettings, Converter={StaticResource GridHeightToggler}}" x:Name="row0"/>
                <!-- 0 -->
                <RowDefinition Height="{Binding bShowTroubleshootingSettings, Converter={StaticResource GridHeightToggler}}"/>
                <!-- 1 -->
                <RowDefinition Height="{Binding bShowTroubleshootingSettings, Converter={StaticResource GridHeightToggler}}"/>
                <!-- 2 -->
                <RowDefinition Height="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeRowHeight}, ConverterParameter=Customize}"/>
                <!-- 3 -->
                <RowDefinition Height="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeRowHeight}, ConverterParameter=Customize}"/>
                <!-- 4 (SkyPatcher Mode: kept at Use level - commonly requested toggle) -->
                <RowDefinition Height="auto"/>
                <!-- 5 -->
                <RowDefinition Height="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeRowHeight}, ConverterParameter=Customize}" x:Name="row5"/>
                <!-- 6 -->
                <RowDefinition Height="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeRowHeight}, ConverterParameter=Customize}"/>
                <!-- 7 -->
                <RowDefinition Height="{Binding bShowTroubleshootingSettings, Converter={StaticResource GridHeightToggler}}"/>
                <!-- 8 (was 9; Force-vanilla row moved to the Destandalone page) -->
                <RowDefinition Height="{Binding bShowEBDOptions, Converter={StaticResource GridHeightToggler}}"/>
                <!-- 9 -->
                <RowDefinition Height="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeRowHeight}, ConverterParameter=Customize}" x:Name="row10"/>
                <!-- 10 (was 11) -->
                <RowDefinition Height="{Binding bShowTroubleshootingSettings, Converter={StaticResource GridHeightToggler}}"/>
                <!-- 11 (was 13; Subgroup-preview row moved to the Config Editor page) -->
                <RowDefinition Height="{Binding bShowTroubleshootingSettings, Converter={StaticResource GridHeightToggler}}"/>
                <!-- 12 -->
                <RowDefinition Height="{Binding bShowTroubleshootingSettings, Converter={StaticResource GridHeightToggler}}"/>
                <!-- 13 -->
                <RowDefinition Height="{Binding bShowTroubleshootingSettings, Converter={StaticResource GridHeightToggler}}" x:Name="row15"/>
                <!-- 14 -->
                <RowDefinition Height="auto"/>
                <!-- 15 -->
                <RowDefinition Height="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeRowHeight}, ConverterParameter=Customize}"/>
                <!-- 16 -->
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"  VerticalAlignment="Center" local:DocTooltip.Key="AssetPatching.ChangeNPCTextures">Allow config files to change NPC textures</TextBlock>
            <CheckBox Grid.Row="0" Grid.Column="1"  IsChecked="{Binding Path=bChangeNPCTextures, Mode=TwoWay}"></CheckBox>

            <TextBlock Grid.Row="1" Grid.Column="0"  VerticalAlignment="Center" local:DocTooltip.Key="AssetPatching.ChangeNPCMeshes">Allow config files to change NPC meshes</TextBlock>
            <CheckBox Grid.Row="1" Grid.Column="1"  IsChecked="{Binding Path=bChangeNPCMeshes, Mode=TwoWay}"></CheckBox>

            <TextBlock Grid.Row="2" Grid.Column="0"  VerticalAlignment="Center" local:DocTooltip.Key="AssetPatching.ChangeNPCHeadParts">Allow config files to change NPC head parts</TextBlock>
            <CheckBox Grid.Row="2" Grid.Column="1"  IsChecked="{Binding Path=bChangeNPCHeadParts, Mode=TwoWay}"></CheckBox>

            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" local:DocTooltip.Key="AssetPatching.FacePatchingMode">Face Patching Mode</TextBlock>
            <ComboBox Grid.Row="3" Grid.Column="1" SelectedItem="{Binding FacePatchingMode}" ItemsSource="{Binding FacePatchingModeOptions}" />

            <TextBlock Grid.Row="4" Grid.Column="0"  VerticalAlignment="Center" local:DocTooltip.Key="AssetPatching.SkyPatcherMode">SkyPatcher Mode</TextBlock>
            <CheckBox Grid.Row="4" Grid.Column="1"  IsChecked="{Binding Path=bSkyPatcherModeAssets, Mode=TwoWay}"></CheckBox>

            <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" local:DocTooltip.Key="AssetPatching.PatchNPCsWithCustomBodies">Patch NPCs with custom bodies</TextBlock>
            <CheckBox Grid.Row="5" Grid.Column="1"  IsChecked="{Binding Path=bApplyToNPCsWithCustomSkins, Mode=TwoWay}"></CheckBox>

            <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" local:DocTooltip.Key="AssetPatching.PatchNPCsWithCustomFaces">Patch NPCs with custom faces</TextBlock>
            <CheckBox Grid.Row="6" Grid.Column="1"  IsChecked="{Binding Path=bApplyToNPCsWithCustomFaces, Mode=TwoWay}"></CheckBox>

            <TextBlock Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" local:DocTooltip.Key="AssetPatching.EnableAssetReplacers">Enable Asset Replacers</TextBlock>
            <CheckBox Grid.Row="7" Grid.Column="1"  IsChecked="{Binding Path=bEnableAssetReplacers, Mode=TwoWay}"></CheckBox>

            <TextBlock Grid.Row="8" Grid.Column="0"  VerticalAlignment="Center" Text="Replace Skins" local:DocTooltip.Key="AssetPatching.ReplaceSkins"/>
            <WrapPanel Orientation="Horizontal" Grid.Row="8" Grid.Column="1">
                <Expander>
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel>
                            <ScrollViewer MaxHeight="500">
                                <ListBox ItemsSource="{Binding StrippedSkinWNAMs}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="2 0 2 0">
                                                <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Button Content="x" Foreground="{DynamicResource ActionDangerForeground}" Command="{Binding DeleteCommand}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                            <Button Content="Add New" Foreground="{DynamicResource ActionGoodForeground}" Command="{Binding AddStrippedWNAM}"/>
                        </StackPanel>
                        <StackPanel Margin="10 0 0 0">
                            <Button VerticalAlignment="Top" Content="Add all armors from mod: " Foreground="{DynamicResource ActionAccentForeground}" Command="{Binding ImportStrippedWNAMsFromMod}" local:DocTooltip.Key="AssetPatching.ImportSkinsFromMod"/>
                            <local:UC_ModKeyPicker ModKey="{Binding SelectedStrippedWNAMmodKey}" SearchableMods="{Binding LoadOrder}" />
                            <Button VerticalAlignment="Top" Content="Undo" Foreground="{DynamicResource ActionDangerForeground}" Command="{Binding UndoImportStrippedWNAMsFromMod}"/>
                        </StackPanel>
                    </WrapPanel>
                </Expander>
                <TextBlock VerticalAlignment="Center" Margin="5 0 0 0" local:DocTooltip.Key="AssetPatching.EasyNPCCompatibilityMode">EasyNPC Compatibility Mode</TextBlock>
                <CheckBox IsChecked="{Binding Path=bEasyNPCCompatibilityMode, Mode=TwoWay}"></CheckBox>
            </WrapPanel>

            <TextBlock Grid.Row="9" Grid.Column="0"  VerticalAlignment="Center" Text="EBD Options"/>
            <WrapPanel Orientation="Horizontal" Grid.Row="9" Grid.Column="1">
                <TextBlock Margin="0 0 5 0" VerticalAlignment="Center" local:DocTooltip.Key="AssetPatching.FixEBDGlobalScript">Fix EBD Global Script</TextBlock>
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding Path=bApplyFixedScripts, Mode=TwoWay}"/>

                <TextBlock Text="Use Fixed EBD Global Script For: " Margin="5 0 5 0" VerticalAlignment="Center" Visibility="{Binding Path = bShowSKSEversionOptions, Converter={StaticResource BoolToVis}}" local:DocTooltip.Key="AssetPatching.FixedScriptSKSEVersion"/>
                <ComboBox SelectedItem="{Binding SKSEversionSSE}" ItemsSource="{Binding SKSEversionOptions}" Visibility="{Binding Path = bShowSKSEversionOptions, Converter={StaticResource BoolToVis}}" />

                <TextBlock Text="Use PO3 Extender and Tweaks for Fixed EBD Global Script: " Margin="5 0 5 0" VerticalAlignment="Center" Visibility="{Binding Path = bShowPO3Options, Converter={StaticResource BoolToVis}}" local:DocTooltip.Key="AssetPatching.FixedScriptPO3Mode"/>
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding Path=bPO3ModeForVR, Mode=TwoWay}" Visibility="{Binding Path = bShowPO3Options, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Margin="5 0 5 0" VerticalAlignment="Center" local:DocTooltip.Key="AssetPatching.UseOriginalEBDScript">Use Original EBD Face Texture Script</TextBlock>
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding Path=bLegacyEBDMode, Mode=TwoWay}"/>
                <Expander Margin="5 0 0 0" Header="Refresh Triggers" ExpandDirection="Down" Visibility="{Binding bLegacyEBDMode, Converter={StaticResource IBoolToVis}, ConverterParameter=Inverted}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <ItemsControl Grid.Row="0" ItemsSource="{Binding TriggerEvents, UpdateSourceTrigger=PropertyChanged}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:VM_CollectionMemberString}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Text="{Binding Content}" MinWidth="100"></TextBox>
                                        <Button Command="{Binding DeleteCommand}" Foreground="{DynamicResource ActionDangerForeground}">X</Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Grid.Row="1" Width="75" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Command="{Binding AddTriggerEvent}" Foreground="{DynamicResource ActionGoodForeground}">Add New</Button>
                    </Grid>
                </Expander>
                <TextBlock Margin="5 0 5 0" VerticalAlignment="Center" local:DocTooltip.Key="AssetPatching.FaceScriptVerbose" Visibility="{Binding bLegacyEBDMode, Converter={StaticResource IBoolToVis}, ConverterParameter=Inverted}">Verbose</TextBlock>
                <CheckBox VerticalAlignment="Center" IsChecked="{Binding Path=bNewEBDModeVerbose, Mode=TwoWay}" Visibility="{Binding bLegacyEBDMode, Converter={StaticResource IBoolToVis}, ConverterParameter=Inverted}"/>
            </WrapPanel>

            <TextBlock Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" local:DocTooltip.Key="AssetPatching.AssignmentLog">Generate combination assignment log</TextBlock>
            <CheckBox Grid.Row="10"  Grid.Column="1" IsChecked="{Binding Path=bGenerateAssignmentLog, Mode=TwoWay}"></CheckBox>

            <TextBlock Grid.Row="11"  Grid.Column="0" VerticalAlignment="Center" local:DocTooltip.Key="AssetPatching.CacheRecords">Cache generated records</TextBlock>
            <CheckBox Grid.Row="11"  Grid.Column="1" IsChecked="{Binding Path=bCacheRecords, Mode=TwoWay}"></CheckBox>

            <TextBlock Grid.Row="12" Grid.Column="0"  VerticalAlignment="Center" local:DocTooltip.Key="AssetPatching.MatchSkinAltTextures">Match NPC Skin Alternate Textures</TextBlock>
            <CheckBox Grid.Row="12" Grid.Column="1"  IsChecked="{Binding Path=bPatchSkinAltTextures, Mode=TwoWay}"></CheckBox>

            <TextBlock Grid.Row="13" Grid.Column="0"  VerticalAlignment="Center" local:DocTooltip.Key="AssetPatching.MatchArmorTextures">Match NPC Armor Textures</TextBlock>
            <CheckBox Grid.Row="13" Grid.Column="1"  IsChecked="{Binding Path=bPatchArmors, Mode=TwoWay}"></CheckBox>

            <TextBlock Grid.Row="14" Grid.Column="0" VerticalAlignment="Center" local:DocTooltip.Key="AssetPatching.PathTrimming">Asset Path Trimming</TextBlock>
            <StackPanel Grid.Row="14" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding RestoreDefaultTrimPaths}" Foreground="{DynamicResource ActionAccentForeground}" Margin="5 0 5 0" local:DocTooltip.Key="AssetPatching.RestoreDefaultTrimPaths">Restore Defaults</Button>
            </StackPanel>
            <Expander Grid.Row="14" Grid.Column="1" >
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding TrimPaths, UpdateSourceTrigger=Default}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center">Remove "</TextBlock>
                                    <TextBox Text="{Binding PathToTrim, UpdateSourceTrigger=PropertyChanged}" MinWidth="60" HorizontalContentAlignment="Left"/>
                                    <TextBlock VerticalAlignment="Center">\" from ".</TextBlock>
                                    <TextBox Text="{Binding Extension, UpdateSourceTrigger=PropertyChanged}" MinWidth="35" HorizontalContentAlignment="Left"/>
                                    <TextBlock VerticalAlignment="Center">" file paths</TextBlock>
                                    <Button VerticalAlignment="Center" Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Path=DataContext.RemoveTrimPath}" CommandParameter="{Binding}" Foreground="{DynamicResource ActionDangerForeground}" Margin="5 0 0 0">X</Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Command="{Binding AddTrimPath}" Foreground="{DynamicResource ActionGoodForeground}">Add New</Button>
                </StackPanel>
            </Expander>

            <TextBlock Grid.Row="15"  Grid.Column="0" VerticalAlignment="Center" Text="Active Config Files"/>
            <StackPanel Grid.Row="15"  Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" >
                <TextBlock VerticalAlignment="Center" Text="Select"/>
                <Button Command="{Binding SelectConfigsAll}" Foreground="{DynamicResource ActionGoodForeground}" Margin="5 0 5 0" local:DocTooltip.Key="AssetPatching.SelectConfigsAll">All</Button>
                <Button Command="{Binding SelectConfigsNone}" Foreground="{DynamicResource ActionDangerForeground}" Margin="5 0 5 0" local:DocTooltip.Key="AssetPatching.SelectConfigsNone">None</Button>
            </StackPanel>
            <Expander Grid.Row="15"  Grid.Column="1" Header="{Binding DisplayedAssetPackStr}">
                <ItemsControl ItemsSource="{Binding AssetPacks, UpdateSourceTrigger=PropertyChanged}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:VM_AssetPack}">
                            <DockPanel>
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="2"/>
                                <TextBlock Text="{Binding GroupName}" Margin="2"/>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <TextBlock Grid.Row="16" Grid.Column="0" VerticalAlignment="Center" local:DocTooltip.Key="AssetPatching.DistributionOrder">Distribution Order</TextBlock>
            <Expander Grid.Row="16" Grid.Column="1" >
                <local:UC_AssetOrderingMenu DataContext="{Binding AssetOrderingMenu}"/>
            </Expander>
        </Grid>

        <!-- The config-editor toolbar and editor pane moved to the Config Editor page
             (UC_ConfigEditor); Destandalone patching moved to its own page (UC_SettingsDestandalone). -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal">
            <Button Command="{Binding InstallFromArchive}" Foreground="{DynamicResource ActionGoodForeground}" Margin="5" local:DocTooltip.Key="AssetPatching.InstallConfigArchive">Install Config from Archive</Button>
            <Button Command="{Binding InstallFromJson}" Foreground="YellowGreen" Margin="5" local:DocTooltip.Key="AssetPatching.InstallConfigJson">Install Config Json File</Button>
            <Button Command="{Binding ValidateAll}" Foreground="{DynamicResource ActionAccentForeground}" Margin="5" local:DocTooltip.Key="AssetPatching.ValidateConfigs">Validate Configs</Button>
            <Button Command="{Binding SimulateDistribution}" Foreground="{DynamicResource ActionAccentForeground}" Margin="5" Visibility="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeVis}, ConverterParameter=Customize}" local:DocTooltip.Key="AssetPatching.SimulateDistribution">Simulate Distribution</Button>
        </WrapPanel>
    </Grid>
</UserControl>
