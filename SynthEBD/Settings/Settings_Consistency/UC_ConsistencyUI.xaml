<UserControl x:Class="SynthEBD.UC_ConsistencyUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SynthEBD"
             d:DataContext="{d:DesignInstance Type=local:VM_ConsistencyUI}"
             xmlns:plugins="clr-namespace:Mutagen.Bethesda.WPF.Plugins;assembly=Mutagen.Bethesda.WPF"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:UiModeToVisibilityConverter x:Key="UiModeVis"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- Progressive disclosure: the full reset and per-NPC clear stay at Use level;
             the finer per-axis clears are Customize. -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal">
            <Button VerticalAlignment="Center" Margin="0 0 10 0" HorizontalAlignment="Right" Command="{Binding DeleteAllAssets}" Foreground="{DynamicResource ActionDangerForeground}" Visibility="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeVis}, ConverterParameter=Customize}" local:DocTooltip.Key="Consistency.ClearAssetAssignments">Clear Asset Assignments</Button>
            <Button VerticalAlignment="Center" Margin="0 0 10 0" HorizontalAlignment="Right" Command="{Binding DeleteAllBodyShape}" Foreground="{DynamicResource ActionDangerForeground}" Visibility="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeVis}, ConverterParameter=Customize}" local:DocTooltip.Key="Consistency.ClearBodyShapeAssignments">Clear Body Shape Assignments</Button>
            <Button VerticalAlignment="Center" Margin="0 0 10 0" HorizontalAlignment="Right" Command="{Binding DeleteAllHeight}" Foreground="{DynamicResource ActionDangerForeground}" Visibility="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeVis}, ConverterParameter=Customize}" local:DocTooltip.Key="Consistency.ClearHeightAssignments">Clear Height Assignments</Button>
            <Button VerticalAlignment="Center" Margin="0 0 10 0" HorizontalAlignment="Right" Command="{Binding DeleteAllHeadParts}" Foreground="{DynamicResource ActionDangerForeground}" Visibility="{Binding Source={x:Static local:UiModeController.Instance}, Path=DisplayMode, Converter={StaticResource UiModeVis}, ConverterParameter=Customize}" local:DocTooltip.Key="Consistency.ClearHeadPartAssignments">Clear HeadPart Assignments</Button>
            <Button VerticalAlignment="Center" Margin="0 0 0 0" HorizontalAlignment="Right" Command="{Binding DeleteAllNPCs}" Foreground="{DynamicResource ActionDangerForeground}" local:DocTooltip.Key="Consistency.ClearAll">Clear Consistency</Button>
            <CheckBox IsChecked="{Binding Show3DPreview, Mode=TwoWay}" VerticalAlignment="Center" Margin="20 0 5 0"/>
            <TextBlock Text="Show 3D Preview" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0 10 0 0" local:DocTooltip.Key="Consistency.SearchNpc">Search NPC</TextBlock>
        <local:UC_NamedFormKeyPicker Grid.Row="1"  Grid.Column="1" VerticalAlignment="Top" Margin="0 10 0 0"  FormKey="{Binding SelectedNPCFormKey}" LinkCache="{Binding lk}" ScopedTypes="{Binding AllowedFormKeyTypes, Mode=OneWay}" MaxHeight="250"  />

        <ContentPresenter Grid.Row="2" Grid.Column="2" Content="{Binding CurrentlyDisplayedAssignment}">
            <ContentPresenter.Resources>
                <DataTemplate DataType="{x:Type local:VM_ConsistencyAssignment}">
                    <local:UC_ConsistencyAssignment BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                </DataTemplate>
            </ContentPresenter.Resources>
        </ContentPresenter>

        <Button Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right" Command="{Binding DeleteCurrentNPC}" Foreground="{DynamicResource ActionDangerForeground}" local:DocTooltip.Key="Consistency.ClearCurrentNpc">Clear Current NPC</Button>

    </Grid>
</UserControl>
