<UserControl x:Class="SynthEBD.UC_SettingsOBody"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             d:DataContext="{d:DesignInstance Type=local:VM_SettingsOBody}"
             xmlns:local="clr-namespace:SynthEBD"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0">
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Style="{StaticResource {x:Type ToggleButton}}" HorizontalContentAlignment="Center" Command="{Binding ClickBodySlidesMenu}" local:DocTooltip.Key="OBody.BodySlidesMenu" IsChecked="True">BodySlides</RadioButton>
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Style="{StaticResource {x:Type ToggleButton}}" HorizontalContentAlignment="Center" Command="{Binding ClickDescriptorsMenu}" local:DocTooltip.Key="OBody.DescriptorsMenu">Body Descriptors</RadioButton>
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Style="{StaticResource {x:Type ToggleButton}}" HorizontalContentAlignment="Center" Command="{Binding ClickAttributeGroupsMenu}" local:DocTooltip.Key="OBody.AttributeGroupsMenu">Attribute Groups</RadioButton>
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Style="{StaticResource {x:Type ToggleButton}}" HorizontalContentAlignment="Center" Command="{Binding ClickMiscMenu}" local:DocTooltip.Key="OBody.MiscSettingsMenu">Misc Settings</RadioButton>
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Style="{StaticResource {x:Type ToggleButton}}" HorizontalContentAlignment="Center" Command="{Binding ClickAnnotationMenu}" local:DocTooltip.Key="OBody.AnnotatorMenu">Annotator</RadioButton>
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Style="{StaticResource {x:Type ToggleButton}}" HorizontalContentAlignment="Center" Command="{Binding ClickAnnotationTrainerMenu}" local:DocTooltip.Key="OBody.AnnotatorTrainingMenu">Annotator Training</RadioButton>
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Style="{StaticResource {x:Type ToggleButton}}" HorizontalContentAlignment="Center" Command="{Binding ClickBodyTypeRegistryMenu}" local:DocTooltip.Key="OBody.BodyTypeRegistryMenu">Body Type Registry</RadioButton>
            <RadioButton GroupName="Nav" Margin="0, 5, 0, 0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Style="{StaticResource {x:Type ToggleButton}}" HorizontalContentAlignment="Center" Command="{Binding ClickBodyTypeProfilesMenu}" local:DocTooltip.Key="OBody.BodyTypeProfilesMenu">Body Type Profiles</RadioButton>
        </StackPanel>

        <ContentPresenter Content="{Binding DisplayedUI}" Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="10, 0, 0, 0" >
            <ContentPresenter.Resources>
                <DataTemplate DataType="{x:Type local:VM_BodySlidesMenu}">
                    <local:UC_BodySlideMenu/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type local:VM_BodyShapeDescriptorCreationMenu}">
                    <local:UC_BodyShapeDescriptorCreationMenu local:DocTooltip.Key="OBody.DescriptorsMenu"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type local:VM_AttributeGroupMenu}">
                    <local:UC_AttributeGroupMenu local:DocTooltip.Key="OBody.AttributeGroupsMenu"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type local:VM_OBodyMiscSettings}">
                    <local:UC_OBodyMiscSettings/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type local:VM_BodySlideAnnotator}">
                    <local:UC_BodySlideAnnotator/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type local:VM_OBodyTrainer}">
                    <local:UC_OBodyTrainer/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type local:VM_BodyTypeRegistry}">
                    <local:UC_BodyTypeRegistry/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type local:VM_BodyTypeProfileEditor}">
                    <local:UC_BodyTypeProfileEditor/>
                </DataTemplate>
            </ContentPresenter.Resources>
        </ContentPresenter>
    </Grid>
</UserControl>
