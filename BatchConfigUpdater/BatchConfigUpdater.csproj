<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Retargeted with the rest of the repo. References SynthEBD (net10.0-windows10.0.19041),
         so it must target the same floor. Not in SynthEBD.sln / CI; auxiliary dev tool. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML" Version="3.0.0" />
    <!-- Bumped 0.44.0 -> 0.54.0 to unify with SynthEBD's Mutagen graph (this code uses no Mutagen
         API directly; the meta package covers what SynthEBD's AssetPack model needs transitively). -->
    <PackageReference Include="Mutagen.Bethesda" Version="0.54.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SynthEBD\SynthEBD.csproj" />
  </ItemGroup>

</Project>
