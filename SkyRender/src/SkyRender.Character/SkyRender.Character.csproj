<Project Sdk="Microsoft.NET.Sdk">

  <!-- Character tier: NPC assembly (mesh paths, overrides, slot occupancy, FaceGen heads), the
       NPC offscreen scene builder and the interactive WPF viewer, built on SkyRender. -->
  <PropertyGroup>
    <!-- ReactiveUI.WPF 23.x ships its WPF asset only for net*-windows10.0.19041 (a plain
         net8.0-windows = windows7.0 silently falls back to the .NET Framework build). Pin the
         platform version so the real Windows asset resolves. A net10 host consumes this net8 lib fine. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>SkyRender.Character</RootNamespace>
    <AssemblyName>SkyRender.Character</AssemblyName>
    <PackageId>SkyRender.Character</PackageId>
    <Product>SkyRender.Character</Product>
    <Description>Character assembly and an interactive WPF viewer built on SkyRender: NPC mesh resolution inputs, texture and mesh overrides, FaceGen heads, offscreen NPC portraits.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SkyRender\SkyRender.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 5.0.0 -> 5.1.2 to stay coherent with common WPF host dependencies. -->
    <PackageReference Include="Extended.Wpf.Toolkit" Version="5.1.2" />
    <PackageReference Include="OpenTK.GLWpfControl" Version="4.3.3" />
    <!-- One ReactiveUI major with the WPF hosts (a shared assembly can't straddle a ReactiveUI
         major-version gap). Keep ReactiveUI.Fody at 19.5.41: that [Reactive]-weaver combo is what
         the hosts use. The two weavers run at build time only (the woven assembly references
         neither of their libraries), so they are private: a consumer of the package does not get
         them as dependencies, and they do not weave the consumer's own code. -->
    <PackageReference Include="ReactiveUI.WPF" Version="23.2.28" />
    <PackageReference Include="ReactiveUI.Fody" Version="19.5.41" PrivateAssets="all" />
    <PackageReference Include="PropertyChanged.Fody" Version="4.1.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- The core namespaces are used throughout the character tier. -->
  <ItemGroup>
    <Using Include="SkyRender" />
    <Using Include="SkyRender.Offscreen" />
    <Using Include="SkyRender.Character.Offscreen" />
  </ItemGroup>

</Project>
